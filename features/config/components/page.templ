// SCOPE:feature - REMOVE by deleting features/config/.
//
// templ is the read-only /config page. Renders the PageData built
// by BuildPageData: nothing secret-shaped is ever raw; the
// template just iterates the rows and toggles between Display
// (pass-through) and the masked label for Sensitive/URL-shaped rows.
//
// The page renders a BODY inside internal/ui.Shell: the shell owns the
// document, the assets, the sidebar and the module header. Config-specific
// <style> travels through the shell's head slot, so the shell stays free of
// feature CSS.
package components

import (
	"strings"

	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/internal/ui"
)

// Page renders the /config module inside the shared shell.
//
// The shell's context slot carries the two facts this page is about: the
// session role and whether RBAC is actually enforcing. Before the shell existed
// they were the second of four banner paragraphs at the top of a table page.
templ Page(data PageData, userEmail string, userRole string, buildLabel string, buildCommit string) {
	@ui.Shell(ui.Data{
		Title:       "Config — gogogo",
		Module:      "config",
		Heading:     "Config",
		Context:     configContext(data),
		Email:       userEmail,
		Role:        userRole,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
		OfflineSync: true,
	}, configHead(), configSound(), configActions(data), configBody(data))
}

// configHead carries the page's own <head> extras: the sound assets (so the
// sidebar's sound toggle works) and the tight table/mask styling that only
// this page uses.
templ configHead() {
	@sounds.SoundAssets()
	<style>
		.config-group {
			margin-bottom: 1.5rem;
		}
		.config-mask {
			font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
			color: oklch(0.45 0.06 250);
			background: oklch(0.92 0.02 250 / 0.6);
			padding: 0.1rem 0.4rem;
			border-radius: 0.25rem;
			font-size: 0.85em;
		}
		.config-env {
			font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
			color: var(--color-base-content);
			font-size: 0.75rem;
		}
		.config-not-set {
			color: var(--color-base-content);
			font-style: italic;
		}
		.config-banner {
			border-left: 4px solid oklch(0.7 0.18 50);
			background: oklch(0.96 0.04 80);
			/* Keep the banner text dark in both themes: the callout keeps
			   its light background even in dark mode, so a fixed near-black
			   color guarantees readable contrast instead of inheriting the
			   light base-content used on dark pages. */
			color: oklch(0.2 0.02 250);
			padding: 0.75rem 1rem;
			border-radius: 0.25rem;
			margin-bottom: 1.25rem;
		}
	</style>
}

// soundToggle is the shell's mute control for this page. It is a
// one-line templ wrapper on purpose: the installer's sounds trim drops the
// @sounds.SoundSwitch() line, leaving an empty wrapper that still satisfies
// the shell's slot (the import goes with it). Passing the call directly
// would put it on the same line as the Shell invocation, and dropping that
// line would break the call.
templ configSound() {
	@sounds.SoundSwitch()
}

// configActions is the header's right-aligned build badge.
templ configActions(data PageData) {
	if data.BuildLabel != "" {
		<span class="badge badge-primary badge-sm font-mono">{ data.BuildLabel }</span>
	}
}

// configBody is the page's work area: the runtime status card, the grouped
// field table, and the rotate-a-secret footer. The old page opened with two
// banner paragraphs restating the page and the RBAC posture; both facts now
// live where they are read (header context + status card), and only the
// actionable warning — enforcement OFF — stays as an alert.
templ configBody(data PageData) {
	<div class="ui-page ui-stack">
	if data.Notice != "" {
		<div role="status" class="alert alert-success"><span>{ data.Notice }</span></div>
	}
	if data.Error != "" {
		<div role="alert" class="alert alert-error"><span>{ data.Error }</span></div>
	}
	// Status card: grouped rows, one per thing an operator checks first. The
	// old strip printed eight identical badges in a wrap, so posture (RBAC,
	// environment) and capability (keys, engines) could not be told apart at a
	// glance — a tag cloud, not a status.
	<section class="ui-card" aria-label="Runtime status">
		<div class="ui-card-body">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<h2 class="ui-title">Runtime status</h2>
				if n := StatusAttention(data.Status); n > 0 {
					<span class={ "badge badge-sm badge-soft " + StatusBadgeClass(toneWarning) }>{ AttentionLabel(n) }</span>
				} else {
					<span class={ "badge badge-sm badge-soft " + StatusBadgeClass(toneSuccess) }>nothing to fix</span>
				}
			</div>
			<div class="mt-4 grid gap-x-10 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
				for _, group := range data.StatusGroups {
					<section aria-label={ group.Name }>
						<h3 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-1">{ group.Name }</h3>
						for _, item := range group.Items {
							<div class="flex items-center justify-between gap-3 border-b border-base-300 py-1.5 last:border-0">
								<span class="text-sm text-base-content/70" title={ item.Hint }>{ item.Label }</span>
								<span class="flex items-center gap-1.5">
									<span class={ "status status-sm " + StatusDotClass(item.Tone) } aria-hidden="true"></span>
									<span class="text-sm font-medium">{ item.State }</span>
								</span>
							</div>
						}
					</section>
				}
			</div>
		</div>
	</section>
	if !data.RBACEnabled {
		<div role="alert" class="alert alert-warning">
			<span>
				<strong>RBAC enforcement is off.</strong>
				Every route passes the policy; this page stays admin-only through its own handler fence.
				Set <code class="text-sm">RBAC_ENABLED=true</code> to enforce the policy.
			</span>
		</div>
	}

	// Radio tabs (DaisyUI tabs + tab-content, no JS): the checked radio IS
	// the active mark, and only its panel shows. data-init maps a deep link
	// (#users after a role change, #security-events after a filter) onto the
	// matching tab — there is no Datastar primitive that reads
	// location.hash on load without script, so the mapping lives here,
	// adjacent to the markup it drives.
	<div
		class="tabs tabs-box"
		data-init="var tabs = {'#runtime': 'config-tab-runtime', '#users': 'config-tab-users', '#security-events': 'config-tab-security', '#answer-components': 'config-tab-components'}; var id = tabs[window.location.hash]; if (id) { var el = document.getElementById(id); if (el) { el.checked = true; } }"
	>
		<input type="radio" name="config_tabs" id="config-tab-runtime" class="tab" aria-label="Runtime" checked/>
		<div class="tab-content pt-4" role="tabpanel" aria-label="Runtime settings">

	<section id="runtime" aria-label="Runtime settings">
	for _, group := range data.Groups {
		<section class="ui-card" aria-label={ group.Name }>
			<div class="ui-card-body">
				<h2 class="ui-title">{ group.Name }</h2>
				if group.Note != "" {
					<p class="text-sm text-base-content/70 mb-2">{ group.Note }</p>
				}
				<div class="overflow-x-auto">
					<table class="table table-sm">
						<caption class="sr-only">{ group.Name } settings</caption>
						<thead>
							<tr>
								<th class="w-1/3">Field</th>
								<th>Env</th>
								<th>Value</th>
								<th class="hidden md:table-cell">Description</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range group.Rows {
								<tr>
									<td><code class="text-sm">{ row.Key }</code></td>
									<td><span class="config-env">{ row.Env }</span></td>
									<td>
										if row.BoolOnly {
											if row.Set {
												<span class="badge badge-success badge-sm">set</span>
											} else {
												<span class="config-not-set">not set</span>
											}
										} else if !row.Set {
											<span class="config-not-set">not set</span>
										} else if row.Masked {
											<span class="config-mask" title="Masked value">{ row.Display }</span>
										} else {
											<code class="text-sm">{ row.Display }</code>
										}
									</td>
									<td class="hidden md:table-cell text-sm text-base-content/70">{ row.Description }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</section>
	}

		</section>
		</div>
		<input type="radio" name="config_tabs" id="config-tab-users" class="tab" aria-label="Users"/>
		<div class="tab-content pt-4" role="tabpanel" aria-label="Users">
	<section class="ui-card" id="users">
		<div class="ui-card-body">
			<h2 class="ui-title">Users</h2>
			<p class="text-sm text-base-content/70 mb-2">
				Admin-only. Role changes apply on the next request; revoking sessions signs the user out everywhere.
			</p>
			if data.AdminStepUp {
				<p class="text-xs text-base-content/60 mb-3">
					Each mutation asks for your password; a passwordless admin proves it with a current authenticator/recovery code.
				</p>
			} else {
				<div role="alert" class="alert alert-warning mb-3">
					<span>This admin account has no password or verified authenticator, so admin mutations are disabled. Enroll TOTP or set a password first.</span>
				</div>
			}
			<div class="overflow-x-auto">
				<table class="table table-sm">
					<caption class="sr-only">Admin users</caption>
					<thead>
						<tr>
							<th>Email</th>
							<th>Role</th>
							<th>Verified</th>
							<th>2FA</th>
							<th>Created</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, user := range data.Users {
							<tr>
								<td><code class="text-sm">{ user.Email }</code></td>
								<td>
									<form method="POST" action="/config/users/role" class="flex flex-wrap items-center gap-1">
										<input type="hidden" name="email" value={ user.Email }/>
										<select name="role" class="select select-sm">
											<option value="user" selected?={ user.Role == "user" }>user</option>
											<option value="viewer" selected?={ user.Role == "viewer" }>viewer</option>
											<option value="admin" selected?={ user.Role == "admin" }>admin</option>
										</select>
										<input type="password" name="proof" class="input input-xs w-36" required
											placeholder={ adminProofLabel(data) } autocomplete="current-password"/>
										<button type="submit" class="btn btn-xs" disabled?={ !data.AdminStepUp }
											data-on:click="confirm('Change this user role?') || evt.preventDefault()">Save</button>
									</form>
								</td>
								<td>
									if user.Verified {
										<span class="badge badge-success badge-sm">yes</span>
									} else {
										<span class="badge badge-warning badge-sm">no</span>
									}
								</td>
								<td>
									if user.TOTP {
										<span class="badge badge-success badge-sm">on</span>
									} else {
										<span class="badge badge-ghost badge-sm">off</span>
									}
								</td>
								<td class="text-xs text-base-content/60">{ user.Created }</td>
								<td>
									<form method="POST" action="/config/users/revoke" class="flex flex-wrap items-center gap-1">
										<input type="hidden" name="email" value={ user.Email }/>
										<input type="password" name="proof" class="input input-xs w-36" required
											placeholder={ adminProofLabel(data) } autocomplete="current-password"/>
										<button type="submit" class="btn btn-xs btn-error" disabled?={ !data.AdminStepUp }
											data-on:click="confirm('Revoke every session for this user?') || evt.preventDefault()">Revoke sessions</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>
		</div>
		<input type="radio" name="config_tabs" id="config-tab-security" class="tab" aria-label="Security events"/>
		<div class="tab-content pt-4" role="tabpanel" aria-label="Security events">
	<section class="ui-card" id="security-events">
		<div class="ui-card-body">
			<h2 class="ui-title">Security events</h2>
			if data.AuditAlert != "" {
				<div role="alert" class="alert alert-warning mb-3"><span>{ data.AuditAlert }</span></div>
			}
			<form method="GET" action="/config#security-events" class="flex flex-wrap items-end gap-2 mb-3">
				<label>
					<div class="label py-1"><span class="text-xs">Event</span></div>
					<select name="event" class="select select-sm">
						<option value="">All events</option>
						for _, name := range data.EventNames {
							<option value={ name } selected?={ data.EventFilter == name }>{ name }</option>
						}
					</select>
				</label>
				<button type="submit" class="btn btn-sm">Filter</button>
				if data.EventFilter != "" {
					<a href="/config#security-events" class="btn btn-ghost btn-sm">Clear</a>
				}
			</form>
			<p class="text-sm text-base-content/70 mb-2">Last 24 hours, grouped by outcome.</p>
			if len(data.EventCounts) == 0 {
				<p class="text-sm">No security events recorded.</p>
			} else {
				<div class="overflow-x-auto">
					<table class="table table-sm">
						<caption class="sr-only">Security events in the last 24 hours</caption>
						<thead><tr><th>Event</th><th>Reason</th><th>Count</th></tr></thead>
						<tbody>
							for _, count := range data.EventCounts {
								<tr><td>{ count.Event }</td><td>{ count.Reason }</td><td>{ count.Count }</td></tr>
							}
						</tbody>
					</table>
				</div>
			}
			<div class="flex flex-wrap items-center justify-between gap-2 mb-2 mt-4">
				<p class="text-sm text-base-content/70">Recent events (100).</p>
				<a href={ data.CSVURL } class="btn btn-xs" download>Download CSV</a>
			</div>
			if len(data.Events) == 0 {
				<p class="text-sm">
					if data.EventFilter != "" {
						No events match this filter.
					} else {
						No recent events.
					}
				</p>
			} else {
				<div class="overflow-x-auto">
					<table class="table table-sm">
						<caption class="sr-only">Recent security events</caption>
						<thead><tr><th>When</th><th>Event</th><th>Reason</th><th>Subject</th><th>Actor</th></tr></thead>
						<tbody>
							for _, event := range data.Events {
								<tr>
									<td class="text-xs text-base-content/60">{ event.Created }</td>
									<td>{ event.Event }</td>
									<td>{ event.Reason }</td>
									<td class="text-xs"><code>{ event.Email }</code> <span class="text-base-content/60">{ event.UserID }</span></td>
									<td class="text-xs text-base-content/60">{ event.ActorID }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<div class="flex flex-wrap items-center gap-2 mt-3">
				if data.PrevURL != "" {
					<a href={ data.PrevURL } class="btn btn-xs">Newer</a>
				}
				if data.NextURL != "" {
					<a href={ data.NextURL } class="btn btn-xs">Older</a>
				}
			</div>
		</div>
	</section>
		</div>
	<!-- trim-genui:components-section:start -->
		<input type="radio" name="config_tabs" id="config-tab-components" class="tab" aria-label="Components"/>
		<div class="tab-content pt-4" role="tabpanel" aria-label="Answer components">
	<section class="ui-card" id="answer-components">
		<div class="ui-card-body">
			<h2 class="ui-title">Answer components</h2>
			<p class="text-sm text-base-content/70 mb-2">
				What the chat model may emit. The generative catalog is fixed; native panels
				render your own data (the model picks the slice, the app fills the rows).
			</p>
			<h3 class="font-semibold mt-3 mb-1">Generative catalog</h3>
			<div class="overflow-x-auto">
				<table class="table table-sm">
					<caption class="sr-only">Generative answer components</caption>
					<thead>
						<tr>
							<th>Component</th>
							<th>Band</th>
							<th>What the model fills</th>
						</tr>
					</thead>
					<tbody>
						for _, info := range data.AnswerCatalog {
							<tr>
								<td><code class="text-sm">{ info.Name }</code></td>
								<td><span class="badge badge-neutral badge-sm">{ string(info.Kind) }</span></td>
								<td class="text-sm text-base-content/70">{ info.Blurb }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<h3 class="font-semibold mt-3 mb-1">Native panels</h3>
			if len(data.AnswerPanels) == 0 {
				<p class="text-sm">No native panels installed — answers about your own data have no component to render through.</p>
			} else {
				<div class="overflow-x-auto">
					<table class="table table-sm">
						<caption class="sr-only">Native answer panels</caption>
						<thead>
							<tr>
								<th>Panel</th>
								<th>When the model picks it</th>
								<th>Slice props</th>
							</tr>
						</thead>
						<tbody>
							for _, info := range data.AnswerPanels {
								<tr>
									<td><code class="text-sm">{ info.Name }</code></td>
									<td class="text-sm text-base-content/70">{ info.Blurb }</td>
									<td><code class="text-sm">{ strings.Join(info.Writable, ", ") }</code></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</section>

		</div>
	<!-- trim-genui:components-section:end -->
	</div>
	<footer class="text-xs text-base-content/60 mt-6">
		<p>Need to rotate a secret? Edit <code>~/.secrets/{ data.AppName }.env.age</code> (L2 in <code>cali-ops-server-security</code>) and restart the binary.</p>
	</footer>
	</div>
}

// adminProofLabel names the accepted proof without pretending a password
// exists on an OAuth-only row.
func adminProofLabel(data PageData) string {
	if data.AdminPasswordSet {
		return "Password"
	}
	return "Authenticator/recovery code"
}

// configContext is the header's context slot: the two facts the page exists to
// make legible, in the same terse shape every module uses for liveness.
func configContext(data PageData) string {
	role := data.Role
	if role == "" {
		role = "role unknown"
	}
	if data.RBACEnabled {
		return role + " · RBAC enforced"
	}
	return role + " · RBAC off"
}
