// SCOPE:feature — Chat's machinery, shown only in demo mode.
//
// The page itself is a thread and a composer. What it demonstrates is the path
// an answer takes, which is what this panel shows: a queued job, a model call,
// and a stream back into the thread. The states are driven by the page's own
// signals ($chat_thinking, $chat_empty), so the panel cannot claim a state the
// page is not in.
//
// State contract (all three steps share it, so the dots cannot disagree):
//   - empty thread ($chat_empty): all pending — nothing happened yet.
//   - thinking ($chat_thinking): accepted done, model active, streamed pending.
//   - settled (!$chat_thinking && !$chat_empty): all done.
//
// The Message stat reads $chat_messages (seeded from the server-rendered
// history, stepped by LiveThread): a number baked at page load said 0 while an
// answer was already in the thread.
package components

import (
	"strconv"

	"github.com/calionauta/gogogo/internal/ui"
)

// ChatStatePanel renders the answer pipeline and the facts behind it.
templ ChatStatePanel(msgs int) {
	<div class="app-state-panel-inner">
		<div class="card bg-base-100 shadow-sm border border-base-200">
			<div class="card-body p-4">
				<div class="flex items-center justify-between mb-2">
					<div class="flex items-center gap-2">
						<div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 5v8a2 2 0 01-2 2h-5l-5 4v-4H4a2 2 0 01-2-2V5a2 2 0 012-2h12a2 2 0 012 2zM7 8H5v2h2V8zm2 0h2v2H9V8zm6 0h-2v2h2V8z" clip-rule="evenodd"/>
							</svg>
						</div>
						<span class="text-xs font-semibold">Answer pipeline</span>
					</div>
					<div class="flex gap-1">
						<span class="badge badge-xs badge-secondary">goqite</span>
						<span class="badge badge-xs badge-ghost">SSE</span>
					</div>
				</div>
				<div class="text-xs text-base-content/60 mb-3">
					An answer is a job, not a request: queued off-request, worked by the
					model, streamed back into this tab. Reload-safe — the thread is the store.
				</div>
				@ui.StepList([]ui.Step{
					{Label: "Question accepted", Done: "!$chat_empty"},
					{Label: "Model working (queued job)", Done: "!$chat_thinking && !$chat_empty", Active: "$chat_thinking"},
					{Label: "Streamed into this tab", Done: "!$chat_thinking && !$chat_empty"},
				})
				<div class="stats stats-horizontal shadow-sm border border-base-200 w-full mt-1">
					<div class="stat px-3 py-2">
						<div class="stat-title text-xs">Messages</div>
						<div class="stat-value text-sm font-mono" data-text="$chat_messages">{ strconv.Itoa(msgs) }</div>
					</div>
					<div class="stat px-3 py-2">
						<div class="stat-title text-xs">Transport</div>
						<div class="stat-value text-sm font-mono">SSE</div>
					</div>
					<div class="stat px-3 py-2">
						<div class="stat-title text-xs">Queue</div>
						<div class="stat-value text-sm font-mono">goqite</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
