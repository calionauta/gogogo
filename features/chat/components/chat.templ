// SCOPE:feature — chat conversation templates.
package components

import (
	"github.com/calionauta/gogogo/features/authviews"
	"github.com/calionauta/gogogo/features/chat/store"
	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/internal/components"
)

// ChatIndex renders the conversation page: composer form, live message
// list fed by the worker, result stream. History is server-rendered from
// the store (msgs), so a reload shows the same conversation the live
// patches built. Sounds ride the shared assets (global press cue + toast
// observer) — zero custom sound JS by design.
templ ChatIndex(email string, userRole string, buildLabel string, buildCommit string, msgs []store.MessageView) {
	<!DOCTYPE html>
	<html lang="en" { authviews.ThemeRootAttrs(MarshalSignals(Signals{Theme: "light", ChatEmpty: len(msgs) == 0}))... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Chat — gogogo</title>
			<link rel="stylesheet" href="/static/app.min.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			@authviews.ThemeHead()
			<script defer type="module" src="/static/theme.js"></script>
			@sounds.SoundAssets()
			<script defer type="module" src="/static/datastar.js"></script>
			@components.OfflineSyncScript(true)
		</head>
		<body>
			@authviews.Navbar(email, userRole, "chat", buildLabel, buildCommit)
			@components.OfflineBanner(true)
			@components.SessionBanner(email != "")
			<main class="container mx-auto p-4 max-w-2xl">
				<h1 class="text-2xl font-bold">Chat</h1>
				<p class="text-sm text-base-content/60 mt-1 mb-1">
					Ask anything. Each answer is built for the request: the model
					composes its own markup, sanitized, instead of picking from a
					fixed palette.
				</p>
				@components.TechStack([]components.TechItem{
					{Name: "custom components", Note: "the model invents the markup for your question — Ask AI never gets this"},
					{Name: "component catalog", Note: "cards, tables, charts for what markup does worse"},
					{Name: "SSE Hub", Note: "answers stream to this tab live"},
					{Name: "goqite queue", Note: "model round-trips run off-request"},
					{Name: "owned sessions", Note: "history is per account"},
				})
				<div class="mb-4"></div>
				<form
					id="chat-composer"
					data-on:submit__prevent={ "$chat_thinking = true; $chat_error = ''; $chat_empty = false; @post('/api/chat/ask?clientID=' + encodeURIComponent(window.__gogogoClientID || ''), {contentType: 'form'})" }
					data-on:datastar-fetch="evt.detail.type === 'error' || evt.detail.type === 'retries-failed' ? ($chat_thinking = false, $chat_error = 'Request failed — check your connection and try again.') : null"
					data-cuelume="send"
				>
					<label for="chat-prompt" class="form-control w-full">
						<span class="label-text mb-1">Message</span>
						<input
							id="chat-prompt"
							name="prompt"
							data-bind="chatPrompt"
							type="text"
							required
							minlength="1"
							maxlength="2000"
							autocomplete="off"
							placeholder="Plan my day"
							class="input input-bordered w-full"
						/>
					</label>
					<div class="mt-3 flex items-center gap-3">
						<button type="submit" class="btn btn-primary" data-attr:disabled="$chat_thinking">
							<span data-show="!$chat_thinking">Send</span>
							<span data-show="$chat_thinking" class="loading loading-spinner loading-sm" aria-hidden="true"></span>
							<span data-show="$chat_thinking">Thinking…</span>
						</button>
					</div>
				</form>
				<div class="mt-6">
					@ChatList(msgs, "")
				</div>
			</main>
			@components.ToastContainer()
			<button
				id="chat-stream-opener"
				class="hidden"
				data-on:click={ "@get('/api/chat/stream?clientID=' + encodeURIComponent(window.__gogogoClientID || '') + '', { permanent: true })" }
				data-on:datastar-ready__document="window.__gogogoOpenVerified && window.__gogogoOpenVerified('chat-stream-opener')"
				aria-hidden="true"
			></button>
			<script defer type="module" src="/static/sse-open.js"></script>
			<script type="module">
				// TRUE VANILLA EXCEPTION (see TestNoNewVanillaJS): same proven
				// bootstrap as the todo RealtimeStream — Datastar v1 never fires
				// data-on:load on body, so the datastar-ready click + timeout
				// fallback below is the only opener that works.
				(function () {
					try {
						var id = sessionStorage.getItem('gogogo_client_id');
						if (!id) {
							id = 'tab-' + Math.random().toString(36).slice(2, 10);
							sessionStorage.setItem('gogogo_client_id', id);
						}
						window.__gogogoClientID = id;
					} catch (e) {
						window.__gogogoClientID = 'tab-' + Math.random().toString(36).slice(2, 10);
					}
					function openSSE() {
						if (typeof window.__gogogoOpenVerified === 'function') {
							window.__gogogoOpenVerified('chat-stream-opener');
							return;
						}
						openSSE.misses = (openSSE.misses || 0) + 1;
						if (openSSE.misses > 40) {
							throw new Error('sse: helper sse-open.js never loaded');
						}
						setTimeout(openSSE, 300);
					}
					// Declarative open above; fallback covers already-fired ready.
					setTimeout(openSSE, 300);
				})();
			</script>
		</body>
	</html>
}

// ChatList renders the message column: the container the stream patches
// plus the thread itself. The container owns the `#chat-messages` id and
// nothing else does — see ChatThread for why that matters.
templ ChatList(msgs []store.MessageView, errMsg string) {
	<div id="chat-messages" class="flex flex-col gap-3" aria-live="polite">
		<div id="chat-empty" data-show="$chat_empty" class="rounded-lg border border-dashed border-base-300 p-6 text-center">
			<p class="font-semibold">Ask anything — answers stream below</p>
			<p class="text-sm text-base-content/60 mt-1">History persists per account; each answer is markup the model invented for that question.</p>
		</div>
		@ChatThread(msgs, errMsg)
	</div>
}

// ChatThread renders the bubbles: user right-aligned, assistant
// left-aligned, component directives inside the assistant bubble, and an
// error as its own bubble. Deliberately NO container id and NO empty
// state: this is the fragment the SSE hub appends into #chat-messages,
// and a server-side patch targets EVERY match of its selector, so a
// nested `#chat-messages` made each later answer append twice over.
templ ChatThread(msgs []store.MessageView, errMsg string) {
	if errMsg != "" {
		<div class="chat chat-start">
			<div class="chat-bubble chat-bubble-error" role="alert">{ errMsg }</div>
		</div>
	}
	for _, m := range msgs {
		if m.Role == "user" {
			<div class="chat chat-end">
				<div class="chat-bubble chat-bubble-primary">{ m.Text }</div>
			</div>
		} else {
			<div class="chat chat-start">
				<div class="chat-bubble">
					if m.Text != "" {
						<p class="text-sm">{ m.Text }</p>
					}
					for _, comp := range m.Components {
						<div class="mt-2">@comp</div>
					}
				</div>
			</div>
		}
	}
}
