// SCOPE:feature — chat conversation templates.
package components

import (
	"strconv"

	"github.com/calionauta/gogogo/features/chat/store"
	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/internal/components"
	"github.com/calionauta/gogogo/internal/ui"
)

// ChatIndex renders the conversation page: composer, live message list fed by
// the stream, result patches. History is server-rendered from the store (msgs),
// so a reload shows the same conversation the live patches built.
//
// The document, assets, sidebar, header and toast root belong to
// internal/ui.Shell; this file is the page: its signals, thread, composer and
// stream opener. The demo paragraph and the stack pills that used to sit above
// the composer are gone from the page — the layers live in the sidebar's stack
// key, and the header's context slot carries live state instead of prose.
templ ChatIndex(email string, userRole string, buildLabel string, buildCommit string, msgs []store.MessageView, skinName string, demo bool) {
	@ui.Shell(ui.Data{
		Title:       "Chat — gogogo",
		Module:      "chat",
		Context:     chatContext(msgs),
		Email:       email,
		Role:        userRole,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
		Skin:        skinName,
		OfflineSync: true,
		Signals:     MarshalSignals(Signals{Theme: "light", ChatEmpty: len(msgs) == 0}),
		Demo:        demo,
		Panel:       ChatStatePanel(len(msgs)),
		Stack:       chatStack(),
	}, chatHead(), chatSound(), nil, chatBody(msgs))
}

// chatHead is this page's own <head> extras. It is a one-line wrapper on
// purpose: the installer's sounds trim drops that line by substring, and the
// wrapper keeps the shell's head slot satisfied when the feature is trimmed.
templ chatHead() {
	@sounds.SoundAssets()
}

// chatSound is the shell's mute control for this page. Same reason as chatHead:
// the trim drops the call and leaves an empty wrapper.
templ chatSound() {
	@sounds.SoundToggle()
}

// chatContext is the header's context slot: thread size and transport, the two
// facts this page is about.
func chatContext(msgs []store.MessageView) string {
	if len(msgs) == 0 {
		return "no messages yet · answers stream over SSE"
	}
	return strconv.Itoa(len(msgs)) + " messages · answers stream over SSE"
}

// chatStack is what this page demonstrates, in the sidebar's stack key.
func chatStack() []components.TechItem {
	return []components.TechItem{
		{Name: "custom components", Note: "the model invents markup for your question, sanitized server-side"},
		{Name: "your own data", Note: "a component can render your real todos from the app's store"},
		{Name: "component catalog", Note: "cards, tables, charts for what markup does worse"},
		{Name: "SSE Hub", Note: "answers stream to this tab live"},
		{Name: "goqite queue", Note: "model round-trips run off-request"},
		{Name: "owned sessions", Note: "history is per account"},
	}
}

// chatBody is the work area: the composer, the thread and the opener.
templ chatBody(msgs []store.MessageView) {
	<div class="mx-auto max-w-2xl">
				<form
					id="chat-composer"
					data-on:submit__prevent={ "$chat_thinking = true; $chat_error = ''; $chat_empty = false; var sent = $chatPrompt; @post('/api/chat/ask?clientID=' + encodeURIComponent(window.__gogogoClientID || ''), {contentType: 'form'}).then(() => { if ($chatPrompt === sent) $chatPrompt = ''; }).catch(() => { $chat_thinking = false; })" }
					data-on:datastar-fetch="evt.detail.type === 'error' || evt.detail.type === 'retries-failed' ? ($chat_thinking = false, $chat_error = 'Request failed — check your connection and try again.') : null"
					data-cuelume="send"
				>
					<label for="chat-prompt" class="form-control w-full">
						<span class="label-text mb-1">Message</span>
						<input
							id="chat-prompt"
							name="prompt"
							data-bind="chatPrompt"
							type="text"
							required
							minlength="1"
							maxlength="2000"
							autocomplete="off"
							placeholder="Plan my day"
							class="input input-bordered w-full"
						/>
					</label>
					<div class="mt-3 flex items-center gap-3">
						<button type="submit" class="btn btn-primary" data-attr:disabled="!!$chat_thinking">
							<span data-show="!$chat_thinking">Send</span>
							<span data-show="$chat_thinking" class="loading loading-spinner loading-sm" aria-hidden="true"></span>
							<span data-show="$chat_thinking">Thinking…</span>
						</button>
					</div>
				</form>
		<div class="mt-6">
			@ChatList(msgs, "")
		</div>
		@components.StreamOpener("chat-stream-opener", "/api/chat/stream", false)
	</div>
}

// ChatList renders the message column: the container the stream patches
// plus the thread itself. The container owns the `#chat-messages` id and
// nothing else does — see ChatThread for why that matters.
templ ChatList(msgs []store.MessageView, errMsg string) {
	<div id="chat-messages" class="flex flex-col gap-3" aria-live="polite">
		<div id="chat-empty" data-show="$chat_empty" class="rounded-lg border border-dashed border-base-300 p-6 text-center">
			<p class="font-semibold">Ask anything — answers stream below</p>
			<p class="text-sm text-base-content/60 mt-1">History persists per account; each answer is markup the model invented for that question.</p>
		</div>
		@ChatThread(msgs, errMsg)
	</div>
}

// ChatThread renders the bubbles: user right-aligned, assistant
// left-aligned, component directives inside the assistant bubble, and an
// error as its own bubble. Deliberately NO container id and NO empty
// state: this is the fragment the SSE hub appends into #chat-messages,
// and a server-side patch targets EVERY match of its selector, so a
// nested `#chat-messages` made each later answer append twice over.
//
// It ends with the scroll anchor (components.AutoScroll): the fragment IS
// the newest message, so the node that arrives with it is the node that
// brings it into view — on the answer patch and on the prompt echo alike.
templ ChatThread(msgs []store.MessageView, errMsg string) {
	if errMsg != "" {
		<div class="chat chat-start">
			<div class="chat-bubble chat-bubble-error" role="alert">{ errMsg }</div>
		</div>
	}
	for _, m := range msgs {
		if m.Role == "user" {
			<div class="chat chat-end">
				<div class="chat-bubble chat-bubble-primary">{ m.Text }</div>
			</div>
		} else {
			<div class="chat chat-start">
				<div class="chat-bubble">
					if m.Text != "" {
						<p class="text-sm">{ m.Text }</p>
					}
					for _, comp := range m.Components {
						<div class="mt-2">@comp</div>
					}
				</div>
			</div>
		}
	}
	@components.AutoScroll()
}
