// graph page
package components

import (
	"github.com/calionauta/gogogo/features/graph"
	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/internal/components"
	"github.com/calionauta/gogogo/internal/ui"
)

// graphStack is the page's technology key, rendered by the shell behind
// [ Stack ]. Matches notificationsStack() shape (name + note).
func graphStack() []components.TechItem {
	return []components.TechItem{
		{Name: "Panorama API", Note: "capabilities + receipts as one JSON map"},
		{Name: "DagNats runs", Note: "live workflow defs via GET /api/graph/dagnats"},
		{Name: "Presence", Note: "GoAkt roster via /api/graph/presence"},
		{Name: "Canvas2D", Note: "pan/zoom/pick, theme-aware colors"},
	}
}

templ Page(email string, role string, buildLabel string, buildCommit string) {
	@ui.Shell(ui.Data{
		Title:       "graph — gogogo",
		Module:      "graph",
		Heading:     "graph",
		Context:     "system panorama",
		Email:       email,
		Role:        role,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
		Stack:       graphStack(),
	}, graphHead(), graphSound(), nil, body())
}

// graphHead carries the page's own <head> extras: the sound assets, so
// the rail's mute control works here too.
templ graphHead() {
	@sounds.SoundAssets()
}

// graphSound is the shell's mute control for this page. It is a
// one-line templ wrapper on purpose: the installer's sounds trim drops the
// @sounds.SoundSwitch() line, leaving an empty wrapper that still satisfies
// the shell's slot (the import goes with it).
templ graphSound() {
	@sounds.SoundSwitch()
}

templ body() {
	<div class="ui-page ui-stack">
		<section class="ui-card">
			<div class="ui-card-body">
				<h2 class="ui-title">System panorama</h2>
				<p class="opacity-70">Capabilities + installed recipes. Click a node for detail.</p>
				<div class="flex flex-wrap gap-4 items-center py-3" aria-label="Graph controls">
					<div class="flex items-center gap-2" role="group" aria-label="View">
						<span class="text-xs text-base-content/60">View</span>
						<div class="join">
							<button type="button" class="btn btn-sm btn-primary" data-graph-source="panorama" aria-pressed="true">Panorama</button>
							<button type="button" class="btn btn-sm" data-graph-source="dagnats" aria-pressed="false">Workflows</button>
							<button type="button" class="btn btn-sm" data-graph-source="presence" aria-pressed="false">Presence</button>
						</div>
					</div>
					<div class="flex items-center gap-2" role="group" aria-label="Kinds">
						<span class="text-xs text-base-content/60">Kinds</span>
						<label class="label cursor-pointer gap-2">
							<input type="checkbox" checked class="toggle toggle-primary toggle-sm" data-graph-filter="core"/>
							<span>Core</span>
						</label>
						<label class="label cursor-pointer gap-2">
							<input type="checkbox" checked class="toggle toggle-secondary toggle-sm" data-graph-filter="plugin"/>
							<span>Servant</span>
						</label>
						<label class="label cursor-pointer gap-2">
							<input type="checkbox" checked class="toggle toggle-accent toggle-sm" data-graph-filter="feature"/>
							<span>Recipe</span>
						</label>
					</div>
					<button id="graph-fit" type="button" class="btn btn-sm btn-ghost">Fit</button>
				</div>
				<canvas id="graph-canvas" style="width:100%;height:520px;cursor:grab;border:1px solid var(--color-base-300);border-radius:0.5rem" aria-label="system graph"></canvas>
				<section id="graph-detail-card" class="mt-3 border border-base-300 rounded-box p-3" aria-live="polite" aria-label="Node detail">
					<p id="graph-detail" class="text-sm text-base-content/70">No node selected.</p>
				</section>
			</div>
		</section>
	</div>
	<script src={ graph.URL("graph.js") } defer></script>
}
