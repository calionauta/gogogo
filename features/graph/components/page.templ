// graph page
package components

import (
	"github.com/calionauta/gogogo/internal/ui"
	"github.com/calionauta/gogogo/features/graph"
)

// Page renders the graph page inside the shared shell.
templ Page(email string, role string, buildLabel string, buildCommit string) {
	@ui.Shell(ui.Data{
		Title:       "graph — gogogo",
		Module:      "graph",
		Heading:     "graph",
		Context:     "system panorama",
		Email:       email,
		Role:        role,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
	}, nil, nil, nil, body())
}

templ body() {
	<div class="ui-page ui-stack">
		<section class="ui-card">
			<div class="ui-card-body">
				<h2 class="ui-title">System panorama</h2>
				<p class="opacity-70">
					System map: capabilities (core/plugin/feature) + installed recipes,
					and live views of the DagNats workflows this binary owns.
					Pan/zoom, click for detail. <span id="graph-rung" class="opacity-60">Canvas2D</span>
				</p>
				<div class="flex gap-2 py-2">
					<button id="graph-fit" class="btn btn-sm btn-ghost">Fit</button>
					<button class="btn btn-sm" data-graph-source="panorama">Panorama</button>
					<button class="btn btn-sm" data-graph-source="dagnats">Workflows</button>
					<span id="graph-detail" class="opacity-80">Select a node.</span>
				</div>
				<canvas id="graph-canvas" style="width:100%;height:520px;cursor:grab;border:1px solid var(--color-base-300);border-radius:0.5rem" aria-label="system graph"></canvas>
			</div>
		</section>
	</div>
	<script src={ graph.URL("graph.js") } defer></script>
}
