// SCOPE:feature — review loop templates.
package components

import (
	"fmt"

	"github.com/calionauta/gogogo/features/authviews"
	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/internal/components"
	"github.com/calionauta/gogogo/web/skins"
)

// ReviewIndex renders the review page: tab picker (text/code), content
// form, live phased progress, verdict fragment. The run button gates on
// signals.ReviewEnabled — without a configured LLM the page shows the
// setup hint instead of a dead button.
templ ReviewIndex(email string, userRole string, buildLabel string, buildCommit string, signals Signals, skinName string) {
	<!DOCTYPE html>
	<html lang="en" { authviews.ThemeRootAttrs(MarshalSignals(signals))... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Review — gogogo</title>
			@skins.ActiveAssets(skinName)
			@authviews.ThemeHead()
			@sounds.SoundAssets()
			@components.OfflineSyncScript(true)
		</head>
		<body>
			@authviews.Navbar(email, userRole, "review", buildLabel, buildCommit, skinName)
			@components.OfflineBanner(true)
			@components.SessionBanner(email != "")
			<main class="container mx-auto p-4 max-w-2xl">
				<h1 class="text-2xl font-bold">Review</h1>
				<p class="text-sm text-base-content/60 mt-1 mb-1">
					Paste text or a diff — a writer and a critic iterate, then a classifier judge delivers the verdict.
				</p>
				@components.TechStack([]components.TechItem{
					{Name: "Genkit flows", Note: "writer/critic/judge loop"},
					{Name: "GoAI", Note: "provider client for the LLM"},
					{Name: "SSE stream", Note: "phases stream with heartbeats"},
					{Name: "Jev judge", Note: "compatible classifier verdict"},
				})
				<div class="mb-4"></div>
				if signals.ReviewEnabled {
					<form
						id="review-composer"
						data-on:submit__prevent={ "$review_pending = true; $review_error = ''; @post('/api/review/run', {contentType: 'form'})" }
						data-on:datastar-fetch="evt.detail.type === 'error' || evt.detail.type === 'retries-failed' ? ($review_pending = false, $review_error = 'Request failed — check your connection and try again.') : null"
						data-cuelume="send"
					>
						<div class="mb-3">
							<label for="review-tab" class="label-text mb-1">What to review</label>
							<select id="review-tab" name="tab" class="select select-bordered w-full max-w-xs">
								<option value="text">Text — email, post, announcement</option>
								<option value="code">Code — diff or snippet</option>
							</select>
						</div>
						<label for="review-content" class="form-control w-full">
							<span class="label-text mb-1">Content to review</span>
							<textarea
								id="review-content"
								name="content"
								required
								minlength="1"
								maxlength="6000"
								rows="8"
								placeholder="Paste an email, a post — or a diff"
								class="textarea textarea-bordered w-full"
							></textarea>
						</label>
						<div class="mt-3 flex items-center gap-3">
							<button type="submit" class="btn btn-primary" data-attr:disabled="!!$review_pending">
								<span data-show="!$review_pending">Run review</span>
								<span data-show="$review_pending" class="loading loading-spinner loading-sm" aria-hidden="true"></span>
								<span data-show="$review_pending">Reviewing…</span>
							</button>
							<span data-show="$review_pending" class="text-sm text-base-content/60">Phase: <span data-text="$review_phase"></span></span>
						</div>
					</form>
				} else {
					<div class="alert alert-warning" role="status">
						<span>Review needs a configured LLM. Set GOAI_API_KEY on the server, then reload.</span>
					</div>
				}
				<div class="mt-2 text-sm text-error" data-show="$review_error !== ''" data-text="$review_error" role="alert"></div>
				<div class="mt-6" id="review-result"></div>
			</main>
			@components.ToastContainer()
		</body>
	</html>
}

// ReviewResult renders one verdict: decision badge, rationale, the
// editor pair's exchange (draft + critique when the critic asked for
// changes), and the human approval gate when the judge escalated.
//
// The root carries `id="review-result"` because this component IS its own
// patch target: handleRun patches with WithSelector("#review-result") in the
// default `outer` mode, which SYNCS ATTRIBUTES FROM THE FRAGMENT — a fragment
// whose root lacked the id removed it from the live node, so run #2 onward
// matched nothing, logged PatchElementsNoTargetsFound, and left the previous
// verdict on screen (lived bug: the result "never changed" and referenced the
// earlier text). Same shape as GenuiResult and #todo-list: the patched region
// is the component's own root, never a wrapper the fragment replaces.
//
// Scalar params keep the chi→components import one-directional (chi owns the
// Verdict type; components must never import chi back).
templ ReviewResult(decision string, rationale string, proposal string, critique string, criticVerdict string, confidence float64, rounds int, needsHuman bool) {
	<div id="review-result" class="card bg-base-200 shadow">
		<div class="card-body">
			<h2 class="card-title">
				Verdict: { decision }
				<span class="badge badge-outline">confidence { fmt.Sprintf("%.2f", confidence) }</span>
				<span class="badge badge-outline">{ fmt.Sprintf("%d rounds", rounds) }</span>
			</h2>
			<p class="text-sm">{ rationale }</p>
			if needsHuman {
				<div class="alert alert-info mt-2" role="status">
					<span>A human should decide — approve the proposal below or revise and re-run.</span>
				</div>
			}
			if criticVerdict == criticRevised {
				<h3 class="font-semibold mt-3 mb-1">Critique</h3>
				<pre class="whitespace-pre-wrap text-sm bg-base-100 rounded p-3">{ critique }</pre>
			}
			if proposal != "" {
				<h3 class="font-semibold mt-3 mb-1">Proposal</h3>
				<pre class="whitespace-pre-wrap text-sm bg-base-100 rounded p-3">{ proposal }</pre>
			}
		</div>
	</div>
}

// criticRevised mirrors the critic's "asked for changes" outcome, so the
// critique is shown only when there IS one. Spelled here rather than imported:
// this package must not depend on the chi slice that owns the Verdict type.
const criticRevised = "revised"

// ReviewPending is the run's opening state: pressing Run replaces the previous
// verdict immediately, so a slow run can never look like a finished one. It
// carries the same root id for the reason spelled out on ReviewResult — this
// is the same patch target.
templ ReviewPending() {
	<div id="review-result" class="card bg-base-200/40 border border-dashed border-base-300" aria-busy="true">
		<div class="card-body">
			<p class="text-sm text-base-content/60">Reviewing… the verdict replaces this.</p>
		</div>
	</div>
}

// ReviewError is the failed-run state. It keeps the region alive (same root
// id, so the next run still has a target) and states the failure instead of
// leaving the previous verdict standing as if it were this run's answer.
templ ReviewError(message string) {
	<div id="review-result" class="card bg-base-200/40 border border-error/40">
		<div class="card-body">
			<div class="alert alert-error" role="alert">
				<span>{ message }</span>
			</div>
			<p class="text-sm text-base-content/60 mt-2">Edit the content above and run again.</p>
		</div>
	</div>
}
