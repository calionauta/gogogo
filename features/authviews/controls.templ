// SCOPE:core — Shell controls shared by the sidebar and the landing header.
//
// These blocks live here, outside internal/ui, because two hosts render them:
// the shell's sidebar footer and the landing page's public header. One
// implementation, two hosts, no chance of the two drifting — the logout POST in
// particular is a pinned contract (controls_test.go).
package authviews

import "github.com/calionauta/gogogo/internal/icon"

// ThemeToggle flips $theme and mirrors it to localStorage. The icon pair is
// CSS-switched (icon-dark-mode / icon-light-mode), so the same markup serves
// both themes; the [data-theme] rules in app.css own the visibility, and no
// script touches the icons.
templ ThemeToggle() {
	<button
		type="button"
		class="app-theme-toggle theme-toggle"
		aria-label="Toggle theme"
		title="Toggle light/dark theme"
		data-on:click="$theme = $theme === 'dark' ? 'light' : 'dark'; localStorage.setItem('themeMode', $theme)">
		@icon.Icon("material-symbols:dark-mode", "text-lg theme-toggle-icon icon-dark-mode")
		@icon.Icon("material-symbols:light-mode", "text-lg theme-toggle-icon icon-light-mode")
	</button>
}

// UserMenu renders the account affordance: a "Sign in" CTA for guests, or the
// dropdown with identity, role, the admin Dashboard link, the DagNats console
// and the sign-out form.
//
// One markup, two hosts, and the host's CSS decides the shape: the landing
// header keeps a compact chip, while the sidebar renders it as the account ROW
// that closes the rail (identity disc, address, role, caret) — the shape
// shadcn calls SidebarFooter and every rail-based app people already know
// ships. The panel direction is the host's too: the rail's copy opens upward,
// because a menu anchored to the bottom edge that opened down lands off-screen.
//
// `prefs` is the host's own preference block (internal/ui.Preferences: palette
// list + sound). The shell passes it because the panel is the app's account
// surface; the landing header passes nil and keeps its quick controls in the
// header, since a guest there has no account panel to open.
//
// The sign-out form posts via fetch rather than a plain submit: Datastar
// preventDefaults every submit carrying data-on:submit, so a native POST would
// never happen through the framework. method/action stay as the no-JS
// fallback (native POST -> 303 -> /login still works), which is why the test
// pins `method="POST"` and `action="/logout"`.
templ UserMenu(userEmail string, userRole string, prefs templ.Component) {
	if userEmail == "" {
		<a
			href="/login"
			class="app-nav-btn is-primary"
			data-on:click="$loading = true">
			Sign in
		</a>
	} else {
		<details class="app-dropdown app-dropdown-up">
			<summary class="app-dropdown-trigger" title="Account" aria-haspopup="menu" aria-label={ "Account menu for " + userEmail }>
				<div class="avatar avatar-placeholder app-account-avatar" aria-hidden="true">
					<div>{ accountInitial(userEmail) }</div>
				</div>
				<span class="app-account-identity">
					<span class="app-user-email">{ userEmail }</span>
					if userRole == "admin" {
						<span class="badge badge-sm badge-primary">Admin</span>
					}
				</span>
				<span class="app-account-caret" aria-hidden="true"></span>
			</summary>
			<ul class="app-dropdown-menu">
				<li class="app-menu-title">
					<span>Signed in as</span>
				</li>
				<li>
					<span class="font-mono text-xs break-all">{ userEmail }</span>
				</li>
				if userRole != "" {
					<li>
						<span class="text-xs text-base-content/60">Role: <strong class="font-mono">{ userRole }</strong></span>
					</li>
				}
				<li>
					<a href="/account" class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="app-menu-icon" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
						</svg>
						Account
					</a>
				</li>
				if userRole == "admin" {
					<li>
						<a href="/config" class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="app-menu-icon" viewBox="0 0 20 20" fill="currentColor">
								<path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-4h2v4zm0-6H9V5h2v2z"/>
							</svg>
							Dashboard
						</a>
					</li>
				}
				<li class="app-menu-sep" role="separator"></li>
				if prefs != nil {
					@prefs
					<li class="app-menu-sep" role="separator"></li>
				}
				<li>
					<form method="POST" action="/logout" data-on:submit="window.__gogogoLogout ? (evt.preventDefault(), $loading = true, window.__gogogoLogout()) : null">
						<button type="submit" class="w-full text-left flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="app-menu-icon" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M3 10a1 1 0 011-1h10a1 1 0 110 2H4a1 1 0 01-1-1zM9 4a1 1 0 011-1h7a1 1 0 011 1v12a1 1 0 01-1 1h-7a1 1 0 01-1-1V4z" clip-rule="evenodd"/>
							</svg>
							Sign out
						</button>
					</form>
				</li>
			</ul>
		</details>
	}
}
