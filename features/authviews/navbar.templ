package authviews

import (
	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/web/skins"
)

// Navbar is the top bar rendered on every authenticated page.
// Shows the app name on the left, a user dropdown on the right with
// the logged-in email and a logout button. Login link when no user.
// `active` marks the current section ("todo" | "whiteboard" | "room" | "notes" | "genui" | "review" | "chat" | "config" | "")
// so the navbar can highlight it. The order of nav items is fixed
// and intentional: collab features first (Todo, Whiteboard, Notes) so the
// common paths are adjacent to the logo, then the LLM demos (Ask AI,
// Chat, Review — conversation before verdict), then Room, then the operator-facing
// Config tab at the end (not a content destination; an inspection
// surface). The logo text always links to "/" — the landing page.
//
// userRole is the session role ("admin" | "user" | "viewer" | "" for
// guests). It gates the operator surfaces (Config tab + Dashboard menu
// item) to admins and is shown in the user dropdown so a tester can tell
// demo1 (admin) from demo2 (viewer) and read the permission the page is
// exercising. The gate is a UI affordance; /config stays enforced by the
// RBAC policy when RBAC_ENABLED=true.
templ Navbar(userEmail string, userRole string, active string, buildLabel string, buildCommit string, skinName string) {
	<nav class="app-nav">
		<div class="app-nav-start">
			<a href="/" class="app-nav-brand">
				gogogo
			</a>
			// Version badge — surfaces the running build so a tester can
			// verify the binary by eye instead of guessing from session
			// storage or grep-ing CDN. "dev" for `go run`. The label has a
			// title= that exposes commit + build time on hover.
			<span class="app-nav-badge" title={ buildCommit + " · built " + buildLabel }>{ buildLabel }</span>
			<details class="app-nav-links" open>
				<summary class="app-nav-menu-btn" aria-label="Open navigation">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path d="M3 5h14v2H3V5zm0 4h14v2H3V9zm0 4h14v2H3v-2z"/>
					</svg>
					<span>Menu</span>
				</summary>
				<div class="app-nav-links-inner">
				<a href="/todo" data-cuelume-hover="tick" data-cuelume-press="toggle" class={ templ.Classes("app-nav-link", map[string]bool{
					"is-active": active == "todo",
				}) }>Collab Todo</a>
				<a href="/whiteboard" data-cuelume-hover="tick" data-cuelume-press="toggle" class={ templ.Classes("app-nav-link", map[string]bool{
					"is-active": active == "whiteboard",
				}) }>Collab whiteboard</a>
				<a href="/notes" data-cuelume-hover="tick" data-cuelume-press="toggle" class={ templ.Classes("app-nav-link", map[string]bool{
					"is-active": active == "notes",
				}) }>Collab notes</a>
				<a href="/genui" data-cuelume-hover="tick" data-cuelume-press="toggle" class={ templ.Classes("app-nav-link", map[string]bool{
					"is-active": active == "genui",
				}) }>Ask AI</a>
				<a href="/chat" data-cuelume-hover="tick" data-cuelume-press="toggle" class={ templ.Classes("app-nav-link", map[string]bool{
					"is-active": active == "chat",
				}) }>Chat</a>
				<details class="app-nav-more">
				<summary class="app-nav-link" aria-label="More destinations">More</summary>
				<div class="app-nav-more-menu">
					<a href="/review" data-cuelume-hover="tick" data-cuelume-press="toggle" class={ templ.Classes("app-nav-link", map[string]bool{
						"is-active": active == "review",
					}) }>Review</a>
					<a href="/room" data-cuelume-hover="tick" data-cuelume-press="toggle" class={ templ.Classes("app-nav-link", map[string]bool{
						"is-active": active == "room",
					}) }>Room</a>
					if userRole == "admin" {
						<a href="/config" data-cuelume-hover="tick" data-cuelume-press="toggle" class={ templ.Classes("app-nav-link", map[string]bool{
							"is-active": active == "config",
						}) }>Config</a>
					}
				</div>
				</details>
				</div>
			</details>
		</div>
		<div class="app-nav-end">
			@CommandPalette(userRole)
			@skins.SkinSelector(skinName)
			<button
				type="button"
				class="app-theme-toggle theme-toggle"
				aria-label="Toggle theme"
				title="Toggle light/dark theme"
				data-on:click="$theme = $theme === 'dark' ? 'light' : 'dark'; Theme.syncIcons($theme); localStorage.setItem('themeMode', $theme)"
			 data-variant="ghost">
				<iconify-icon icon="material-symbols:dark-mode" class="text-lg theme-toggle-icon icon-dark-mode"></iconify-icon>
				<iconify-icon icon="material-symbols:light-mode" class="text-lg theme-toggle-icon icon-light-mode"></iconify-icon>
			</button>
			@sounds.SoundToggle()
			if userEmail == "" {
				<a
					href="/login"
					class="app-nav-btn is-primary"
					data-on:click="$loading = true"
				 data-variant="primary">
					Sign in
				</a>
			} else {
				<div class="app-dropdown">
					<div tabindex="0" role="button" class="app-dropdown-trigger">
						<svg xmlns="http://www.w3.org/2000/svg" class="app-user-icon" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
						</svg>
						<span class="app-user-email">{ userEmail }</span>
					</div>
					<ul class="app-dropdown-menu">
						<li class="app-menu-title">
							<span>Signed in as</span>
						</li>
						<li>
							<span class="font-mono text-xs break-all">{ userEmail }</span>
						</li>
						if userRole != "" {
							<li>
								<span class="text-xs text-base-content/60">Role: <strong class="font-mono">{ userRole }</strong></span>
							</li>
						}
						if userRole == "admin" {
							<li>
								<a href="/config" class="flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="app-menu-icon" viewBox="0 0 20 20" fill="currentColor">
										<path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-4h2v4zm0-6H9V5h2v2z"/>
									</svg>
									Dashboard
								</a>
							</li>
						}
						<li>
							<a href="/dagnats/" class="flex items-center gap-2 cursor-pointer">
								<svg xmlns="http://www.w3.org/2000/svg" class="app-menu-icon" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V5zm2-1a1 1 0 00-1 1v3h10V5a1 1 0 00-1-1H5zm10 6H5v5a1 1 0 001 1h8a1 1 0 001-1v-5z" clip-rule="evenodd"/>
								</svg>
								DagNats
							</a>
						</li>
						<li>
							// Native submit is dead on arrival: Datastar preventDefaults
							// EVERY form submit carrying data-on:submit (see its
							// data-on handler), so a plain action=/logout form
							// with a bare data-on:submit runs the expression and
							// never POSTs. Every other form here uses
							// data-on:submit__prevent + @post; logout is the
							// exception because a 303 has no patch body to
							// consume — instead POST via fetch and navigate by
							// hand. method/action stay as the no-JS fallback
							// (native POST → 303 → /login works without JS).
							<form method="POST" action="/logout" data-on:submit__prevent="$loading = true; fetch('/logout', {method: 'POST', credentials: 'same-origin'}).then(function () { if (navigator.serviceWorker) { navigator.serviceWorker.ready.then(function (r) { r.active && r.active.postMessage({ type: 'clear-pages' }); }); } window.location.href = '/login'; })">
								<button type="submit" class="w-full text-left flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="app-menu-icon" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M3 10a1 1 0 011-1h10a1 1 0 110 2H4a1 1 0 01-1-1zM9 4a1 1 0 011-1h7a1 1 0 011 1v12a1 1 0 01-1 1h-7a1 1 0 01-1-1V4z" clip-rule="evenodd"/>
									</svg>
									Sign out
								</button>
							</form>
						</li>
					</ul>
				</div>
			}
		</div>
	</nav>
}
