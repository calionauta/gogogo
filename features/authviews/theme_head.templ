package authviews

import "github.com/calionauta/gogogo/web/resources"

// ThemeHead renders the no-flash theme bootstrap. Place it as the FIRST
// child of every page <head>: it reads the persisted theme from
// localStorage (falling back to the OS preference, then "light") and sets
// the `data-theme` attribute on <html> BEFORE first paint, so the page
// never flashes the wrong theme. The actual toggle logic lives in
// /static/theme.js (loaded with the rest of the page scripts).
//
// It also loads the iconify web component, which is what makes <iconify-icon>
// render at all: the tag is inert without the script, laying out at 0x0, so a
// page that carries the markup but not the script shows invisible icons. The
// shell's theme and sound toggles are iconify icons, so both are affected.
// Eight pages had copied the tag; three had forgotten it, and the room page's
// icons silently collapsed. That is the same "each page must remember" shape
// that let the theme bindings drift, so the script lives here, with the other
// per-page obligation, rather than being restated everywhere.
//
// It is not `defer`: iconify defines the custom element on load and upgrades
// existing instances, but a plain tag starts the fetch earlier than the module
// scripts, and the component tolerates being defined after the element exists.
templ ThemeHead() {
	<link rel="stylesheet" href={ resources.StaticURL("chrome.css") }/>
	<script>
		(function() {
			try {
				// Accept any stored theme name. The catalog (and which of its
				// palettes are dark) is not restated here: ThemeRootAttrs emits
				// data-theme-dark on the document element from internal/themes,
				// so this bootstrap and theme.js read one list.
				var html = document.documentElement;
				var theme = localStorage.getItem('themeMode');
				if (!theme) {
					theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				html.dataset.theme = theme;
				var darkNames = (html.dataset.themeDark || '').split(' ');
				var isDark = darkNames.indexOf(theme) >= 0;
				if (!isDark && darkNames.indexOf(theme) < 0 && theme !== 'light') {
					isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				}
				html.classList.toggle('dark', isDark);
				// MERGE the theme into the page's seeded signals, never replace
				// the object: <html data-signals> also carries the page's own
				// state (review_pending, genui_pending, chat_thinking), and this
				// script runs before Datastar reads the attribute. Writing a
				// fresh object here dropped every seed, which left /review's Run
				// button disabled on load with no way to submit — the only
				// handler that clears the signal lives on that button's own
				// (unsubmittable) form. The attribute is JSON on every page, so
				// the merge parses it rather than pattern-matching on source.
				var signals = {};
				try {
					signals = JSON.parse(html.dataset.signals || '{}') || {};
				} catch (e) {
					signals = {};
				}
				signals.theme = theme;
				html.dataset.signals = JSON.stringify(signals);
			} catch(e) {
				document.documentElement.dataset.theme = 'light';
			}
		})();
	</script>
	<script src={ resources.StaticURL("iconify-icon.min.js") }></script>
	<script defer src={ resources.StaticURL("command-palette.js") }></script>
}
