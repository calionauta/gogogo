package authviews

import (
	"github.com/calionauta/gogogo/features/sounds"
)


// LoginPage is the standalone /login page (no navbar; the user isn't
// logged in yet). DaisyUI form with the demo credentials prefilled so
// the user just has to click "Sign in".
//
// The demo block below (data-demo="demo-accounts") is TEMPLATE DEMO-ONLY:
// it advertises the seeded demo pair, their roles, and the Casbin
// exercise. Agents adapting gogogo into their own product must delete
// every element carrying a data-demo attribute — see
// docs/scope-taxonomy.md#demo-only-markup.
templ LoginPage(next string, errMsg string) {
	<!DOCTYPE html>
	<html lang="en" data-signals="{theme: 'light'}" data-attr:data-theme="$theme" data-class:dark="$theme === 'dark'">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Sign in — gogogo</title>
			<link rel="stylesheet" href="/static/app.min.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			@ThemeHead()
			<script src="/static/iconify-icon.min.js"></script>
			<script defer type="module" src="/static/datastar.js"></script>
			@sounds.SoundAssets()
		</head>
		<body class="bg-base-200 min-h-screen flex items-center justify-center p-4">
			<div class="card w-full max-w-md bg-base-100 shadow-xl">
				<div class="card-body">
					<h1 class="text-2xl font-bold text-center mb-2">gogogo</h1>
					<p class="text-center text-base-content/60 mb-6">
						Sign in to manage your todos
					</p>

					if errMsg != "" {
						<div role="alert" class="alert alert-error mb-4">
							<span>{ errMsg }</span>
						</div>
					}

					<form method="POST" action="/login" class="space-y-4">
						<input type="hidden" name="next" value={ next }/>
						<label class="form-control w-full">
							<div class="label">
								<span class="label-text">Email</span>
							</div>
							<input
								type="email"
								name="email"
								value="demo1@demo.app"
								class="input w-full"
								required
								autocomplete="email"
							/>
						</label>

						<label class="form-control w-full">
							<div class="label">
								<span class="label-text">Password</span>
							</div>
							<input
								type="password"
								name="password"
								value="demo1234456"
								class="input w-full"
								required
								autocomplete="current-password"
							/>
						</label>

						<button type="submit" class="btn btn-primary w-full" data-variant="primary">
							Sign in
						</button>

						<div class="text-xs text-center text-base-content/40 mt-4">
							Demo 1 prefilled — click <strong>Sign in</strong> to enter.
						</div>
					</form>
					<div class="divider text-xs text-base-content/40">or be both at once</div>
					<div data-demo="demo-accounts" class="text-xs text-base-content/60 space-y-1">
						<p><strong>Demo 1 · admin:</strong> <code>demo1@demo.app</code> · <strong>Demo 2 · viewer:</strong> <code>demo2@demo.app</code> (<code>demo1234456</code> unlocks both accounts). Demo 1 also sees the operator surfaces (<code>/config</code> and the Dashboard menu item); Demo 2 does not.</p>
						<p>One browser holds one login (shared cookie) — open a <strong>second browser or incognito window</strong> and sign in as the other demo. That is how you prove contention (room presenter lock), per-user todos, and authorship.</p>
						<p>Permissions are the per-request decision of <strong>Casbin</strong> over a <code>users.role</code> column (<code>internal/rbac</code>, see <code>docs/rbac.md</code>). Demo 1 is seeded the <code>admin</code> role, Demo 2 the restricted <code>viewer</code> role (reads, creates and toggles todos — no deletes, no paid actions). Turn enforcement on with <code>RBAC_ENABLED=true</code>; re-map any address without a rebuild with the boot lists <code>ADMIN_EMAILS</code> / <code>VIEWER_EMAILS</code> (existing rows only).</p>
					</div>
				</div>
			</div>
		</body>
	</html>
}
