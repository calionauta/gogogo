package authviews

import (
	"github.com/calionauta/gogogo/internal/components"
)

// PasswordResetPage is the emailed reset form. The GET only resolves the
// token; the POST sets the password and revokes sessions.
templ PasswordResetPage(email, token, errMsg string) {
	<!DOCTYPE html>
	<html lang="en" { ThemeRootAttrs(ctx, "")... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Reset password — gogogo</title>
			@components.Assets()
			@ThemeHead()
		</head>
		<body class="bg-base-200 min-h-screen flex items-center justify-center p-4">
			<div class="ui-card w-full max-w-md">
				<div class="ui-card-body">
					<h1 class="text-2xl font-bold text-center mb-2">Choose a new password</h1>
					<p class="text-center text-base-content/60 mb-6">
						For <strong>{ email }</strong>.
					</p>
					if errMsg != "" {
						<div role="alert" class="alert alert-error mb-4">
							<span>{ errMsg }</span>
						</div>
					}
					<form method="POST" action="/api/auth/password/reset" class="space-y-4">
						<input type="hidden" name="token" value={ token }/>
						<label class="flex flex-col gap-1 w-full">
							<div class="label">
								<span>New password</span>
							</div>
							<input type="password" name="password" class="input input-sm" required
								autocomplete="new-password" minlength="8"/>
						</label>
						<label class="flex flex-col gap-1 w-full">
							<div class="label">
								<span>Confirm new password</span>
							</div>
							<input type="password" name="confirm" class="input input-sm" required
								autocomplete="new-password" minlength="8"/>
						</label>
						<button type="submit" class="btn btn-primary w-full">Set password</button>
					</form>
					<p class="text-xs text-center text-base-content/50 mt-4">
						All existing sessions will be signed out.
					</p>
				</div>
			</div>
		</body>
	</html>
}
