package authviews

import "github.com/calionauta/gogogo/internal/rbac"

// CommandPalette is the keyboard-first jump menu (Ctrl/Cmd+K). It is a
// Datastar-native combobox/listbox: the input owns the filter signal, every
// command is a real link, and ArrowUp/ArrowDown move focus through the
// visible options. No framework runtime and no client state outside the
// dialog.
//
// The dialog is a native <dialog>, so Escape, focus trapping and the backdrop
// come from the browser. Links close it on click; a reopen starts with a
// clean query.
//
// guest keeps logged-out surfaces trap-free: anonymous GETs on the app paths
// below are denied by RBAC policy, so for guests every link routes through
// /login?next=<path> and lands in the app after sign-in — the same pattern as
// the landing CTA. The shell passes guest=true only for the landing, the one
// shell page a guest can reach; module pages require a session before they
// render.
func appHref(path string, guest bool) string {
	if guest {
		return "/login?next=" + path
	}
	return path
}

// showRestricted reports whether the role may see the non-collab destinations
// (AI + Room). Guests always do — their links route through login, and the
// post-login role decides. Signed-in viewers do not: the viewer policy denies
// those paths, so offering the link would render a destination that 403s on
// open. Mirrors ui.Visible (sidebar); visibility_policy_test.go pins the
// parity from the policy side.
func showRestricted(userRole string, guest bool) bool {
	return guest || !rbac.IsViewer(userRole)
}

templ CommandPalette(userRole string, guest bool) {
	<div
		data-signals={ `{"cmdQuery":""}` }
		data-on:keydown__window="(evt.metaKey || evt.ctrlKey) && evt.key.toLowerCase() === 'k' ? (evt.preventDefault(), document.getElementById('command-palette').showModal()) : null"
	>
		<button
			type="button"
			class="input input-sm w-auto sm:w-36 lg:w-56 justify-start gap-2 cursor-pointer"
			title="Search — jump to a page (Ctrl/Cmd+K)"
			aria-label="Open command palette"
			data-on:click="document.getElementById('command-palette').showModal()"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-50" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
			</svg>
			<span class="grow text-left opacity-70 hidden sm:inline">Search</span>
			<kbd class="kbd kbd-xs hidden sm:inline-flex">⌘</kbd>
			<kbd class="kbd kbd-xs hidden sm:inline-flex">K</kbd>
		</button>
		<dialog
			id="command-palette"
			class="modal"
			data-on:close="$cmdQuery = ''"
		>
			<div class="modal-box overflow-hidden p-0" style="max-width: 36rem">
				<div class="border-b border-base-300 px-4 py-3">
					<label class="input input-ghost w-full gap-2" for="command-palette-input">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
						</svg>
						<input
							id="command-palette-input"
							name="q"
							class="grow"
							type="text"
							placeholder="Jump to a page…"
							aria-label="Search commands"
							role="combobox"
							aria-controls="command-palette-list"
							aria-expanded="true"
							aria-autocomplete="list"
							data-bind="cmdQuery"
							autofocus
						/>
						<kbd class="kbd kbd-sm shrink-0">esc</kbd>
					</label>
				</div>
				<ul id="command-palette-list" role="listbox" class="menu w-full max-h-96 overflow-y-auto p-2">
					@commandLink("Collab Todo", appHref("/todo", guest), "Tasks")
					@commandLink("Collab whiteboard", appHref("/whiteboard", guest), "Canvas")
					@commandLink("Collab notes", appHref("/notes", guest), "Docs")
					if showRestricted(userRole, guest) {
						@commandLink("Chat", appHref("/chat", guest), "AI")
						@commandLink("Review", appHref("/review", guest), "AI")
						@commandLink("Room", appHref("/room", guest), "Realtime")
					}
					if userRole == "admin" {
						@commandLink("Config", "/config", "Operator")
					}
				</ul>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>
	</div>
}

templ commandLink(label string, href string, hint string) {
	<li data-show={ "$cmdQuery === '' || el.textContent.toLowerCase().includes($cmdQuery.trim().toLowerCase())" }>
		<a href={ templ.URL(href) } role="option" tabindex="-1" data-command data-on:click="document.getElementById('command-palette').close()">
			<span>{ label }</span>
			<span class="ml-auto text-xs opacity-50">{ hint }</span>
		</a>
	</li>
}
