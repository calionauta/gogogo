package authviews

import (
	"github.com/calionauta/gogogo/internal/components"
)

// MagicConfirmPage is the read-only landing for a magic link. The emailed
// GET never consumes the token; the user has to submit this form, which also
// makes email-scanner prefetches harmless and keeps cross-device links
// usable. `bind` is present only in strict same-browser mode.
templ MagicConfirmPage(email, token, bind, errMsg string) {
	<!DOCTYPE html>
	<html lang="en" { ThemeRootAttrs(ctx, "")... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Continue sign-in — gogogo</title>
			@components.Assets()
			@ThemeHead()
		</head>
		<body class="bg-base-200 min-h-screen flex items-center justify-center p-4">
			<div class="ui-card w-full max-w-md">
				<div class="ui-card-body">
					<h1 class="text-2xl font-bold text-center mb-2">Continue sign-in</h1>
					<p class="text-center text-base-content/60 mb-6">
						You are signing in as <strong>{ email }</strong>.
					</p>
					if errMsg != "" {
						<div role="alert" class="alert alert-error mb-4">
							<span>{ errMsg }</span>
						</div>
					}
					<form method="POST" action="/api/auth/magic" class="space-y-4">
						<input type="hidden" name="token" value={ token }/>
						if bind != "" {
							<input type="hidden" name="bind" value={ bind }/>
						}
						<button type="submit" class="btn btn-primary w-full">
							Continue
						</button>
					</form>
					<p class="text-xs text-center text-base-content/50 mt-4">
						If you didn't request this link, close this page.
					</p>
				</div>
			</div>
		</body>
	</html>
}
