// REMOVE by deleting features/dashboard/ plus its two policy rows, its
// Modules entry and its capability row. The dashboard is the host page for
// the `dashboard.card` slot: the page owns the grid, recipes own cells.
//
// The page renders a BODY inside internal/ui.Shell: the shell owns the
// document, the assets, the sidebar and the module header. The grid of
// recipe cards is below the summary; the page iterates fragments and never
// learns which recipe sent one — that is the slot contract.
package components

import (
	"math"
	"strconv"

	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/internal/i18n"
	"github.com/calionauta/gogogo/internal/ui"
	"github.com/calionauta/gogogo/internal/recipe"
)

// PageData is everything the dashboard shows: the session, the grid of
// installed-recipe metric cards, and the fragments recipes declared for
// this page.
type PageData struct {
	Email          string
	Role           string
	Cards          []Card
	DashboardCards []recipe.Fragment
}

// Metric is one labeled count a recipe reports for the dashboard. The
// label is the user's word (from the recipe's Declaration); Value feeds
// the odometer; Signal drives it after the first paint.
type Metric struct {
	Label  string
	Value  int
	Signal string
}

// Outcome is one declared job, as its success count over the eligible count.
// It is rendered as a ratio ("3/5 · 60%") and never as a percentage alone:
// 1/1 and 100/100 are the same 100% and very different evidence. A zero
// denominator renders an em dash, because "no data" is not "0%".
type Outcome struct {
	Label   string
	Success int
	Total   int
	// Counterbalance are the readings that qualify the ratio: the state that
	// says the success number is not the whole story (orders corrected, retries,
	// abandonments). Rendered beside the ratio, never folded into it — a rise in
	// corrections must not be averageable away by a rise in volume.
	Counterbalance []Counterbalance
}

// Counterbalance is one qualifying reading: a label and its count.
type Counterbalance struct {
	Label string
	Value int
}

// Ratio is the display string: counts first, percentage second, "—" when
// nothing was eligible yet.
func (o Outcome) Ratio() string {
	if o.Total == 0 {
		return "—"
	}
	pct := int(math.Round(float64(o.Success) / float64(o.Total) * 100))
	return strconv.Itoa(o.Success) + "/" + strconv.Itoa(o.Total) + " · " + strconv.Itoa(pct) + "%"
}

// Card is one installed recipe in the dashboard grid. Metrics carries its
// labeled counts (empty renders a static link card). Outcomes carries the
// declared jobs as ratios, beside the counts rather than folded into them.
// The Title and URL come from the shell's module registry, so a trimmed
// build loses the card together with its rail destination.
//
// Locked marks a card whose destination the viewer's role cannot open: the
// numbers still show (the grid summarizes the instance), the button does
// not — a link that 403s is a broken promise.
type Card struct {
	Title    string
	URL      string
	Metrics  []Metric
	Outcomes []Outcome
	Cta      string
	Locked   bool
}

// Page renders the /dashboard module inside the shared shell.
templ Page(data PageData, buildLabel string, buildCommit string) {
	@ui.Shell(ui.Data{
		Title:       "Dashboard — gogogo",
		Module:      "dashboard",
		Email:       data.Email,
		Role:        data.Role,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
	}, dashboardHead(), dashboardSound(), nil, dashboardBody(data))
}

// dashboardHead carries the page's own <head> extras: the sound assets,
// so the rail's mute control works here too, plus the odometer island below.
templ dashboardHead() {
	@sounds.SoundAssets()
	<script nonce={ templ.GetNonce(ctx) }>
		// Odometer count-up (Odo). No Datastar primitive counts from one
		// value to another with easing and per-digit roll, so this island
		// owns the animation only; data-effect remains the trigger and
		// runs it on load and whenever the signal changes. The value is
		// stored on the element so a later patch animates from the number
		// currently on screen, not from zero again. Plain script on purpose:
		// data-effect evaluates at Datastar init, so the global must exist
		// before then (deferred modules would run too late).
		window.__gogogoOdo = function (el, target) {
			if (!el) return;
			target = Math.max(0, Math.floor(Number(target) || 0));
			var prev = el.dataset.value ? Number(el.dataset.value) : 0;
			var slots = el.querySelectorAll('.odo-digit');
			var want = String(target).length;
			// Rebuild the slots when the digit count grows (9 -> 100) so
			// the strips can display the longer number at all.
			if (slots.length !== want) {
				el.textContent = '';
				while (el.querySelectorAll('.odo-digit').length < want) {
					var d = document.createElement('span');
					d.classList.add('odo-digit');
					d.setAttribute('aria-hidden', 'true');
					var strip = document.createElement('span');
					strip.classList.add('odo-strip');
					for (var n = 0; n < 10; n++) {
						var s = document.createElement('span');
						s.textContent = String(n);
						strip.appendChild(s);
					}
					d.appendChild(strip);
					el.appendChild(d);
				}
			}
			el.dataset.value = String(target);
			el.setAttribute('aria-label', String(target));
			var strips = el.querySelectorAll('.odo-strip');
			var render = function (n) {
				var s = String(Math.max(0, Math.floor(n))).padStart(strips.length, '0');
				for (var i = 0; i < strips.length; i++) {
					strips[i].style.transform = 'translateY(-' + s[i] + 'em)';
				}
			};
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || prev === target) {
				render(target);
				return;
			}
			// Cancel a still-running count from a previous patch so two
			// rAF loops never fight over the same strips.
			if (el.__gogogoOdoRaf) cancelAnimationFrame(el.__gogogoOdoRaf);
			var dist = Math.abs(target - prev);
			// Expo-out per digit (stagger 30ms per case): fast start,
			// long settle, and the trailing digits start last — the
			// 1900 case rolls fast, then each trailing case lands in
			// turn shorter than the one before, slower as the number
			// closes in on the target.
			var nDigits = strips.length;
			var stagger = Math.min(30, 90 / Math.max(1, nDigits));
			var total = Math.min(1100, 420 + Math.log10(Math.max(dist, 1)) * 280);
			var win = Math.max(1, total - (nDigits - 1) * stagger);
			var t0 = performance.now();
			var tick = function (now) {
				var elapsed = now - t0;
				var p = Math.min(1, elapsed / total);
				var eased = p >= 1 ? 1 : (1 - Math.pow(2, -10 * p));
				var n = prev + (target - prev) * eased;
				var s = String(Math.max(0, Math.floor(n))).padStart(nDigits, '0');
				for (var i = 0; i < nDigits; i++) {
					var lp = Math.min(1, Math.max(0, (elapsed - i * stagger) / win));
					var le = lp >= 1 ? 1 : (1 - Math.pow(2, -10 * lp));
					var digit = String(Math.max(0, Math.floor(prev + (target - prev) * le))).padStart(nDigits, '0')[i];
					strips[i].style.transform = 'translateY(-' + digit + 'em)';
				}
				if (p < 1) {
					el.__gogogoOdoRaf = requestAnimationFrame(tick);
				} else {
					render(target);
					el.__gogogoOdoRaf = null;
				}
			};
			el.__gogogoOdoRaf = requestAnimationFrame(tick);
		};
	</script>
}

// dashboardSound is the shell's mute control for this page. It is a
// one-line templ wrapper on purpose: the installer's sounds trim drops the
// @sounds.SoundSwitch() line, leaving an empty wrapper that still satisfies
// the shell's slot (the import goes with it).
templ dashboardSound() {
	@sounds.SoundSwitch()
}

templ dashboardBody(data PageData) {
	<div class="ui-page ui-stack" data-signals={ MarshalSignals(data.signals()) }>
		<h2 class="ui-title">Welcome back</h2>
		// The dashboard is a summary surface: one card per destination
		// with data, grouped metrics (label + count) plus dashboard.card slot
		// fragments a recipe declares. Navigation lives in the sidebar.
		<section class="grid grid-cols-1 md:grid-cols-2 gap-4" aria-label="Your recipes">
			if len(data.Cards) > 0 || len(data.DashboardCards) > 0 {
				for _, c := range data.Cards {
					<div class="ui-card" data-slot="dashboard.card">
						<div class="ui-card-body">
							<div class="stat">
								<div class="stat-title">{ c.Title }</div>
							</div>
							if len(c.Metrics) > 0 {
								<div class="grid grid-cols-2 gap-3 mt-3">
									for _, m := range c.Metrics {
										<div>
											<div class="text-xs uppercase tracking-wide text-base-content/50">{ m.Label }</div>
											<div class="stat-value">@Odo(m.Value, m.Signal)</div>
										</div>
									}
								</div>
							}
							if len(c.Outcomes) > 0 {
								<div class="mt-3" aria-label="Outcomes">
									for _, o := range c.Outcomes {
										<div class="flex items-baseline justify-between gap-3">
											<span class="text-xs uppercase tracking-wide text-base-content/50">{ o.Label }</span>
											<span class="text-sm">{ o.Ratio() }</span>
										</div>
										for _, c := range o.Counterbalance {
											<div class="flex items-baseline justify-between gap-3 pl-3">
												<span class="text-xs text-base-content/50">↳ { c.Label }</span>
												<span class="text-sm text-base-content/70">{ strconv.Itoa(c.Value) }</span>
											</div>
										}
									}
								</div>
							}
							if c.Cta != "" {
								<div class="stat-actions mt-3">
									<a href={ c.URL } class="btn btn-primary btn-sm">{ c.Cta }</a>
								</div>
							}
							if c.Locked {
								<p class="text-xs text-base-content/50 mt-3">{ i18n.T(ctx, "dashboard.card.locked", nil) }</p>
							}
						</div>
					</div>
				}
				for _, f := range data.DashboardCards {
					<div class="ui-card" data-slot="dashboard.card">
						<div class="ui-card-body">
							<h3 class="ui-title">{ f.Title }</h3>
							@templ.Raw(f.Render())
						</div>
					</div>
				}
			} else {
				<div class="ui-card md:col-span-2">
					<div class="ui-card-body text-center">
						<p class="text-base-content/70">No metrics yet. Add a todo or check your inbox.</p>
					</div>
				</div>
			}
		</section>
	</div>
}

// signals derives the odometer seeds from every metric on the page. The key
// is the metric's own signal name, so a recipe that declares one gets its
// counter without this file knowing anything about it.
func (d PageData) signals() Signals {
	b := Signals{}
	for _, c := range d.Cards {
		for _, m := range c.Metrics {
			if m.Signal == "" {
				continue
			}
			b[m.Signal] = m.Value
		}
	}
	return b
}
