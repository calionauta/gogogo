// REMOVE by deleting features/dashboard/ plus its two policy rows, its
// Modules entry and its capability row. The dashboard is the host page for
// the `dashboard.card` slot: the page owns the grid, recipes own cells.
//
// The page renders a BODY inside internal/ui.Shell: the shell owns the
// document, the assets, the sidebar and the module header. The grid of
// recipe cards is below the summary; the page iterates fragments and never
// learns which recipe sent one — that is the slot contract.
package components

import (
	"github.com/calionauta/gogogo/internal/ui"
	"github.com/calionauta/gogogo/internal/recipe"
)

// PageData is everything the dashboard shows: the session, the two summary
// counts, and the fragments recipes declared for this page.
type PageData struct {
	Email          string
	Role           string
	OpenTodos      int
	TotalTodos     int
	UnreadInbox    int
	DashboardCards []recipe.Fragment
}

// Page renders the /dashboard module inside the shared shell.
templ Page(data PageData, buildLabel string, buildCommit string) {
	@ui.Shell(ui.Data{
		Title:       "Dashboard — gogogo",
		Module:      "dashboard",
		Heading:     "Dashboard",
		Email:       data.Email,
		Role:        data.Role,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
	}, dashboardHead(), dashboardSound(), nil, dashboardBody(data))
}

// dashboardHead carries the page's own <head> extras. The dashboard page
// deliberately does not embed the sound assets: those belong to interactive
// work surfaces' head wrappers, and importing the sounds package here would
// break a trimmed tree that drops the unit.
templ dashboardHead() {
	<script nonce={ templ.GetNonce(ctx) }>
		// Odometer count-up (Odo). No Datastar primitive counts from one
		// value to another with easing and per-digit roll, so this island
		// owns the animation only; data-effect remains the trigger and
		// runs it on load and whenever the signal changes. The value is
		// stored on the element so a later patch animates from the number
		// currently on screen, not from zero again. Plain script on purpose:
		// data-effect evaluates at Datastar init, so the global must exist
		// before then (deferred modules would run too late).
		window.__gogogoOdo = function (el, target) {
			if (!el) return;
			target = Math.max(0, Math.floor(Number(target) || 0));
			var prev = el.dataset.value ? Number(el.dataset.value) : 0;
			var slots = el.querySelectorAll('.odo-digit');
			var want = String(target).length;
			// Rebuild the slots when the digit count grows (9 -> 100) so
			// the strips can display the longer number at all.
			if (slots.length !== want) {
				el.textContent = '';
				while (el.querySelectorAll('.odo-digit').length < want) {
					var d = document.createElement('span');
					d.classList.add('odo-digit');
					d.setAttribute('aria-hidden', 'true');
					var strip = document.createElement('span');
					strip.classList.add('odo-strip');
					for (var n = 0; n < 10; n++) {
						var s = document.createElement('span');
						s.textContent = String(n);
						strip.appendChild(s);
					}
					d.appendChild(strip);
					el.appendChild(d);
				}
			}
			el.dataset.value = String(target);
			el.setAttribute('aria-label', String(target));
			var strips = el.querySelectorAll('.odo-strip');
			var render = function (n) {
				var s = String(Math.max(0, Math.floor(n))).padStart(strips.length, '0');
				for (var i = 0; i < strips.length; i++) {
					strips[i].style.transform = 'translateY(-' + s[i] + 'em)';
				}
			};
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || prev === target) {
				render(target);
				return;
			}
			// Cancel a still-running count from a previous patch so two
			// rAF loops never fight over the same strips.
			if (el.__gogogoOdoRaf) cancelAnimationFrame(el.__gogogoOdoRaf);
			var dist = Math.abs(target - prev);
			var dur = Math.min(1500, 600 + Math.log10(Math.max(dist, 1)) * 350);
			var t0 = performance.now();
			var tick = function (now) {
				var p = Math.min(1, (now - t0) / dur);
				var eased = 1 - Math.pow(1 - p, 3);
				render(prev + (target - prev) * eased);
				if (p < 1) {
					el.__gogogoOdoRaf = requestAnimationFrame(tick);
				} else {
					render(target);
					el.__gogogoOdoRaf = null;
				}
			};
			el.__gogogoOdoRaf = requestAnimationFrame(tick);
		};
	</script>
}

// dashboardSound keeps the shell's sound slot empty on purpose; the shell
// renders the same document whether the slot carries content or not.
templ dashboardSound() {
}

templ dashboardBody(data PageData) {
	<div class="ui-page ui-stack" data-signals={ MarshalSignals(Signals{OpenTodos: data.OpenTodos}) }>
		<section class="ui-card" aria-label="Your summary">
			<div class="ui-card-body">
				<h2 class="ui-title">Welcome back</h2>
				<div class="stats stats-vertical sm:stats-horizontal shadow">
					<div class="stat">
						<div class="stat-title">Open todos</div>
						<div class="stat-value">@Odo(data.OpenTodos, "openTodos")</div>
						<div class="stat-desc">of { data.TotalTodos } total</div>
						<div class="stat-actions">
							<a href="/todo" class="btn btn-primary btn-sm">Open Todo</a>
						</div>
					</div>
					<div class="stat">
						<div class="stat-title">Inbox</div>
						<div class="stat-value">@Odo(data.UnreadInbox, "inboxUnread")</div>
						<div class="stat-desc">unread messages</div>
						<div class="stat-actions">
							<a href="/notifications" class="btn btn-sm">Open Inbox</a>
						</div>
					</div>
				</div>
			</div>
		</section>
		// The dashboard.card slot: one grid cell per recipe fragment. The
		// grid is this page's layout, the cells are the recipes' content.
		<section class="grid grid-cols-1 md:grid-cols-2 gap-4" aria-label="Recipe cards">
			if len(data.DashboardCards) > 0 {
				for _, f := range data.DashboardCards {
					<div class="ui-card" data-slot="dashboard.card">
						<div class="ui-card-body">
							<h3 class="ui-title">{ f.Title }</h3>
							@templ.Raw(f.Render())
						</div>
					</div>
				}
			} else {
				<div class="ui-card md:col-span-2">
					<div class="ui-card-body text-center">
						<p class="text-base-content/70">No extensions installed yet. Your dashboard cards appear here — try listing in Todo or the Inbox.</p>
					</div>
				</div>
			}
		</section>
	</div>
}
