// Odo renders the dashboard's odometer counter.
//
// SSR renders the final value: every digit slot already sits at its final
// position, so the page reads correctly with no JavaScript and screen
// readers get the value through aria-label. The strips are aria-hidden —
// they are decoration, the label is the number.
//
// window.__gogogoOdo (dashboardHead) replays the count from the previously
// shown value to the current signal on load and on every change, so the
// digits roll up from a smaller number to the exact value instead of
// jumping to it.
//
// The effect names the element with the expression's own `el` (the one
// variable Datastar binds beside $-signals): $el would be rewritten to
// $['el'] (a signal named "el", which does not exist), so the count
// would silently no-op. The value is stored on the element so a later
// patch animates from the number currently on screen.
package components

import (
	"strconv"

	"github.com/calionauta/gogogo/internal/recipe"
)

// Odo is one dashboard stat value with a rolling-digit strip per digit.
// signal is the camelCase Datastar signal name (e.g. "openTodos") that
// drives the counter; the component does not know where the signal lives.
templ Odo(value int, signal string) {
	@odoValue(value, odoEffect(signal))
}

// odoValue renders the counter. effect is the count-up trigger and is empty
// when the signal is not a JavaScript identifier — then the number stands
// on its own (the SSR value is already final).
templ odoValue(value int, effect string) {
	<span
		class="odo"
		if effect != "" {
			data-effect={ effect }
		}
		aria-live="polite"
		aria-label={ strconv.Itoa(value) }
	>
		for _, r := range strconv.Itoa(value) {
			<span class="odo-digit" aria-hidden="true"><span class="odo-strip" style={ "transform: translateY(-" + string(r) + "em);" }>
				for _, d := range "0123456789" {
					<span>{ string(d) }</span>
				}
			</span></span>
		}
	</span>
}

// odoEffect is the count-up trigger: the element animates to the signal's
// value. A signal that is not a JavaScript identifier gets NO trigger —
// the SSR value is already the final number, and a broken expression would
// take the page's script down with it.
func odoEffect(signal string) string {
	if !recipe.IsJSIdent(signal) {
		return ""
	}
	return "window.__gogogoOdo(el, $" + signal + ")"
}
