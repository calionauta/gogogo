// SCOPE:feature — the inbox's machinery, rendered in the shell's state panel.
//
// The inbox is not only a list: it is a durable workflow (the delay), a
// delivery router (in-app always, one external channel when configured) and one
// row per channel/attempt. This panel shows that pipeline as STATE — engine
// on/off, addressable channels, what the delivery rows actually say — instead
// of a second copy of the list the page already renders.
//
// The numbers are a page-load snapshot. They move only when a delivery row is
// written, and the list beside them is the live surface; the panel answers
// "what machinery is behind this page", not "how many unread".
package components

import (
	"strconv"
	"strings"
)

// stateRow is one label/state pair: the dot is decoration, the word carries the
// meaning (same rule as the /config runtime card).
templ stateRow(label string, state string, dotClass string, hint string) {
	<div class="flex items-center justify-between gap-3 border-b border-base-300 py-1.5 last:border-0">
		<span class="text-sm text-base-content/70" title={ hint }>{ label }</span>
		<span class="flex items-center gap-1.5">
			<span class={ "status status-sm " + dotClass } aria-hidden="true"></span>
			<span class="text-sm font-medium">{ state }</span>
		</span>
	</div>
}

// StatePanel renders the delivery pipeline for the shell's [ State ] section.
templ StatePanel(data PageData) {
	<div class="app-state-panel-inner">
		<section aria-label="Delivery pipeline">
			<h3 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-1">Pipeline</h3>
			@stateRow("Durable engine", engineWord(data.Wired), engineTone(data.Wired),
				"DagNats owns the sleep step: a restart between schedule and delivery resumes the run")
			@stateRow("Channels", channelWord(data.Channels), channelTone(data.Channels),
				"in-app is always written; an external channel appears only when its transport is configured and the account has an address")
		</section>
		<section aria-label="Delivery rows" class="mt-4">
			<h3 class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-1">Deliveries</h3>
			if len(data.Deliveries) == 0 {
				<p class="text-sm text-base-content/70">No delivery row yet. Schedule a reminder to write the first one.</p>
			} else {
				for _, d := range data.Deliveries {
					@stateRow(deliveryLabel(d), strconv.Itoa(d.Count), deliveryTone(d.Status),
						"one row per channel and attempt; a retried step dedupes on the transaction id")
				}
			}
		</section>
	</div>
}

// engineWord is the state word for the durable engine. "wired" is the honest
// one: the form exists and the run starts, which is the fact the page acts on.
func engineWord(wired bool) string {
	if wired {
		return "wired"
	}
	return "off"
}

func engineTone(wired bool) string {
	if wired {
		return "status-success"
	}
	return "status-neutral"
}

// channelWord lists the delivery targets this account can actually reach.
func channelWord(channels []ChannelOption) string {
	names := []string{"in-app"}
	for _, ch := range channels {
		names = append(names, ch.Channel)
	}
	return strings.Join(names, ", ")
}

func channelTone(channels []ChannelOption) string {
	if len(channels) == 0 {
		return "status-info"
	}
	return "status-success"
}

// deliveryLabel spells a bucket the way a person reads it: the channel first
// (in_app -> In-app), then the outcome.
func deliveryLabel(d DeliveryCount) string {
	channel := strings.ReplaceAll(d.Channel, "_", "-")
	if channel != "" {
		channel = strings.ToUpper(channel[:1]) + channel[1:]
	}
	status := d.Status
	if status == "" {
		status = "unknown"
	}
	return channel + " · " + status
}

// deliveryTone maps a row status to the dot colour. "sent" is the only success;
// a skip or a throttle is a record of a delivery that did not happen, so it is
// a warning rather than an error.
func deliveryTone(status string) string {
	switch status {
	case "sent":
		return "status-success"
	case "error":
		return "status-error"
	case "skipped", "throttled":
		return "status-warning"
	case "pending":
		return "status-info"
	default:
		return "status-neutral"
	}
}
