// SCOPE:core — The /todo page body inside the shared shell.
//
// Everything around the page moved to internal/ui.Shell: document, assets,
// sidebar, module header, banners, toast root. What is left here is the page's
// own head extras (sound assets + the todo item animations) and its body.
//
// The 7 stack layers this module demonstrates (C1) travel as data into the
// shell's stack key, so they render in the sidebar footer instead of competing
// with the composer (that competition was defect 4 of the revamp brief).
package components

import (
	"strconv"
	"strings"

	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/features/todo"
	"github.com/calionauta/gogogo/internal/components"
	"github.com/calionauta/gogogo/internal/ui"
)

// Layout renders /todo inside the shell. The signature is the handlers'
// contract (title, signals, session, build, offline, skin) and is unchanged.
templ Layout(title string, signals todo.Signals, userEmail string, userRole string, buildLabel string, buildCommit string, offlineSync bool, skinName string, demo bool) {
	@ui.Shell(ui.Data{
		Title:       title,
		Module:      "todo",
		Context:     todoContext(signals, offlineSync),
		Email:       userEmail,
		Role:        userRole,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
		Skin:        skinName,
		OfflineSync: offlineSync,
		Stack:       todoStack(),
		Demo:        demo,
		Panel:       TodoStatePanel(signals),
	}, todoHead(), todoSound(), TodoPresence(signals), todoBody(signals))
}

// todoContext is the header's context slot: four short facts, one line. It
// used to concatenate StoreLabel and OfflineLabel, and OfflineLabel is a
// sentence ("Turso + NATS_ENABLED=true — SW queues browser mutations ..."), so
// the header rendered a paragraph. The slot is for state, not prose: the same
// facts in the same shape every module uses.
func todoContext(signals todo.Signals, offlineSync bool) string {
	parts := []string{"turso"}
	if offlineSync {
		parts = append(parts, "outbox on")
	}
	parts = append(parts, strconv.Itoa(signals.ConnectedClients)+" online", "SSE")
	return strings.Join(parts, " · ")
}

// todoStack is the stack this page demonstrates, in disclosure order. The
// notes say what the layer does *here*, not what it is in the abstract.
func todoStack() []components.TechItem {
	return []components.TechItem{
		{Name: "JetStream realtime", Note: "CRUD ops stream across instances"},
		{Name: "SSE Hub", Note: "every open tab re-lists live"},
		{Name: "goqite queue", Note: "AI + demo jobs run in background"},
		{Name: "retry-go", Note: "transient failures retry with backoff"},
		{Name: "DagNats workflows", Note: "durable onboarding pipeline"},
		{Name: "offline outbox", Note: "offline mutations queue, then sync"},
		{Name: "Casbin RBAC", Note: "per-request role permissions"},
	}
}

// todoHead carries the page's own <head> extras. The toast styles moved to the
// shell; what stays is the sound assets and the list's motion rules.
templ todoHead() {
	@sounds.SoundAssets()
	<style>
					to { width: 0%; }
				}

				/* ---------- Todo item animations (self vs remote) ---------- */

				/* Default entry for the initial server-rendered list:
				   soft fade + tiny zoom. */
				.todo-item {
					animation: todo-enter-initial 300ms ease-out both;
				}
				@keyframes todo-enter-initial {
					from { opacity: 0; transform: scale(0.96); }
					to   { opacity: 1; transform: scale(1); }
				}

				/* Soft entry for every todo row (self or remote): fade + slight
				   zoom. The previous design tagged each row with a global
				   $lastItemSource signal, which — because the whole list is
				   re-rendered on every broadcast — stamped EVERY row as
				   "remote" and sprayed a floating "↳ from elsewhere" badge
				   above all tasks (the reported blank/cut-off tooltip bug).
				   A bulk re-render cannot scope an origin to a single new
				   row, so we dropped per-row source tagging and keep one
				   clean entry animation for all arrivals. */
				.todo-item {
					position: relative;
					animation: todo-enter-initial 280ms ease-out both;
				}

				/* View Transitions: cross-fade when Datastar morphs the
				   list. Earlier we put `view-transition-name: todo-item`
				   on every .todo-item, which produced 'Unexpected
				   duplicate view-transition-name' + 'InvalidStateError'
				   in the console because multiple items in the same
				   patch share the same name. The View Transitions API
				   expects per-element unique names — which we can't
				   hand out cheaply from a static CSS rule. So we skip
				   the explicit `view-transition-name` and rely on the
				   entry keyframes below (self/remote slide+fade) to
				   animate new arrivals; Datastar still calls
				   `document.startViewTransition()` around the morph,
				   so deleted/reordered items get a smooth blend from
				   the default browser cross-fade. */
				::view-transition-old(todo-item),
				::view-transition-new(todo-item) {
					animation-duration: 320ms;
					animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
				}
	</style>
}

// soundToggle is the shell's mute control for this page. It is a
// one-line templ wrapper on purpose: the installer's sounds trim drops the
// @sounds.SoundToggle() line, leaving an empty wrapper that still satisfies
// the shell's slot (the import goes with it). Passing the call directly
// would put it on the same line as the Shell invocation, and dropping that
// line would break the call.
templ todoSound() {
	@sounds.SoundToggle()
}

// todoBody is the page itself plus the two stream scripts the list listens on.
templ todoBody(signals todo.Signals) {
	<div class="ui-page">
		@TodoList(signals)
	</div>
	@components.StreamOpener("sse-opener", "/api/todos/stream", false)
	@RealtimeRecords()
}
