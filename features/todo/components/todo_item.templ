package components

import (
	"fmt"
	"time"

	"github.com/calionauta/gogogo/features/todo"
)

// TodoItem renders a single todo row. Important wiring notes:
//
//   - The checkbox's checked state is rendered server-side via the
//     `checked={ item.Completed }` Templ attr; the click handler
//     posts the toggle. Datastar does NOT auto-fire the click when the
//     server renders `checked` (we previously saw it auto-submit in
//     some flows because the input didn't have a value binding).
//
//   - The delete button opens the shared confirmation modal (one
//     dialog instance for every row), driven by the $confirmingDeleteId
//     signal. Clicking the trash sets the id and the title (used in
//     the modal's "Delete <title>?" body), then the modal handles the
//     confirm/cancel flow.
//
//   - canDelete is the RBAC display hint (false for the viewer role):
//     the trash renders aria-disabled with the reason instead of
//     opening the modal, and the click raises $permDenied. Enforcement
//     stays server-side (policy.csv answers 403) — this only narrates.
//
//   - TodoRowActions is the ONLY surface-specific part. The row is rendered
//     on /todo and inside a Chat answer, and both must show the same row; the
//     host supplies where the two writes post, never a second copy of the
//     markup. The Chat panel used to reimplement the row and lost the shared
//     badge, the author, the age, the viewer gate and the native dialog.
type TodoRowActions struct {
	// IDPrefix scopes the row's DOM id. /todo uses "todo-"; a panel uses
	// its own instance prefix so two answers holding the same row do not
	// mint duplicate ids on one page.
	IDPrefix string
	// Toggle is the Datastar click expression for the checkbox.
	Toggle string
	// Delete is the Datastar click expression for the trash: set the
	// confirming ids and open the host's confirmation dialog.
	Delete string
}

// TodoItem renders one row. Delete + authorship affordances come
// server-stamped on the item (IsMine/CanDelete via listVisible) — the
// template never re-derives the rule, so the rule has exactly one home
// (canDeleteRow, enforced by the handler on POST).
templ TodoItem(item todo.Todo, actions TodoRowActions) {
	<div
		class="todo-item flex items-center gap-3 p-3 border-b border-base-300 hover:bg-base-200 transition-colors"
		id={ actions.IDPrefix + item.ID }
		data-created={ item.CreatedAt.UTC().Format("2006-01-02") }
		data-show={ "!$createdAfter || el.dataset.created >= $createdAfter" }
	>
		<input
			type="checkbox"
			class="checkbox checkbox-primary checkbox-sm"
			checked?={ item.Completed }
			data-on:click__prevent={ actions.Toggle }
		/>
		if item.Completed {
			<span class="todo-title flex-1 line-through text-base-content/50">{ item.Title }</span>
		} else {
		<span class="todo-title flex-1">{ item.Title }</span>
	}
		if item.IsShared() {
			<span class="badge badge-info badge-xs" title="Shared: every login sees this todo">Shared</span>
			if !item.IsMine && item.OwnerEmail != "" {
				<span class="todo-author text-xs text-base-content/40" title="Author">by { item.OwnerEmail }</span>
			}
		}
		<span class="todo-age text-xs text-base-content/40">{ timeAgo(item.CreatedAt) }</span>
		if item.CanDelete {
			<button
				type="button"
				class="btn btn-ghost btn-xs text-error transition-transform hover:scale-110 active:scale-95"
				title="Delete todo"
				data-cuelume-press="droplet"
				data-on:click__prevent={ actions.Delete }>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
				</svg>
			</button>
		} else {
			<button
				type="button"
				class="btn btn-ghost btn-xs opacity-50"
				aria-disabled="true"
title="Delete (only the author or an admin can delete — viewers never delete)"
				data-cuelume-press="droplet"
				data-on:click__prevent={ "$permDenied = true" }>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
				</svg>
			</button>
		}
	</div>
}

// timeAgo renders a compact, meaningful relative age ("now", "5m ago",
// "3h ago", "2d ago", "1mo ago") so each row gets a distinct, instantly
// readable creation time. The old fallback (dd/mm) collapsed everything
// to a year-less date that meant nothing when created was missing. A zero
// CreatedAt renders empty rather than a nonsense "54y ago" from
// time.Since(zero) — and created is populated correctly once the seed no
// longer shadows the database's system field (internal/demo/demo.go).
func timeAgo(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "now"
	case d < time.Hour:
		m := int(d.Minutes())
		if m == 1 {
			return "1m ago"
		}
		return fmt.Sprintf("%dm ago", m)
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	case d < 7*24*time.Hour:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	case d < 30*24*time.Hour:
		return fmt.Sprintf("%dw ago", int(d.Hours()/(7*24)))
	case d < 365*24*time.Hour:
		return fmt.Sprintf("%dmo ago", int(d.Hours()/(30*24)))
	default:
		return fmt.Sprintf("%dy ago", int(d.Hours()/(365*24)))
	}
}
