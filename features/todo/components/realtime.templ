package components

import ic "github.com/calionauta/gogogo/internal/components"

// The persistent todo SSE stream is opened by the shared
// components.StreamOpener (internal/components/stream_opener.templ), mounted
// ONCE from Layout: hidden @get button + clientID bootstrap + verified open.
// One opener for every feature, so the wiring cannot drift per page.

// RealtimeRecords composes the todo page's two refetch paths. Record
// changes arrive live over the feature SSE stream (components.StreamOpener, mounted
// by the layout): the hub fans out a record event per mutation and the
// stream re-lists scoped — per-user by construction, so there is no
// cross-user broadcast leak. This component adds the manual path both
// halves share:
//   - the hidden @get button (ListResync) re-fetches the list fragment
//     via Datastar's programmatic @get, morphing #todo-list in place;
//   - DocVersionWatcher clicks it when the doc-version signal moves.
//
// The fragment URL carries `q` as well as filter/scope: the endpoint (and the
// SetView it performs) treats a missing q as "no search", so omitting it would
// make every resync — load, visibility return, doc-version bump, offline sync —
// re-render the full list and clear an active search out from under the box.
templ RealtimeRecords() {
	@searchModeScript()
	@ic.ListResync("todo-realtime-resync", "'/api/todos/fragment?filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all') + '&q=' + encodeURIComponent($searchQuery || '') + '&mode=' + encodeURIComponent(searchModeValue()) + '&clientID=' + encodeURIComponent($clientID || '')")
	@DocVersionWatcher()
}

// searchModeScript defines the one function that reads the SELECTED search mode
// off the picker, so the box, the picker and every resync path ask the server
// for the same layer.
//
// A PLAIN script, not a module and not deferred — the same reason
// __gogogoDocWatch is one: the data-on expressions that call it are bound by
// Datastar at init, which runs before deferred modules, so a module-scoped
// function would be undefined at that moment. The body only defines a
// function, so nothing runs at parse time.
//
// It reads the DOM instead of a signal on purpose. The ACTIVE mode is
// server-owned (the server falls back when a layer is unwired), while the
// control only ever REQUESTS one; a data-bind signal would make the request
// value authoritative and the two could drift when the server overrides it.
// An absent picker (single wired layer, or none) returns "", which the server
// reads as "use the default".
templ searchModeScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		window.searchModeValue = function () {
			var sel = document.querySelector('select[name="mode"]');
			return sel ? sel.value : '';
		};
	</script>
}

// DocVersionWatcher re-fetches the list when the SSE hub fans out a
// doc-version-bumped event (cross-instance peer write). Split out of
// RealtimeRecords so the shared resync component stays generic:
// record changes arrive over the stream, doc-version bumps through
// this watcher, both ending on the same hidden @get button.
//
// Reactive, not polling: data-effect re-runs its expression whenever
// $docVersion changes (plus once on load), so no 250ms timer keeps a
// goroutine-equivalent alive in every tab. The script holds only the
// pure compare-and-click function — Datastar owns the subscription.
templ DocVersionWatcher() {
	<script nonce={ templ.GetNonce(ctx) }>
		// Plain (non-module, non-deferred) script on purpose: data-effect
		// evaluates at Datastar init, which runs before deferred module
		// scripts — a module-defined function is not yet defined then and
		// every evaluation throws (caught live by scripts/todo-docwatch).
		// The body only defines a function; nothing runs at parse time.
		window.__gogogoDocWatch = function (v) {
			if (v == null) { return; }
			if (window.__gogogoDocVersionSeen === undefined) {
				window.__gogogoDocVersionSeen = v;
				return;
			}
			if (v !== window.__gogogoDocVersionSeen) {
				window.__gogogoDocVersionSeen = v;
				var b = document.getElementById("todo-realtime-resync");
				if (b) { b.click(); }
			}
		};
	</script>
	<div data-effect="window.__gogogoDocWatch($docVersion)" hidden aria-hidden="true"></div>
}
