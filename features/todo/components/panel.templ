package components

import "github.com/calionauta/gogogo/features/todo"

// Panel renders the viewer's own todos for the AI answer surfaces: the app's
// truth, hydrated server-side by TodoPanel.Fill, so the model chooses a slice
// and never the content.
//
// It lives with the feature, not in features/genui/components: the panel seam
// is provider-based, so the generative-UI plugin knows names and props in the
// abstract and never what a todo is. Moving it made genui's own package free
// of feature knowledge (one direction of dependency, enforced by
// check-flatdeps).
//
// The rows are INTERACTIVE, not read-only: the checkbox posts a toggle and
// the trash asks before deleting, exactly like a row on the Todos page, each
// carrying the panel instance's id as `_target` plus the panel's filter slice.
// The routes answer in place (see handlers/panel_action.go) by re-rendering
// THIS panel, so the acting tab never goes stale. Adding stays on the Todos
// page (the link above): a create answers with a result card, not a
// re-rendered list, so a composer here would replace the panel with its own
// receipt.
templ Panel(id string, filter string, rows []todo.PanelRows) {
	<div id={ id } class="rounded-box border border-base-300 p-4">
		<div class="flex items-baseline justify-between gap-2 mb-2">
			<h3 class="font-semibold">{ todoListHeading(filter) }</h3>
			<a href="/todo" class="link link-hover text-xs">Open in Todos</a>
		</div>
		if len(rows) == 0 {
			// The empty line names the SLICE. "No todos" was a lie whenever the
			// panel held a filter (the viewer had rows, just not in this slice),
			// and with `open` as the default that is the common case for a user
			// whose work is done.
			<p class="text-sm opacity-60">{ panelEmptyCopy(filter) }</p>
		} else {
			<ul class="flex flex-col gap-1">
				for _, row := range rows {
					<li class="flex items-center gap-2">
						<input
							type="checkbox"
							class="checkbox checkbox-primary checkbox-sm"
							checked?={ row.Done }
							title={ panelToggleTitle(row) }
							data-on:click__prevent={ panelToggleExpr(row.ID, id, filter) }
						/>
						<span class={ "flex-1 " + todoRowTitleClass(row.Done) }>{ row.Title }</span>
						<button
							type="button"
							class="btn btn-ghost btn-xs text-error"
							title={ "Delete “" + row.Title + "”" }
							data-on:click__prevent={ panelAskDeleteExpr(row.ID, id) }
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
								<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
							</svg>
						</button>
					</li>
				}
			</ul>
			// One dialog per row, INSIDE this panel instance: the shared
			// #confirm-delete-modal lives on the Todos page, which a chat answer
			// never renders. Scoping the ids by the panel keeps two answers (or
			// two tabs) from opening each other's dialog, and the server-minted
			// ids are safe inside getElementById.
			for _, row := range rows {
				@panelDeleteDialog(id, filter, row)
			}
		}
	</div>
}

// panelDeleteDialog is the panel's own copy of the page's confirmation step:
// same question, same "can't be undone" line, one dialog per row. It lives in
// the row's panel instead of a page-level modal because the panel renders on
// surfaces this feature does not own (a chat answer), and a trash that deleted
// on the first click there would be a different contract from the same row on
// /todo.
templ panelDeleteDialog(panelID, filter string, row todo.PanelRows) {
	<dialog id={ panelDeleteDialogID(panelID, row.ID) } class="modal">
		<div class="modal-box">
			<h3 class="font-bold text-lg text-error flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
				</svg>
				Delete this todo?
			</h3>
			<p class="py-4 text-sm">
				This will permanently remove <span class="font-semibold">{ row.Title }</span>.
				This can't be undone.
			</p>
			<div class="modal-action">
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					data-on:click={ panelCloseDeleteExpr(row.ID, panelID) }>
					Cancel
				</button>
				<button
					type="button"
					class="btn btn-error btn-sm"
					data-cuelume-press="droplet"
					data-on:click={ panelCloseDeleteExpr(row.ID, panelID) + "; " + panelDeleteExpr(row.ID, panelID, filter) }>
					Delete
				</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button data-on:click={ panelCloseDeleteExpr(row.ID, panelID) }>close</button>
		</form>
	</dialog>
}

// panelToggleExpr posts one row's toggle carrying this panel's slot id and
// slice, so the route answers by re-rendering the panel in place (see
// handlers/panel_action.go). The todo id, the slot id and the filter are all
// server-minted (UUIDs, instance ids, the closed enum), so embedding them in
// the path and query is safe; the route validates _target again before aiming
// a patch at it. clientID rides the query like every other mutation, so the
// hub fan-out still excludes the acting tab.
func panelToggleExpr(todoID, panelID, filter string) string {
	return "@post('/api/todos/" + todoID + "/toggle?filter=" + filter + "&_target=" + panelID + "&clientID=' + encodeURIComponent($clientID || ''))"
}

// panelAskDeleteExpr opens this row's confirmation dialog. It deliberately
// posts NOTHING: the same row on the Todos page asks first, and a chat answer
// is not a reason to offer a one-click permanent delete.
func panelAskDeleteExpr(todoID, panelID string) string {
	return "document.getElementById(" + safeJSString(panelDeleteDialogID(panelID, todoID)) + ").showModal()"
}

// panelCloseDeleteExpr closes this row's dialog (Cancel, the confirm button
// before it posts, and the backdrop).
func panelCloseDeleteExpr(todoID, panelID string) string {
	return "document.getElementById(" + safeJSString(panelDeleteDialogID(panelID, todoID)) + ").close()"
}

// panelDeleteDialogID is one row's dialog inside one panel instance. Both
// halves are server-minted ids, so the concatenation is DOM- and
// selector-safe; scoping by the panel is what keeps a thread's two answers
// (or two tabs) from sharing a dialog.
func panelDeleteDialogID(panelID, todoID string) string {
	return panelID + "-delete-" + todoID
}

// panelDeleteExpr posts one row's delete once the confirmation dialog is
// closed, carrying the panel's slot id and slice so the route answers with the
// panel minus the row (or an in-place failure card when the requester may not
// delete it).
func panelDeleteExpr(todoID, panelID, filter string) string {
	return "@post('/api/todos/" + todoID + "/delete?filter=" + filter + "&_target=" + panelID + "&clientID=' + encodeURIComponent($clientID || ''))"
}

// panelToggleTitle names what the checkbox will do, for sighted hover and
// assistive tech alike (a bare checkbox otherwise announces nothing).
func panelToggleTitle(row todo.PanelRows) string {
	if row.Done {
		return "Mark “" + row.Title + "” as open"
	}
	return "Mark “" + row.Title + "” as done"
}

// panelEmptyCopy names the slice the panel is empty FOR, so "caught up" is
// never confused with "you have no todos at all".
func panelEmptyCopy(filter string) string {
	switch filter {
	case "open":
		return "No open todos — you're all caught up."
	case "done":
		return "No completed todos yet."
	default:
		return "No todos to show here. Add one in Todos."
	}
}

// todoListHeading names the slice in the user's words. The filter is a
// validated enum, so the last arm is the "all" case, not a fallback for
// bad input.
func todoListHeading(filter string) string {
	switch filter {
	case "open":
		return "Your open todos"
	case "done":
		return "Your completed todos"
	default:
		return "Your todos"
	}
}

func todoRowTitleClass(done bool) string {
	if done {
		return "line-through opacity-60"
	}
	return ""
}
