package components

import (
	"github.com/calionauta/gogogo/internal/ui"
	"encoding/json"
	"strconv"

	"github.com/calionauta/gogogo/features/todo"
)

// marshalSignals serializes the initial signal set as a JSON string for
// `data-signals`. JSON marshalling is used because Templ's own string
// interpolation would not handle nested arrays / correct quoting.
func marshalSignals(s todo.Signals) string {
	b, _ := json.Marshal(s)
	return string(b)
}

// TodoList is the full application card: search, filter tabs, todo list,
// capture form, AI suggest buttons, the todo list, and the clear-completed
// footer. Filter context sits above the list it narrows; capture sits
// directly above the rows it adds to, right below the filters — not docked
// to the viewport bottom. Chat and Ask keep the docked bottom composer;
// capture here is adjacent to its rows instead.
//
// Signal flow (all defined via `data-signals` so they live across patches):
//   - $newTitle: bound to the title input
//   - $loading: true while an HTTP form is in flight (Add button spinner)
//   - $filter: "all" | "active" | "completed" (drives tabs)
//   - $itemCount: live count, patched by every mutation
//   - $suggestPending: true while an AI suggest job is in flight
//   - $suggestions, $suggestErr: most recent LLM result
//   - $lastRetryStatus / Operation / Attempt: most recent retry feedback
//   - $connectedClients: live SSE presence count
//   - $onboardingStep / Phase / Detail / Active / Completed: durable workflow
//   - $confirmingDeleteId: id of the todo whose delete-confirm modal is open
//   - $searchQuery: active search text (empty = unfiltered); the search input
//     OWNS it (data-bind) and seeds it once from value=, so no server merge may
//     write it (see searchBox + docs/realtime-recipe.md)
//   - $techStep, $techDone, $techPhase: diagnostics panel state machine
//
// Every mutation handler is responsible for patching the relevant
// signals and re-rendering the `<div id="todo-list">` region so the
// other browser tabs share the same view via the broadcaster.
templ TodoList(signals todo.Signals) {
	<div class="max-w-5xl mx-auto mt-8 px-4 animate-in fade-in zoom-in-95 animate-duration-500">
		<div data-signals={ marshalSignals(signals) } data-on:gogogo:queued__window="$loading = false; $newTitle = ''; localStorage.removeItem('todo-draft'); $deleting = false; $confirmingDeleteId = ''; $confirmingDeleteTitle = ''" data-on:keydown__window="evt.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName) && !document.activeElement.isContentEditable ? (evt.preventDefault(), document.getElementById('todo-search-input').focus()) : null">

			<!-- ═══════════════ MAIN GRID ═══════════════ -->
			<div class="grid grid-cols-1 gap-5">

				<!-- ──────────── LEFT: TODO LIST (3/5) ──────────── -->
				<div class="lg:col-span-3 space-y-5">
					<div class="ui-card">
						<div class="ui-card-head">

							<h2 class="ui-title">Tasks</h2>
							<span class="badge badge-sm" data-text="$itemCount + ' items'"></span>
						</div>
						<div class="ui-card-body ui-stack">

							@searchBox(signals)

							<div class="flex flex-wrap items-center gap-2" role="toolbar" aria-label="Task filters">
								<div class="tabs tabs-box tabs-sm" role="tablist" aria-label="Status filter">
									<button type="button" role="tab" class="tab" data-on:click={ ui.TodoFilterOn("all") } data-class="{'tab-active': ($filter || 'all') === 'all'}">All</button>
									<button type="button" role="tab" class="tab" data-on:click={ ui.TodoFilterOn("active") } data-class="{'tab-active': ($filter || 'all') === 'active'}">Active</button>
									<button type="button" role="tab" class="tab" data-on:click={ ui.TodoFilterOn("completed") } data-class="{'tab-active': ($filter || 'all') === 'completed'}">Completed</button>
								</div>
								<select
									class="select select-sm w-28"
									aria-label="Listing scope"
									title="Which todos to list"
									data-on:change={ ui.TodoScopeSelectOn() }>
									<option value="all" selected?={ signals.Scope == "" || signals.Scope == "all" }>All</option>
									<option value="mine" selected?={ signals.Scope == "mine" }>Mine</option>
									<option value="shared" selected?={ signals.Scope == "shared" }>Shared</option>
								</select>
								@createdFilter()
							</div>
							<div class="alert alert-warning mt-2" role="alert" data-show="$permDenied">
								<span>You cannot delete this todo — its author or an admin can. Keep adding.</span>
								<button type="button" class="btn btn-ghost btn-sm" data-on:click={ "$permDenied = false" }>dismiss</button>
							</div>
							<div class="alert alert-info mt-2" role="status" id="todo-list-offline" data-show="$listOffline">
								<span>Changing the list needs a connection — the view stays as it is until you reconnect.</span>
								<button type="button" class="btn btn-ghost btn-sm" data-on:click={ "$listOffline = false" }>dismiss</button>
							</div>
							@createForm(signals)

							@SuggestionsList(signals.Suggestions)

							@TodoListRegion(signals)

							if signals.ItemCount > 0 {
								<div class="flex justify-end items-center mt-4 pt-3 border-t border-base-200">
								<button
									class="btn btn-ghost btn-xs text-error transition-all hover:scale-105 active:scale-95"
									data-cuelume-press="droplet"
									title="Delete your own completed todos (shared rows by others stay)"
									data-on:click="document.getElementById('confirm-clear-completed').showModal()">
									Clear my completed
								</button>
								</div>
							}

						</div>
					</div>

				</div>

			</div><!-- /grid -->

			@deleteConfirmModal(pageDeleteModalSpec())
		@clearCompletedModal()
		</div>

		<div class="toast toast-end" id="retry-toast" data-show="$loading"></div>
	</div>
}

// createForm owns the title input + Add button. It sits immediately above
// the list it adds to (filters above, rows below) — never docked to the
// viewport bottom: a sticky footer composer made capture feel detached
// from the rows it creates. Buttons disable themselves via Datastar
// signals so the user can't double-fire.
//
// The pending state belongs to the REQUEST: the action clears $loading when
// its promise settles, so a queue write that never completes cannot freeze the
// button. The intent is stored BEFORE the post (GogogoOutbox.begin), so a
// failed or hanging request leaves a replayable intent rather than a lost
// title. The alert is reserved for the one case that is a real loss: the
// outbox could not store the intent (storage blocked), which fail() reports by
// returning a zero count.
templ createForm(signals todo.Signals) {
	<form
		id="todo-create"
		class="w-full mt-3"
		data-init="var d = localStorage.getItem('todo-draft'); var i = document.getElementById('todo-create-title'); if (d && i && !i.value) { i.value = d; i.dispatchEvent(new Event('input', { bubbles: true })) }"
		data-on:submit__prevent="if (!$loading) { $loading = true; $syncFailed = false; var id = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : 'id-' + Date.now() + '-' + Math.random().toString(36).slice(2); var url = '/api/todos?clientID=' + encodeURIComponent($clientID || '') + '&filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all') + '&idem_key=' + encodeURIComponent(id); var body = new URLSearchParams(new FormData(el)).toString(); var sent = $newTitle; var key = window.GogogoOutbox.begin({url: new URL(url, location.href).href, method: 'POST', body: body, headers: {'Content-Type': 'application/x-www-form-urlencoded'}}); el.dataset.opKey = key; @post(url, {contentType: 'form', retryMaxCount: 0, headers: {'Idempotency-Key': key}}).then(() => { $loading = false; var st = Number(el.dataset.opStatus || 0); delete el.dataset.opStatus; if (st === 0) { window.GogogoOutbox.ack(key); if ($newTitle === sent) { $newTitle = ''; localStorage.removeItem('todo-draft'); } } else { window.GogogoOutbox.fail(key); if (st !== 408 && st !== 429 && st < 500) $syncFailed = true; } }).catch(() => { $loading = false; delete el.dataset.opStatus; window.GogogoOutbox.fail(key); }); }"
	>
		<div class="join w-full">
			<input
				id="todo-create-title"
				type="text"
				name="title"
				class="input input-sm join-item grow"
				placeholder="What needs doing?"
				aria-label="New todo title"
				data-bind="newTitle"
				data-on:input__debounce.200ms="el.value ? localStorage.setItem('todo-draft', el.value) : localStorage.removeItem('todo-draft')"
			/>
			<button
				type="submit"
				class="btn btn-primary btn-sm join-item"
				data-attr:disabled="!!($loading || !$newTitle.trim())">
				<span class="inline-flex items-center gap-2">
					Add
					<span class="loading loading-spinner loading-xs" data-show="$loading"></span>
				</span>
			</button>
		</div>
		<label class="ui-meta mt-2 flex items-center gap-2 cursor-pointer">
			<input type="checkbox" name="visibility" value="public" class="checkbox checkbox-xs checkbox-info"/>
			<span>Shared — every login sees this todo (private by default)</span>
		</label>
		<div class="alert alert-warning mt-2" role="alert" id="todo-save-error" data-show="$syncFailed">
			<span>Not saved — the request failed. Your text is still in the box; try again.</span>
			<button type="button" class="btn btn-ghost btn-sm" data-on:click="$syncFailed = false">dismiss</button>
		</div>
	</form>
}

// searchBox is the plugin's UI half: it exists only when a layer is wired
// (signals.SearchEnabled). Typing re-fetches through `/api/todos/search` with
// a 300ms debounce, and that handler patches the same `#todo-list` region the
// filter tabs do — so the ranking shows up as the row order, with no results
// panel to keep in sync and no client-side list to hydrate.
//
// The input OWNS `$searchQuery` (data-bind): it is the source of truth while
// the user types, and the server never writes it — a re-list cannot clobber
// the box (docs/realtime-recipe.md). The one seed is on first render:
// `value={ signals.SearchQuery }` sets the initial text, and bind.ts creates
// the signal from it ({ifMissing: true}). `?q=` therefore reaches the box
// without the server ever touching a client-owned signal.
templ searchBox(signals todo.Signals) {
	if signals.SearchEnabled {
		<!-- One toolbar line: search, how it matches, and the date filter. The old
		     layout stacked three rows and explained the match mode in prose under a
		     select labelled "Match". -->
		<div class="join w-full">
			<input
					id="todo-search-input"
				type="search"
					name="q"
					class="input input-sm join-item grow"
					placeholder="Search todos  ( / )"
				aria-label="Search todos"
				value={ signals.SearchQuery }
				data-bind="searchQuery"
				data-on:input__debounce.300ms={ ui.TodoSearchOn() }
			/>
			<button
				type="button"
				class="btn btn-ghost btn-sm join-item"
				aria-label="Clear search"
				data-show="$searchQuery"
				data-on:click={ ui.TodoSearchClearOn() }>✕</button>
			@searchModeSelect(signals)
		</div>
	}
}

// searchModeSelect renders the layer picker (substring / fuzzy / bm25) when the
// operator wired more than one.
//
// WHY a select and not tabs: the three layers are the SAME results ranked
// differently, not different views of the data — a segmented control would
// imply content changes. A compact select says "how should this be matched".
//
// It is a real <form>-less control wired through @get (the same mechanism the
// box uses) rather than a data-bind signal, because the ACTIVE mode is a
// server decision: the server falls back when a layer is unwired, so it is the
// authority on what is actually in effect (`searchMode` signal) while the
// select just requests a change. Rendering it from signals.SearchModes is what
// keeps the options in step with what boot actually built — no hardcoded list.
//
// Hidden entirely with one wired layer: a picker with a single option is noise,
// and the substring-only build (the trimmed/plugin-free case) must look exactly
// as it did before.
templ searchModeSelect(signals todo.Signals) {
	if len(signals.SearchModes) > 1 {
		<select
			name="mode"
			class="select select-sm join-item max-w-34"
			aria-label="How the search matches"
			title="How the search matches"
			data-on:change={ ui.TodoSearchModeOn() }
		>
			for _, m := range signals.SearchModes {
				<option value={ m } selected?={ m == signals.SearchMode }>{ searchModeLabel(m) }</option>
			}
		</select>
	}
}

// searchModeLabel names a layer in the user's words. Unknown names fall through
// as-is rather than being hidden: a fourth layer added to the plugin should
// appear in the picker immediately, even before it gets a friendly label.
func searchModeLabel(mode string) string {
	switch mode {
	case "substring":
		return "exact"
	case "fuzzy":
		return "typo-tolerant"
	case "bm25":
		return "relevance"
	default:
		return mode
	}
}

// searchModeHint says what the selected layer does, so the choice is not a
// guess. Kept to one short clause per mode.
func searchModeHint(mode string) string {
	switch mode {
	case "substring":
		return "matches the letters you type"
	case "fuzzy":
		return "tolerates typos and partial words"
	case "bm25":
		return "ranks by relevance, best first"
	default:
		return ""
	}
}

// scopeTabs renders the listing slice (All / Mine / Shared). Like the
// status tabs, clicks re-fetch with the other dimension preserved, and the
// active state reads from the `$scope` signal so SSE patches stay in sync.
// TodoListRegion renders just the list rows + empty state. Patched by
// every mutation (local and broadcaster) so both the originating tab
// and remote tabs stay in sync. The `<div id="todo-list">` selector is
// the merge target for RenderAndPatch.
templ TodoListRegion(signals todo.Signals) {
	// The prototype lives INSIDE #todo-list on purpose: every mutation patches
	// that element by selector (mode outer), so the template is replaced with
	// the region — exactly one copy. As a SIBLING it was never removed by the
	// patch and accumulated one clone per re-list (three on screen after three
	// mutations). <template> content is inert: it has no layout and is not
	// matched by selectors, so it never counts as a row.
	<div class="divide-y divide-base-200 pb-6" id="todo-list">
		@TodoPendingRow()
		if len(signals.Todos) == 0 {
			<div class="ui-empty" id="todo-empty-state">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
				</svg>
				<p class="ui-empty-title">No todos here yet.</p>
				<p class="ui-empty-body">
					Add one below to get started.
					if !signals.IsViewer {
						if signals.DagNatsEnabled {
							Or open Demo mode and use Run durable workflow to create examples.
						} else {
							The queue and AI suggestions live in Demo mode.
						}
					}
				</p>
			</div>
		}
		for _, item := range signals.Todos {
			@TodoItem(item, pageRowActions(item))
		}
	</div>
}

// deleteDialogID is the page's single confirmation dialog. The panel scopes
// its own dialog id by the panel instance; both render the SAME
// deleteConfirmModal component, so the copy, the buttons and the close
// behaviour cannot drift between the two surfaces.
const deleteDialogID = "confirm-delete-modal"

// pageRowActions is the /todo half of TodoItem: the URL carries the page's
// filter/scope signals and the trash opens the page's shared dialog.
func pageRowActions(item todo.Todo) TodoRowActions {
	return TodoRowActions{
		IDPrefix: "todo-",
		Toggle: todoMutateOn("'/api/todos/" + item.ID + "/toggle?filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all') + '&clientID=' + encodeURIComponent($clientID || '')"),
		Delete: "$confirmingDeleteId = " + safeJSString(item.ID) + "; $confirmingDeleteTitle = " + safeJSString(item.Title) + "; document.getElementById(" + safeJSString(deleteDialogID) + ").showModal()",
	}
}

// pageDeleteConfirmExpr is the confirm button's action on /todo: the row id
// and title ride the signals the trash set, and the list slice rides the
// page's filter/scope signals.
func pageDeleteConfirmExpr() string {
	return todoMutateOn("'/api/todos/' + $confirmingDeleteId + '/delete?clientID=' + encodeURIComponent($clientID || '') + '&filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all')")
}

// SuggestionsList renders the AI-suggested completions as clickable
// buttons. Clicking a suggestion fills the newTitle signal so the
// user can review and submit. It carries id="suggestions-region" so the
// SSE dispatcher can re-render it with PatchElements when $suggestions
// arrives (a bare MergeSignals would only toggle visibility, never
// populate the buttons). The container is always present; visibility is
// driven by $suggestions being non-empty.
templ SuggestionsList(suggestions []string) {
	<div
		class="mb-4 p-3 bg-base-200/40 rounded-lg transition-all duration-500 animate-in fade-in slide-in-from-top-2"
		id="suggestions-region"
		data-show="$suggestions && $suggestions.length > 0"
	>
		<div class="text-xs text-base-content/50 mb-2">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 inline -mt-0.5 mr-1 text-secondary" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
			</svg>
			Suggestions — click to use:
		</div>
		<div class="flex flex-wrap gap-2">
			for _, s := range suggestions {
				<button
					type="button"
					class="btn btn-xs btn-outline btn-secondary transition-all hover:scale-105 active:scale-95 animate-in fade-in slide-in-from-bottom-1"
					style="animation-delay: 0.05s"
					data-on:click={ "$newTitle = " + safeJSString(s) }>
					{ s }
				</button>
			}
		</div>
		<script nonce={ templ.GetNonce(ctx) }>
			// Plain script on purpose (see DocVersionWatcher): data-effect
			// evaluates at Datastar init, before deferred modules load.
			window.__gogogoSuggestScroll = function (list) {
				var n = list ? list.length : 0;
				if (window.__gogogoSuggestSeen === undefined) {
					window.__gogogoSuggestSeen = n;
					return;
				}
				if (n > window.__gogogoSuggestSeen) {
					window.__gogogoSuggestSeen = n;
					var el = document.getElementById("suggestions-region");
					if (el) { el.scrollIntoView({block: "nearest"}); }
				} else {
					window.__gogogoSuggestSeen = n;
				}
			};
		</script>
		<div data-effect="window.__gogogoSuggestScroll($suggestions)" hidden aria-hidden="true"></div>
	</div>
}

// safeJSString returns s as a JSON string literal with surrounding
// double quotes, suitable for embedding inside a Datastar
// data-on:click expression. We use strconv.Quote so Go's standard
// escaping handles control characters and quotes consistently.
func safeJSString(s string) string {
	return strconv.Quote(s)
}

// clearCompletedModal asks before a bulk delete. "Clear my completed" posted
// immediately: one click removed every completed todo in the view, with no undo
// and no confirmation, while a single-row delete already asked.
templ clearCompletedModal() {
	<dialog id="confirm-clear-completed" class="modal">
		<div class="modal-box">
			<h3 class="ui-title text-error">Clear completed todos?</h3>
			<p class="py-4 text-sm">
				This permanently removes every completed todo in the current view. It can't be undone.
			</p>
			<div class="modal-action">
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					data-on:click="document.getElementById('confirm-clear-completed').close()">
					Cancel
				</button>
				<button
					type="button"
					class="btn btn-error btn-sm"
					data-on:click={ "document.getElementById('confirm-clear-completed').close(); " + todoMutateOn("'/api/todos/completed/delete?clientID=' + encodeURIComponent($clientID || '') + '&filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all')") }>
					Clear completed
				</button>
			</div>
		</div>
	</dialog>
}

// deleteModalSpec is everything deleteConfirmModal needs that differs by
// surface. The component owns the markup; the spec keeps a second dialog from
// being written (the Chat panel used to duplicate it per row).
type deleteModalSpec struct {
	ID           string
	ConfirmExpr  string
	PendingID    string
	PendingTitle string
}

// pageDeleteModalSpec is /todo: the page's shared signals and list URL.
func pageDeleteModalSpec() deleteModalSpec {
	return deleteModalSpec{
		ID:           deleteDialogID,
		ConfirmExpr:  pageDeleteConfirmExpr(),
		PendingID:    "$confirmingDeleteId",
		PendingTitle: "$confirmingDeleteTitle",
	}
}

// deleteConfirmModal is the ONE confirmation dialog: /todo and a Chat
// panel both render it, each through a deleteModalSpec that names the dialog
// id, the confirm URL and the two "which row is pending" signals. The PANEL
// scopes those signal names to its instance, so two answers on one thread
// cannot share a pending row (a shared name would let one panel's dialog
// confirm the other panel's row). The markup, copy, buttons and close
// behaviour are one definition.
templ deleteConfirmModal(spec deleteModalSpec) {
	<dialog id={ spec.ID } class="modal" data-on:close={ spec.PendingID + " = ''; " + spec.PendingTitle + " = ''; $deleting = false" }>
		<div class="modal-box">
			<h3 class="font-bold text-lg text-error flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
				</svg>
				Delete this todo?
			</h3>
			<p class="py-4 text-sm">
				This will permanently remove <span class="font-semibold" data-text={ spec.PendingTitle }></span>.
				This can't be undone.
			</p>
			<div class="modal-action">
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					data-on:click={ "document.getElementById(" + safeJSString(spec.ID) + ").close()" }>
					Cancel
				</button>
				<button
					type="button"
					class="btn btn-error btn-sm transition-all"
					data-cuelume-press="droplet"
					data-attr:disabled="!!$deleting"
					data-on:click={ "$deleting = true; document.getElementById(" + safeJSString(spec.ID) + ").close(); " + spec.ConfirmExpr }>
					<span class="inline-flex items-center gap-2">
						<span>Delete</span>
						<span class="loading loading-spinner loading-xs" data-show="$deleting"></span>
					</span>
				</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button data-on:click={ "document.getElementById(" + safeJSString(spec.ID) + ").close()" }>close</button>
		</form>
	</dialog>
}

// todoMutateOn wraps a todo mutation (toggle, delete, clear-completed) with
// the durable outbox: the intent is stored (synchronously, via the crash
// journal) BEFORE the request leaves, and its key rides every retry so the
// server can recognise a re-delivery. The optimistic state still comes from
// the same `gogogo:queued` event, so nothing forks by transport.
//
// ack() on success and fail() on a failed request are what turn "one request"
// into "one durable intent": a tab closed mid-flight leaves the intent in the
// outbox, and the drain finishes it on the next load. fail() is also what
// draws the pending row — this expression does not touch the DOM.
func todoMutateOn(urlExpr string) string {
	// The element carries the op key so the page-wide `datastar-fetch` handler
	// (todo-offline.js) can mark THIS mutation as answered with an error
	// status. Datastar resolves the action on any HTTP answer, so without the
	// mark a 5xx would look like success and the intent would be dropped;
	// with it the intent stays queued and the drain classifies the status.
	return "var url = " + urlExpr + "; " +
		"var key = window.GogogoOutbox.begin({url: new URL(url, location.href).href, method: 'POST'}); " +
		"el.dataset.opKey = key; " +
		"@post(url, {headers: {'Idempotency-Key': key}, retryMaxCount: 0})" +
		".then(() => { var st = Number(el.dataset.opStatus || 0); delete el.dataset.opStatus; if (st === 0) { window.GogogoOutbox.ack(key); } else { window.GogogoOutbox.fail(key); } })" +
		".catch(() => { delete el.dataset.opStatus; window.GogogoOutbox.fail(key); })"
}

// createdFilter is the date filter: a Cally calendar inside a native
// popover. The filter is display-only — each row carries data-created and
// data-show compares it with the $createdAfter signal: no request, no server
// round trip, and it survives list patches because the box owns the signal.
//
// The calendar is a web component (<calendar-date>), so it only renders once
// web/resources/static/cally.js has loaded; layout.templ mounts that module on
// this page. Without it the element stays an unknown tag and the popover opens
// empty — which is exactly how the calendar broke before (the loader was
// dropped in the one-shell rewrite while the element stayed). The presets
// below do not depend on it, so the filter still works if the script fails.
//
// createdFilter uses the native Popover API (popovertarget + popover) rather
// than a Datastar signal: nothing reacts to its open state, and the browser
// supplies light dismiss, Escape and top-layer stacking with no listener or
// extra state. To react to open/close later, switch to a signal + __outside:
//
//   <div data-signals='{"dateOpen":false}' data-on:click__outside="$dateOpen = false">
//     <button data-on:click="$dateOpen = !$dateOpen">…</button>
//     <div data-show="$dateOpen">…</div>
//   </div>
//
// A <details> with data-on:click__outside also works; the element is not the
// issue, and native stays the default while open state has no consumer.
templ createdFilter() {
	<div class="flex items-center gap-2 shrink-0">
		<button
			type="button"
			id="created-filter-btn"
			popovertarget="created-filter-popover"
			class="btn btn-ghost btn-sm gap-2"
			style="anchor-name:--created-filter"
			aria-label="Filter by creation date"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-70" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v9a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm10 6H4v7h12V8z" clip-rule="evenodd"/>
			</svg>
			<span data-text="$createdAfter === '' ? 'Any date' : 'Since ' + $createdAfter"></span>
		</button>
		<button
			type="button"
			class="btn btn-ghost btn-sm"
			data-show="$createdAfter !== ''"
			data-on:click="$createdAfter = ''; $noMatches = false"
		>clear</button>
	</div>
	<div id="created-filter-popover" popover class="app-date-popover bg-base-100 text-base-content border border-base-300 rounded-box shadow-lg p-3">
		<p class="ui-meta">Created since</p>
		<calendar-date
			class="cally mt-1"
			aria-label="Created since"
			data-on:change={ `$createdAfter = evt.target.value; $noMatches = false; document.getElementById('created-filter-popover').hidePopover()` }
		>
			<svg slot="previous" aria-label="Previous month" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
			</svg>
			<svg slot="next" aria-label="Next month" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
			</svg>
			<calendar-month></calendar-month>
		</calendar-date>
		<div class="flex flex-wrap gap-1 mt-2">
			<button type="button" class="btn btn-ghost btn-sm" data-on:click={ `$createdAfter = new Date().toISOString().slice(0, 10); $noMatches = false; document.getElementById('created-filter-popover').hidePopover()` }>Today</button>
			<button type="button" class="btn btn-ghost btn-sm" data-on:click={ `$createdAfter = new Date(Date.now() - 7 * 864e5).toISOString().slice(0, 10); $noMatches = false; document.getElementById('created-filter-popover').hidePopover()` }>7 days</button>
			<button type="button" class="btn btn-ghost btn-sm" data-on:click={ `$createdAfter = new Date(Date.now() - 30 * 864e5).toISOString().slice(0, 10); $noMatches = false; document.getElementById('created-filter-popover').hidePopover()` }>30 days</button>
		</div>
	</div>
}
