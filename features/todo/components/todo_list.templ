package components

import (
	"github.com/calionauta/gogogo/internal/ui"
	"encoding/json"
	"strconv"

	"github.com/calionauta/gogogo/features/todo"
)

// marshalSignals serializes the initial signal set as a JSON string for
// `data-signals`. JSON marshalling is used because Templ's own string
// interpolation would not handle nested arrays / correct quoting.
func marshalSignals(s todo.Signals) string {
	b, _ := json.Marshal(s)
	return string(b)
}

// TodoList is the full application card with the create form, AI suggest
// buttons, filter tabs, todo list, clear-completed footer, and a
// contextual sidebar with async-layer demo cards.
//
// Signal flow (all defined via `data-signals` so they live across patches):
//   - $newTitle: bound to the title input
//   - $loading: true while an HTTP form is in flight (Add button spinner)
//   - $filter: "all" | "active" | "completed" (drives tabs)
//   - $itemCount: live count, patched by every mutation
//   - $suggestPending: true while an AI suggest job is in flight
//   - $suggestions, $suggestErr: most recent LLM result
//   - $lastRetryStatus / Operation / Attempt: most recent retry feedback
//   - $connectedClients: live SSE presence count
//   - $onboardingStep / Phase / Detail / Active / Completed: durable workflow
//   - $confirmingDeleteId: id of the todo whose delete-confirm modal is open
//   - $searchQuery: active search text (empty = unfiltered); the search input
//     OWNS it (data-bind) and seeds it once from value=, so no server merge may
//     write it (see searchBox + docs/realtime-recipe.md)
//   - $techStep, $techDone, $techPhase: diagnostics panel state machine
//
// Every mutation handler is responsible for patching the relevant
// signals and re-rendering the `<div id="todo-list">` region so the
// other browser tabs share the same view via the broadcaster.
templ TodoList(signals todo.Signals) {
	<div class="max-w-5xl mx-auto mt-8 px-4 animate-in fade-in zoom-in-95 animate-duration-500">
		<div data-signals={ marshalSignals(signals) } data-on:gogogo:queued__window="$loading = false; $newTitle = ''; $deleting = false; $confirmingDeleteId = ''; $confirmingDeleteTitle = ''">

			<!-- ═══════════════ MAIN GRID ═══════════════ -->
			<div class="grid grid-cols-1 lg:grid-cols-5 gap-5">

				<!-- ──────────── LEFT: TODO LIST (3/5) ──────────── -->
				<div class="lg:col-span-3 space-y-5">
					<div class="card bg-base-100 shadow-md transition-shadow hover:shadow-lg duration-300">
						<div class="card-body p-5">

							<h2 class="card-title text-lg mb-1">
								Tasks
								<span class="badge badge-ghost badge-sm" data-text="$itemCount + ' items'"></span>
							</h2>

							@createForm(signals)

							@searchBox(signals)

							@SuggestionsList(signals.Suggestions)

							@ui.Segmented("Listing scope", []ui.Segment{
								{Label: "All", On: ui.TodoScopeOn("all"), Active: "($scope || 'all') === 'all'"},
								{Label: "Mine", On: ui.TodoScopeOn("mine"), Active: "($scope || 'all') === 'mine'"},
								{Label: "Shared", On: ui.TodoScopeOn("shared"), Active: "($scope || 'all') === 'shared'"},
							})
							@ui.Segmented("Status filter", []ui.Segment{
								{Label: "All", On: ui.TodoFilterOn("all"), Active: "($filter || 'all') === 'all'"},
								{Label: "Active", On: ui.TodoFilterOn("active"), Active: "($filter || 'all') === 'active'"},
								{Label: "Completed", On: ui.TodoFilterOn("completed"), Active: "($filter || 'all') === 'completed'"},
							})
							@createdFilter()
							<div class="alert alert-warning mt-2" role="alert" data-show="$permDenied">
								<span>You cannot delete this todo — its author or an admin can. Keep adding.</span>
								<button type="button" class="btn btn-ghost btn-xs" data-on:click={ "$permDenied = false" }>dismiss</button>
							</div>
							@TodoListRegion(signals)

							if signals.ItemCount > 0 {
								<div class="flex justify-between items-center mt-4 pt-3 border-t border-base-200">
									<span class="text-xs text-base-content/50" data-text="$itemCount + ' items'"></span>
								<button
									class="btn btn-ghost btn-xs text-error transition-all hover:scale-105 active:scale-95"
									data-cuelume-press="droplet"
									title="Delete your own completed todos (shared rows by others stay)"
									data-on:click="while (document.querySelector('.todo-item')) { @post('/api/todos/completed/delete?clientID=' + encodeURIComponent($clientID || '') + '&filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all')); break; }">
									Clear my completed
								</button>
								</div>
							}

						</div>
					</div>

				</div>

				<!-- ──────────── RIGHT: ASYNC DEMOS (2/5) ──────────── -->
				<div class="lg:col-span-2 space-y-4">

				<!-- Presence lives in exactly one place: the header pill above
				     (count + transport, with what-it-means in its tooltip). The
				     standalone Realtime card duplicating those signals was removed —
				     it carried no action, only a second copy. -->

					<!-- ─── Async Demo Tabs: Queue + Retry | AI Suggest | Durable Workflow ───
				This single card holds the three async-layer demos as DaisyUI tabs so
				each demo's content lives INSIDE its own tab container. $sidebarTab
				selects the active tab (seeded "queue"). Queue + Retry demos goqite +
				retry-go with HARD-CODED tasks (no LLM). AI Suggest is a SEPARATE
				affordance that calls the configured GoAI client. Durable Workflow
				shows the DagNats event-sourced pipeline. -->
				<div class="card bg-base-100 shadow-sm border border-base-200 transition-all hover:shadow-md duration-300 overflow-visible">
					<div class="card-body p-4">
						<div class="tabs tabs-box w-full mt-0 mb-2" role="tablist">
							<button
								class="tab tab-sm flex-1 transition-all"
								data-cuelume-hover="tick"
								data-cuelume-press="toggle"
								data-on:click="$sidebarTab = 'queue'"
								data-class={ "{'tab-active': $sidebarTab === 'queue'}" }
							>
								Queue + Retry
							</button>
							if (signals.LLMEnabled || signals.SimulatedLLM) && !signals.IsViewer {
								<button
									class="tab tab-sm flex-1 transition-all"
									data-cuelume-hover="tick"
									data-cuelume-press="toggle"
									data-on:click="$sidebarTab = 'ai'"
									data-class={ "{'tab-active': $sidebarTab === 'ai'}" }
								>
									AI Suggest
								</button>
							}
							if signals.DagNatsEnabled {
								<button
									class="tab tab-sm flex-1 transition-all"
									data-cuelume-hover="tick"
									data-cuelume-press="toggle"
									data-on:click="$sidebarTab = 'workflow'"
									data-class={ "{'tab-active': $sidebarTab === 'workflow'}" }
								>
									Durable Workflow
								</button>
							}
						</div>

						</div>
						<!-- ════════ Queue + Retry tab (hard-coded tasks, no LLM) ════════ -->
						<div class="p-4" data-show="$sidebarTab === 'queue'">
							<div class="flex items-center justify-between mb-2">
								<div class="flex items-center gap-2">
									<div class="w-7 h-7 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center shrink-0">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
											<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
										</svg>
									</div>
									<span class="text-xs font-semibold">Queue + Retry</span>
								</div>
								<div class="flex gap-1">
									<span class="badge badge-xs badge-secondary">goqite</span>
									<span class="badge badge-xs badge-ghost">retry-go</span>
								</div>
							</div>

							<div class="text-xs text-base-content/60 mb-3">
								Enqueues a hard-coded background job that fails twice then
								succeeds — exercising the queue + retry layer end-to-end
								(no LLM involved).
							</div>

@ui.StepList(queueSteps())

															<form
									data-on:submit__prevent="$techStep = 'retry-demo'; $demoStep = 1; $suggestPending = true; @post('/api/todos/retry-demo?clientID=' + encodeURIComponent($clientID || ''))"
									class="contents"
								>
<button
								class="btn btn-secondary btn-sm w-full transition-all duration-200 hover:scale-[1.02] active:scale-98"
								type="submit"
								title="Enqueue a hard-coded job (goqite) that runs through retry-go: failure → retry → success">
								<span class="inline-flex items-center gap-2">
									<span data-show="!$suggestPending">Run queue + retry demo</span>
									<span data-show="$suggestPending" class="inline-flex items-center gap-1.5">
										<span class="loading loading-spinner loading-xs"></span>
										<span>Running demo…</span>
									</span>
								</span>
							</button>
								</form>

							<div
								class="mt-2 flex items-center gap-1.5 text-xs text-success transition-all duration-500"
								data-show="$aiStep >= 3 && !$aiPending && $aiPhase !== 'error'"
								data-init__delay.4s="$aiStep = 0"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
								</svg>
								<span>Demo completed</span>
							</div>
						</div>

						<!-- ════════ AI Suggest tab (separate affordance, calls the configured LLM) ════════ -->
						if (signals.LLMEnabled || signals.SimulatedLLM) && !signals.IsViewer {
							<div class="p-4" data-show="$sidebarTab === 'ai'">
								<div class="flex items-center justify-between mb-2">
									<div class="flex items-center gap-2">
										<div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
												<path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
											</svg>
										</div>
										<span class="text-xs font-semibold">AI Suggest</span>
									</div>
									<span class="badge badge-xs badge-primary">GoAI</span>
								</div>

								<div class="text-xs text-base-content/60 mb-3">
									Asks the configured LLM for 3 todo
									suggestions. The request is queued (goqite) and retried
									(retry-go) like any slow, failure-prone call.
									Need cards, tables and charts instead of titles?
									<a href="/genui" class="link link-primary">Try Ask AI</a>.
								</div>

@ui.StepList(aiSteps())

								<button
									class="btn btn-primary btn-sm w-full transition-all duration-200 hover:scale-[1.02] active:scale-98"
									data-on:click="$aiStep = 1; $aiPending = true; @post('/api/todos/suggest?clientID=' + encodeURIComponent($clientID || '') + '&partial=' + encodeURIComponent($newTitle))"
									title="Ask the configured LLM for 3 todo suggestions via goqite + retry-go">
									<span class="inline-flex items-center gap-2">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
											<path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
										</svg>
										<span data-show="!$aiPending">AI Suggest</span>
										<span data-show="$aiPending" class="inline-flex items-center gap-1.5">
													<span class="loading loading-spinner loading-xs"></span>
													<span>Asking AI…</span>
										</span>
									</span>
								</button>

								<div
									class="mt-2 flex items-center gap-1.5 text-xs text-success transition-all duration-500"
									data-show="$aiStep >= 3 && !$aiPending && $aiPhase !== 'error'"
									data-init__delay.4s="$aiStep = 0"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
									</svg>
									<span>Suggestions ready</span>
								</div>
							</div>
						}

							</div>
						<!-- ════════ Durable Workflow tab ════════ -->
						if signals.DagNatsEnabled {
							<div class="p-4" data-show="$sidebarTab === 'workflow'">
								<div class="flex items-center justify-between mb-2">
									<div class="flex items-center gap-2">
										<div class="w-7 h-7 rounded-lg bg-accent/10 text-accent flex items-center justify-center shrink-0">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
													<path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
													<path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
												</svg>
											</div>
											<span class="text-xs font-semibold">Durable Workflow</span>
										</div>
										<span class="badge badge-xs badge-accent">DagNats</span>
									</div>

@ui.StepList(workflowSteps())

									<div
										class="mb-3 p-2 rounded-lg bg-accent/10 text-accent text-xs flex items-center gap-2 transition-all duration-500 animate-in fade-in"
										data-show="$onboardingActive && !$workflowCompleted && $onboardingStep === 2"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
											<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-2a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
										</svg>
										<span>Waiting for your next to-do. Add any task above to continue the workflow.</span>
									</div>

									<!-- trim:dagnats removes this entry button (the sole /api/onboarding ref; the gated panel/tab around it stay, mirroring runtime-disabled) -->
									<button
										class="btn btn-accent btn-sm w-full transition-all duration-200 hover:scale-[1.02] active:scale-98"
										data-attr:disabled="!!($onboardingActive && !$workflowCompleted)"
										data-on:click="$sidebarTab = 'workflow'; $techStep = 'workflow'; $onboardingActive = true; $workflowCompleted = false; @post('/api/onboarding/start?clientID=' + encodeURIComponent($clientID || ''))">
										<span class="inline-flex items-center gap-2">
											<span data-show="!$onboardingActive || $workflowCompleted">
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 inline -mt-0.5 mr-1" viewBox="0 0 20 20" fill="currentColor">
													<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l3-2z" clip-rule="evenodd"/>
												</svg>
												Run durable workflow
											</span>
											<span data-show="$onboardingActive && !$workflowCompleted" class="inline-flex items-center gap-1.5">
												<span class="loading loading-spinner loading-xs"></span>
												<span data-text="'Running ' + ($onboardingStep || 1) + '/' + ($onboardingTotal || 6) + '…'"></span>
											</span>
										</span>
									</button>

									if signals.OnboardingActive && signals.WorkflowCompleted {
										<div class="mt-2 flex items-center gap-1.5 text-xs text-success transition-all duration-500 animate-in fade-in slide-in-from-bottom-1">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
												<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
											</svg>
											<span>Workflow completed — 3 example todos created via DagNats.</span>
										</div>
									}
								</div>
							}
</div><!-- /right sidebar -->
			</div><!-- /grid -->

			@deleteConfirmModal()
		</div>

		<div class="toast toast-end" id="retry-toast" data-show="$loading"></div>
	</div>
}

// createForm owns the title input + Add button. The submit
// handler uses `data-on:submit__prevent` to stop the browser from also
// performing a native GET submit (which previously created extra rows
// for every create). Buttons disable themselves via Datastar signals so
// the user can't double-fire.
templ createForm(signals todo.Signals) {
	<form
		class="w-full mb-4"
		data-on:submit__prevent="if (!$loading) { $loading = true; var id = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : 'id-' + Date.now() + '-' + Math.random().toString(36).slice(2); var sent = $newTitle; @post('/api/todos?clientID=' + encodeURIComponent($clientID || '') + '&filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all') + '&idem_key=' + encodeURIComponent(id), {contentType: 'form'}).then(() => { if ($newTitle === sent) $newTitle = ''; }).catch(() => { $loading = false; }); }" data-on:datastar-fetch="evt.detail.type === 'error' || evt.detail.type === 'retries-failed' ? ($loading = false) : null"
	>
		<div class="join w-full">
		<input
			type="text"
			name="title"
			class="input join-item flex-1 input-sm sm:input-md"
			placeholder="Add a new todo..."
			data-bind="newTitle"
		/>
		<button
			type="submit"
			class="btn btn-primary join-item btn-sm sm:btn-md"
			data-attr:disabled="!!($loading || !$newTitle.trim())">
			<span class="inline-flex items-center gap-2">
				<span class="hidden sm:inline">Add</span>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:hidden" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/>
				</svg>
				<span class="loading loading-spinner loading-xs" data-show="$loading"></span>
			</span>
		</button>
		</div>
		<label class="flex items-center gap-2 mt-2 text-xs text-base-content/60 cursor-pointer">
			<input type="checkbox" name="visibility" value="public" class="checkbox checkbox-xs checkbox-info"/>
			<span>Shared — every login sees this todo (private by default)</span>
		</label>
	</form>
}

// searchBox is the plugin's UI half: it exists only when a layer is wired
// (signals.SearchEnabled). Typing re-fetches through `/api/todos/search` with
// a 300ms debounce, and that handler patches the same `#todo-list` region the
// filter tabs do — so the ranking shows up as the row order, with no results
// panel to keep in sync and no client-side list to hydrate.
//
// The input OWNS `$searchQuery` (data-bind): it is the source of truth while
// the user types, and the server never writes it — a re-list cannot clobber
// the box (docs/realtime-recipe.md). The one seed is on first render:
// `value={ signals.SearchQuery }` sets the initial text, and bind.ts creates
// the signal from it ({ifMissing: true}). `?q=` therefore reaches the box
// without the server ever touching a client-owned signal.
templ searchBox(signals todo.Signals) {
	if signals.SearchEnabled {
		<div class="join w-full mb-3">
			<span class="join-item btn btn-ghost btn-sm sm:btn-md no-animation pointer-events-none" aria-hidden="true">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-60" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
				</svg>
			</span>
			<input
				type="search"
				name="q"
				class="input join-item flex-1 input-sm sm:input-md"
				placeholder="Search todos..."
				aria-label="Search todos"
				value={ signals.SearchQuery }
				data-bind="searchQuery"
				data-on:input__debounce.300ms="$loading = true; @get('/api/todos/search?q=' + encodeURIComponent($searchQuery || '') + '&filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all') + '&mode=' + encodeURIComponent(searchModeValue()) + '&clientID=' + encodeURIComponent($clientID || ''))"
			/>
			<button
				type="button"
				class="join-item btn btn-ghost btn-sm sm:btn-md"
				aria-label="Clear search"
				data-show="$searchQuery"
				data-on:click="$searchQuery = ''; $loading = true; @get('/api/todos?filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all') + '&clientID=' + encodeURIComponent($clientID || ''))">✕</button>
		</div>
		@searchModeSelect(signals)
	}
}

// searchModeSelect renders the layer picker (substring / fuzzy / bm25) when the
// operator wired more than one.
//
// WHY a select and not tabs: the three layers are the SAME results ranked
// differently, not different views of the data — a segmented control would
// imply content changes. A compact select says "how should this be matched".
//
// It is a real <form>-less control wired through @get (the same mechanism the
// box uses) rather than a data-bind signal, because the ACTIVE mode is a
// server decision: the server falls back when a layer is unwired, so it is the
// authority on what is actually in effect (`searchMode` signal) while the
// select just requests a change. Rendering it from signals.SearchModes is what
// keeps the options in step with what boot actually built — no hardcoded list.
//
// Hidden entirely with one wired layer: a picker with a single option is noise,
// and the substring-only build (the trimmed/plugin-free case) must look exactly
// as it did before.
templ searchModeSelect(signals todo.Signals) {
	if len(signals.SearchModes) > 1 {
		<label class="flex items-center gap-2 mb-3 text-xs text-base-content/60">
			<span>Match</span>
			<select
				name="mode"
				class="select select-xs sm:select-sm"
				aria-label="Search matching mode"
				data-on:change="$loading = true; @get('/api/todos/search?q=' + encodeURIComponent($searchQuery || '') + '&filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all') + '&mode=' + encodeURIComponent(searchModeValue()) + '&clientID=' + encodeURIComponent($clientID || ''))"
			>
				for _, m := range signals.SearchModes {
					<option value={ m } selected?={ m == signals.SearchMode }>{ searchModeLabel(m) }</option>
				}
			</select>
			<span class="opacity-70">{ searchModeHint(signals.SearchMode) }</span>
		</label>
	}
}

// searchModeLabel names a layer in the user's words. Unknown names fall through
// as-is rather than being hidden: a fourth layer added to the plugin should
// appear in the picker immediately, even before it gets a friendly label.
func searchModeLabel(mode string) string {
	switch mode {
	case "substring":
		return "exact"
	case "fuzzy":
		return "typo-tolerant"
	case "bm25":
		return "relevance"
	default:
		return mode
	}
}

// searchModeHint says what the selected layer does, so the choice is not a
// guess. Kept to one short clause per mode.
func searchModeHint(mode string) string {
	switch mode {
	case "substring":
		return "matches the letters you type"
	case "fuzzy":
		return "tolerates typos and partial words"
	case "bm25":
		return "ranks by relevance, best first"
	default:
		return ""
	}
}

// scopeTabs renders the listing slice (All / Mine / Shared). Like the
// status tabs, clicks re-fetch with the other dimension preserved, and the
// active state reads from the `$scope` signal so SSE patches stay in sync.
// TodoListRegion renders just the list rows + empty state. Patched by
// every mutation (local and broadcaster) so both the originating tab
// and remote tabs stay in sync. The `<div id="todo-list">` selector is
// the merge target for RenderAndPatch.
templ TodoListRegion(signals todo.Signals) {
	<div class="divide-y divide-base-200" id="todo-list">
		if len(signals.Todos) == 0 {
			<div class="py-8 text-center text-base-content/40" id="todo-empty-state">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
				</svg>
				<p>No todos here yet.</p>
				if signals.DagNatsEnabled {
					<p class="text-xs mt-1">Add one above to get started, or click "Run durable workflow" in the sidebar to auto-create examples.</p>
				}
			</div>
		}
		for _, item := range signals.Todos {
			@TodoItem(item)
		}
	</div>
}

// SuggestionsList renders the AI-suggested completions as clickable
// buttons. Clicking a suggestion fills the newTitle signal so the
// user can review and submit. It carries id="suggestions-region" so the
// SSE dispatcher can re-render it with PatchElements when $suggestions
// arrives (a bare MergeSignals would only toggle visibility, never
// populate the buttons). The container is always present; visibility is
// driven by $suggestions being non-empty.
templ SuggestionsList(suggestions []string) {
	<div
		class="mb-4 p-3 bg-base-200/40 rounded-lg transition-all duration-500 animate-in fade-in slide-in-from-top-2"
		id="suggestions-region"
		data-show="$suggestions && $suggestions.length > 0"
	>
		<div class="text-xs text-base-content/50 mb-2">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 inline -mt-0.5 mr-1 text-secondary" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
			</svg>
			Suggestions — click to use:
		</div>
		<div class="flex flex-wrap gap-2">
			for _, s := range suggestions {
				<button
					type="button"
					class="btn btn-xs btn-outline btn-secondary transition-all hover:scale-105 active:scale-95 animate-in fade-in slide-in-from-bottom-1"
					style="animation-delay: 0.05s"
					data-on:click={ "$newTitle = " + safeJSString(s) }>
					{ s }
				</button>
			}
		</div>
		<script>
			// Plain script on purpose (see DocVersionWatcher): data-effect
			// evaluates at Datastar init, before deferred modules load.
			window.__gogogoSuggestScroll = function (list) {
				var n = list ? list.length : 0;
				if (window.__gogogoSuggestSeen === undefined) {
					window.__gogogoSuggestSeen = n;
					return;
				}
				if (n > window.__gogogoSuggestSeen) {
					window.__gogogoSuggestSeen = n;
					var el = document.getElementById("suggestions-region");
					if (el) { el.scrollIntoView({block: "nearest"}); }
				} else {
					window.__gogogoSuggestSeen = n;
				}
			};
		</script>
		<div data-effect="window.__gogogoSuggestScroll($suggestions)" hidden aria-hidden="true"></div>
	</div>
}

// safeJSString returns s as a JSON string literal with surrounding
// double quotes, suitable for embedding inside a Datastar
// data-on:click expression. We use strconv.Quote so Go's standard
// escaping handles control characters and quotes consistently.
func safeJSString(s string) string {
	return strconv.Quote(s)
}

// deleteConfirmModal renders the single DaisyUI dialog used for every
// delete confirmation. Driven by the $confirmingDeleteId signal: when
// it's non-empty, the modal opens and the user picks Cancel or
// Confirm. Confirm fires `@post('/api/todos/<id>/delete')` and the
// broadcaster patches every client. Single modal instance handles
// every row — far simpler than per-row dialogs.
templ deleteConfirmModal() {
	<dialog id="confirm-delete-modal" class="modal" data-on:close="$confirmingDeleteId = ''; $confirmingDeleteTitle = ''; $deleting = false">
		<div class="modal-box">
			<h3 class="font-bold text-lg text-error flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
				</svg>
				Delete this todo?
			</h3>
			<p class="py-4 text-sm">
				This will permanently remove <span class="font-semibold" data-text="$confirmingDeleteTitle"></span>.
				This can't be undone.
			</p>
			<div class="modal-action">
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					data-on:click="document.getElementById('confirm-delete-modal').close()">
					Cancel
				</button>
				<button
					type="button"
					class="btn btn-error btn-sm transition-all"
					data-cuelume-press="droplet"
					data-attr:disabled="!!$deleting"
					data-on:click="$deleting = true; document.getElementById('confirm-delete-modal').close(); @post('/api/todos/' + $confirmingDeleteId + '/delete?clientID=' + encodeURIComponent($clientID || '') + '&filter=' + encodeURIComponent($filter || 'all') + '&scope=' + encodeURIComponent($scope || 'all'))">
					<span class="inline-flex items-center gap-2">
						<span>Delete</span>
						<span class="loading loading-spinner loading-xs" data-show="$deleting"></span>
					</span>
				</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button data-on:click="document.getElementById('confirm-delete-modal').close()">close</button>
		</form>
	</dialog>
}

// createdFilter is the date-picker gap filled with Cally (DaisyUI styles the
// web component). The filter is display-only: each row carries data-created,
// and data-show compares it with the $createdAfter signal. No request, no
// server round trip, and the filter survives list patches because the box
// owns the signal.
// createdFilter uses the native Popover API (popovertarget + popover) rather
// than a Datastar signal: nothing reacts to its open state, and the browser
// supplies light dismiss, Escape and top-layer stacking with no listener or
// extra state. To react to open/close later, switch to a signal + __outside:
//
//   <div data-signals='{"dateOpen":false}' data-on:click__outside="$dateOpen = false">
//     <button data-on:click="$dateOpen = !$dateOpen">…</button>
//     <div data-show="$dateOpen">…</div>
//   </div>
//
// A <details> with data-on:click__outside also works; the element is not the
// issue, and native stays the default while open state has no consumer.
templ createdFilter() {
	<div class="flex items-center gap-2 mb-3">
		<button
			type="button"
			id="created-filter-btn"
			popovertarget="created-filter-popover"
			class="btn btn-outline btn-sm gap-2"
			style="anchor-name:--created-filter"
			aria-label="Filter by creation date"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-70" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v9a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm10 6H4v7h12V8z" clip-rule="evenodd"/>
			</svg>
			<span data-text="$createdAfter === '' ? 'Any date' : 'Since ' + $createdAfter"></span>
		</button>
		<button
			type="button"
			class="btn btn-ghost btn-xs"
			data-show="$createdAfter !== ''"
			data-on:click="$createdAfter = ''; $noMatches = false"
		>clear</button>
	</div>
	<div id="created-filter-popover" popover>
		<calendar-date
			class="cally"
			data-on:change={ `$createdAfter = evt.target.value; $noMatches = false; document.getElementById('created-filter-popover').hidePopover(); setTimeout(function () { $noMatches = document.querySelectorAll(".todo-item:not([style*='display: none'])").length === 0 }, 0)` }
		>
			<svg slot="previous" aria-label="Previous month" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
			</svg>
			<svg slot="next" aria-label="Next month" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
			</svg>
			<calendar-month></calendar-month>
		</calendar-date>
	</div>
}
