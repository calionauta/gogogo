// SCOPE:plugin — Ask AI's machinery, shown only in demo mode.
//
// The page is a prompt and an answer region. What it demonstrates is that the
// model never emits free HTML here: it picks from a fixed catalog, and the
// answer streams in. States come from the page's own signals.
package components

import (
	"github.com/calionauta/gogogo/internal/ui"
)

// GenuiStatePanel renders the answer pipeline and the catalog facts.
templ GenuiStatePanel() {
	<div class="app-state-panel-inner space-y-3">
		<p class="text-xs text-base-content/60">
			The model answers with components, not markup: it may only choose names
			from the catalog below, and the server renders them. Anything outside the
			catalog is dropped before it reaches the browser.
		</p>
		@ui.StepList([]ui.Step{
			{Label: "Prompt accepted", Done: "!$genui_pending", Active: "$genui_pending"},
			{Label: "Model picks catalog components", Active: "$genui_pending"},
			{Label: "Rendered and streamed", Done: "!$genui_pending && $genui_error === ''"},
		})
		<ul class="text-xs text-base-content/70 space-y-1">
			<li>Catalog: <span class="font-mono">fixed, server-validated</span></li>
			<li>Transport: <span class="font-mono">SSE</span></li>
			<li>Failure: <span class="font-mono">renders the error, not a blank</span></li>
		</ul>
	</div>
}
