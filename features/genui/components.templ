// SCOPE:layer=feature,removal=feature — gogen-ui Ask demo templates.
package genui

import (
	"github.com/calionauta/gogogo/features/auth"
	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/internal/components"
)

// GenuiIndex renders the Ask demo page: one question form, one live
// result region fed by the model through the catalog. Work pattern is
// Decide (focused hero: ask → shaped answer), so the composition is a
// single column: form first, result below — no dashboard density.
templ GenuiIndex(email string, buildLabel string, buildCommit string) {
	<!DOCTYPE html>
	<html lang="en" data-signals="{theme: 'light', genui_pending: false, genui_error: ''}" data-attr:data-theme="$theme" data-class:dark="$theme === 'dark'">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Ask AI — gogogo</title>
			<link rel="stylesheet" href="/static/app.min.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			@auth.ThemeHead()
			<script defer type="module" src="/static/theme.js"></script>
			@sounds.SoundAssets()
			<script src="/static/iconify-icon.min.js"></script>
			<script defer type="module" src="/static/datastar.js"></script>
			@components.OfflineSyncScript(true)
		</head>
		<body>
			@auth.Navbar(email, "genui", buildLabel, buildCommit)
			@components.OfflineBanner(true)
			<main class="container mx-auto p-4 max-w-2xl">
				<h1 class="text-2xl font-bold">Ask AI</h1>
				<p class="text-sm text-base-content/60 mt-1 mb-4">
					The model answers with interface, not just text: it picks
					components from a fixed catalog and this page renders them.
				</p>
				@components.TechBadge([]string{"component catalog", "SSE morphs", "goqite jobs", "GoAI"})
				<!-- Network-failure release: the spinner is server-owned (the
				     worker result clears it), so a dead @post with all
				     retries failed would lock Ask until reload. datastar-fetch
				     error stages reset it client-side; the event fires for
				     this form's own request. -->
				<form
					id="genui-ask-form"
					data-on:submit__prevent={ "@post('/api/genui/ask?clientID=' + encodeURIComponent(window.__gogogoClientID || ''), {contentType: 'form'})" }
					data-on:datastar-fetch="evt.detail.type === 'error' || evt.detail.type === 'retries-failed' ? ($genui_pending = false, $genui_error = 'Request failed — check your connection and try again.') : null"
				>
					<label for="genui-prompt" class="form-control w-full">
						<span class="label-text mb-1">What should the assistant shape for you?</span>
						<input
							id="genui-prompt"
							name="prompt"
							type="text"
							required
							minlength="3"
							maxlength="500"
							autocomplete="off"
							placeholder="Plan my day from my todos"
							class="input input-bordered w-full"
						/>
					</label>
					<div class="mt-3 flex items-center gap-3">
						<button
							type="submit"
						 class="btn btn-primary"
							data-attr:disabled="$genui_pending"
						>
							<span data-show="!$genui_pending">Ask</span>
							<span data-show="$genui_pending" class="loading loading-spinner loading-sm" aria-hidden="true"></span>
							<span data-show="$genui_pending">Thinking…</span>
						</button>
						<p class="text-xs text-base-content/50" data-show="$genui_pending" role="status">Streaming the answer below.</p>
					</div>
				</form>
				<h2 class="text-lg font-semibold mt-8 mb-2">Answer</h2>
				@GenuiResult(nil, "", false)
			</main>
			@StreamOpener("/api/genui/stream")
		</body>
	</html>
}

// StreamOpener holds the result SSE stream open for this tab. Same
// hidden-@get-button mechanism as the todo RealtimeStream (Datastar v1
// never fires data-on:load on body), scoped to this feature so todo can
// be trimmed without taking the Ask page down with it.
templ StreamOpener(streamURL string) {
	<button
		id="genui-stream-opener"
		class="hidden"
		data-on:click={ "@get('" + streamURL + "?clientID=' + encodeURIComponent(window.__gogogoClientID || '') + '', { permanent: true })" }
		aria-hidden="true"
	></button>
	<script type="module">
		(function () {
			try {
				var id = sessionStorage.getItem('gogogo_client_id');
				if (!id) {
					id = 'tab-' + Math.random().toString(36).slice(2, 10);
					sessionStorage.setItem('gogogo_client_id', id);
				}
				window.__gogogoClientID = id;
			} catch (e) {
				window.__gogogoClientID = 'tab-' + Math.random().toString(36).slice(2, 10);
			}
			function openSSE() {
				var b = document.getElementById('genui-stream-opener');
				if (b && !b.dataset.opened) { b.dataset.opened = '1'; b.click(); }
			}
			document.addEventListener('datastar-ready', openSSE);
			setTimeout(openSSE, 300);
		})();
	</script>
}

// GenuiResult renders the model answer region in its three states:
// empty (guidance, never blank space), error (message + recovery,
// role=alert so assistive tech announces it), full (the components).
// The worker patches this whole region on every answer, so error and
// success never leave stale siblings behind.
templ GenuiResult(comps []templ.Component, errMsg string, isError bool) {
	<div
		id="genui-result"
		class="mt-2 min-h-24 rounded-lg border border-base-300 bg-base-100 p-4"
		aria-live="polite"
	>
		if isError {
			<div class="alert alert-error" role="alert">
				<span>{ errMsg }</span>
			</div>
			<p class="text-sm text-base-content/60 mt-2">Try asking again — the form above kept your question.</p>
		} else if len(comps) == 0 {
			<h3 class="font-semibold">Ask anything</h3>
			<p class="text-sm text-base-content/60 mt-1">
				For example: “plan my day”, “summarize my week in a table”,
				“turn my notes into actions”. The answer renders here as cards and tables.
			</p>
		} else {
			for _, comp := range comps {
				<div class="mb-4 last:mb-0">
					@comp
				</div>
			}
		}
	</div>
}

// GenuiSection groups nested components under a titled section, so
// answers read as documents (week plan holding its table) instead of
// flat stacks. One nesting primitive beats per-case layouts: the model
// composes from the same catalog, never invents structure.
templ GenuiSection(title string, children []templ.Component) {
	<section class="rounded-lg border border-base-300 bg-base-100">
		<h3 class="font-semibold px-4 pt-3">{ title }</h3>
		<div class="p-4 pt-2 flex flex-col gap-3">
			for _, child := range children {
				@child
			}
		</div>
	</section>
}

// GenuiBarChart renders a pure-CSS bar chart: zero JS, zero chart
// library, fully server-rendered and morphable. Values print as text
// next to every bar, so nothing is conveyed by color alone (and
// DaisyUI theme tokens keep both modes legible).
templ GenuiBarChart(title string, bars []Bar, peak float64) {
	<div>
		<h3 class="font-semibold mb-2">{ title }</h3>
		<ul class="flex flex-col gap-2">
			for i, bar := range bars {
				<li>
					<div class="flex justify-between text-sm mb-1">
						<span>{ bar.Label }</span>
						<span class="text-base-content/60">{ barValue(bar.Value) }</span>
					</div>
					<div class="h-3 rounded bg-base-300 overflow-hidden" role="img" aria-label={ bar.Label + ": " + barValue(bar.Value) }>
						<div
							class={ "h-full rounded " + barClass(i) }
							style={ "width: " + barWidth(bar.Value, peak) }
						></div>
					</div>
				</li>
			}
		</ul>
	</div>
}

// GenuiActionButtons renders one form per action: each button posts its
// fields to a same-origin URL (validated server-side in checkAction).
// Per-button forms beat one shared form — the fields travel with the
// action they belong to, and each posts independently.
templ GenuiActionButtons(actions []Action) {
	<div class="flex flex-wrap gap-2">
		for _, action := range actions {
			<form data-on:submit__prevent={ "@" + actionVerb(action.Method) + "('" + action.URL + "', {contentType: 'form'})" }>
				for key, val := range action.Fields {
					<input type="hidden" name={ key } value={ val }/>
				}
				<button type="submit" class="btn btn-sm btn-primary">{ action.Label }</button>
			</form>
		}
	</div>
}

// GenuiTextNote renders a single prose card.
templ GenuiTextNote(text string) {
	<div class="card bg-base-200/40">
		<div class="card-body p-4">
			<h3 class="card-title text-base">Note</h3>
			<p class="text-sm">{ text }</p>
		</div>
	</div>
}

// GenuiPlanCards renders one plan per card, each with its own apply
// button (per-card actions beat one shared button: the choice stays
// next to the option it acts on).
templ GenuiPlanCards(plans []Plan) {
	<div>
		<h3 class="font-semibold mb-2">Plans</h3>
		<ul class="flex flex-col gap-2">
			for _, plan := range plans {
				<li class="card bg-base-200/40">
					<div class="card-body p-4">
						<h3 class="card-title text-base">{ plan.Title }</h3>
						if plan.Detail != "" {
							<p class="text-sm text-base-content/70">{ plan.Detail }</p>
						}
						<div class="card-actions justify-end mt-2">
							<form data-on:submit__prevent={ "@post('/api/todos?clientID=' + encodeURIComponent(window.__gogogoClientID || ''), {contentType: 'form'})" }>
								<input type="hidden" name="title" value={ plan.Title }/>
								<button type="submit" class="btn btn-sm btn-primary">Apply</button>
							</form>
						</div>
					</div>
				</li>
			}
		</ul>
	</div>
}

// GenuiDataTable renders a small read-only table. Horizontally scrolls
// instead of squeezing (no 200%-zoom truncation), headers are real th
// elements with scope so screen readers announce them.
templ GenuiDataTable(headers []string, rows [][]string) {
	<div>
		<h3 class="font-semibold mb-2">Table</h3>
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						for _, h := range headers {
							<th scope="col">{ h }</th>
						}
					</tr>
				</thead>
				<tbody>
					for _, row := range rows {
						<tr>
							for _, cell := range row {
								<td>{ cell }</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
