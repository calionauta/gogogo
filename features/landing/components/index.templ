// SCOPE:feature - REMOVE by deleting features/landing/ (components move with it) + the
// landing catch-all root in buildChiMux (internal/server/chi.go). The landing page is a marketing
// shell: logo + about text + "Access demo site" CTA. It does NOT
// call the database, does NOT authenticate the user (guests and
// signed-in users see the same hero), and registers only the
// GET / route.
//
// Content policy: the about text is sourced from the project's
// own README so the page mirrors the repo, not an LLM summary.
// Source lines (README.md): the tagline block (~7-9) carries the
// project positioning; the rest of the README is not surfaced.
package components

import (
	"github.com/calionauta/gogogo/features/authviews"
	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/internal/components"
	"github.com/calionauta/gogogo/web/resources"
)

// Index renders the landing page. userEmail is empty for guests
// (Sign in CTA shows) and the authed email for signed-in users.
// buildLabel/buildCommit are surfaced on the version badge so the
// landing page matches the shell's build feedback.
//
// ctaHref keeps guests off the RBAC 403: anonymous GET /todo is denied by
// policy (fail-closed, RBAC_ENABLED=true in production), so guests go to
// /login?next=/todo and land on /todo after sign-in; signed-in users go
// straight to /todo.
func ctaHref(userEmail string) string {
	if userEmail == "" {
		return "/login?next=/todo"
	}
	return "/todo"
}

templ Index(userEmail string, userRole string, buildLabel string, buildCommit string) {
	<!DOCTYPE html>
	<html lang="en" { authviews.ThemeRootAttrs(ctx, "")... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>gogogo</title>
			@components.Assets()
			@authviews.ThemeHead()
			@sounds.SoundAssets()
			<style>
				/* Hero layout: narrow column on desktop, full width on
				   mobile. The visual hierarchy is logo → about → CTA,
				   matching the README ordering. */
				.landing-hero {
					min-height: calc(100vh - 4rem);
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					padding: 2rem 1rem;
				}
				.landing-card {
					max-width: 44rem;
					width: 100%;
				}
				.landing-logo {
					max-width: 28rem;
					width: 100%;
					height: auto;
					margin-left: auto;
					margin-right: auto;
					display: block;
				}
				.landing-about {
					color: var(--color-base-content);
					line-height: 1.7;
					font-size: 0.95rem;
				}
			</style>
		</head>
		<body class="bg-base-100 min-h-screen">
			<!-- The landing is a Decide surface, outside internal/ui.Shell: it
			     carries a public header (brand, build badge, palette, account)
			     instead of the module navigation, which belongs to the app. -->
			<header class="app-nav">
				<div class="app-nav-start">
					<a href="/" class="app-nav-brand">gogogo</a>
					<span class="app-nav-badge" title={ buildCommit + " · built " + buildLabel }>{ buildLabel }</span>
				</div>
				<div class="app-nav-end">
					@authviews.CommandPalette(userRole, userEmail == "")
					@authviews.ThemeToggle()
					@sounds.SoundToggle()
					@authviews.UserMenu(userEmail, userRole, nil)
				</div>
			</header>
			<main class="landing-hero">
				<div class="landing-card">
					<header class="text-center mb-6">
						<img class="landing-logo" src={ resources.StaticURL("logo.png") } alt="gogogo"/>
					</header>
					<section class="landing-about mb-8">
						<p>
							Go full-stack template. Single binary, no dependencies.
							Database &amp; Auth. Reactive UI. Background jobs.
							Offline-first. Real-time multi-user. Durable workflows.
							Desktop &amp; Android capable.
						</p>
					</section>
					<div class="text-center">
						<a href={ ctaHref(userEmail) } class="btn btn-primary">
							Access demo site
						</a>
						if userEmail == "" {
							<p class="text-sm text-base-content/60 mt-3">
								You'll be asked to sign in with the demo credentials.
							</p>
						}
					</div>
				</div>
			</main>
			@components.OfflineBanner(true)
		</body>
	</html>
}
