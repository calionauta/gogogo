package notes

import "strconv"

import "github.com/calionauta/gogogo/features/auth"
import "github.com/calionauta/gogogo/features/sounds"

// NotesIndex lists existing shared notes with a button to start a new one.
templ NotesIndex(email string, docIDs []string, buildLabel string, buildCommit string) {
	<!DOCTYPE html>
	<html lang="en" data-signals="{theme: 'light'}" data-attr:data-theme="$theme" data-class:dark="$theme === 'dark'">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Notes — gogogo</title>
			<link rel="stylesheet" href="/static/app.min.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			@auth.ThemeHead()
			<script defer type="module" src="/static/theme.js"></script>
			<script src="/static/iconify-icon.min.js"></script>
			<script defer type="module" src="/static/datastar.js"></script>
		</head>
		<body>
			@auth.Navbar(email, "notes", buildLabel, buildCommit)
			<main class="p-4 max-w-2xl mx-auto">
				<div class="flex items-center justify-between mb-4">
					<h1 class="text-2xl font-bold">Shared notes</h1>
					<a class="btn btn-sm btn-primary" href="/notes/new">New note</a>
				</div>
				@NotesListFragment(docIDs)
			</main>
			<button
				id="notes-realtime-resync"
				type="button"
				class="hidden"
				data-on:click={ "@get('/api/notes/fragment')" }
				aria-hidden="true"
			></button>
			<script type="module">
				// Live list: PocketBase realtime on the notes collection,
				// re-fetching the fragment — same pattern as the whiteboard
				// list. Concatenation (no template literals): datastar-lint
				// rejects templ-expression-looking braces in script bodies.
				var clientID = "notes-" + Math.random().toString(36).slice(2, 10);
				var es = new EventSource("/api/realtime?clientId=" + encodeURIComponent(clientID));
				function subscribe(id) {
					fetch("/api/realtime", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ clientId: id, action: "subscribe", subscriptions: ["notes"] })
					}).catch(function () {});
				}
				function resync() {
					var b = document.getElementById("notes-realtime-resync");
					if (b) { b.click(); }
				}
				es.addEventListener("PB_CONNECT", function (e) {
					var msg;
					try { msg = JSON.parse(e.data); } catch (_) { return; }
					if (!msg.clientId) { return; }
					es.addEventListener("notes", function () { resync(); });
					subscribe(msg.clientId);
					resync();
				});
				document.addEventListener("visibilitychange", function () {
					if (!document.hidden) { resync(); }
				});
			</script>
		</body>
	</html>
}

// NotesListFragment renders just the notes list. Target of the
// @get('/api/notes/fragment') resync above.
templ NotesListFragment(docIDs []string) {
	<div id="notes-list">
		if len(docIDs) == 0 {
			<p class="text-base-content/60">No notes yet. Start one — every keystroke merges across tabs.</p>
		} else {
			<ul class="menu bg-base-200 rounded-box w-full">
				for _, id := range docIDs {
					<li><a href={ templ.URL("/notes/" + id) }>{ id }</a></li>
				}
			</ul>
		}
	</div>
}

// NotesPage renders one shared note: a textarea bound to the server-owned
// Loro Text. Typing POSTs prefix/suffix-diffed ops; the SSE stream applies
// peers' resolved text unless the textarea is focused (no caret stealing).
templ NotesPage(email string, docID string, text string, rev uint64, buildLabel string, buildCommit string) {
	<!DOCTYPE html>
	<html lang="en" data-signals="{theme: 'light'}" data-attr:data-theme="$theme" data-class:dark="$theme === 'dark'">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Note — gogogo</title>
			<link rel="stylesheet" href="/static/app.min.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			@auth.ThemeHead()
			<script defer type="module" src="/static/theme.js"></script>
			<script defer type="module" src="/static/datastar.js"></script>
			<script src="/static/iconify-icon.min.js"></script>
			@sounds.SoundAssets()
			<script defer src="/static/throttle.js"></script>
			<script defer src="/static/notes.js"></script>
		</head>
		<body>
			@auth.Navbar(email, "notes", buildLabel, buildCommit)
			<main class="p-4 max-w-2xl mx-auto" data-doc-id={ docID } data-rev={ strconv.FormatUint(rev, 10) }>
				<h1 class="sr-only">Shared note</h1>
				<div class="flex items-center justify-between mb-2">
					<a class="btn btn-sm btn-ghost" href="/notes">Back</a>
					<span class="flex items-center gap-2">
						<span id="peer-pill" class="text-xs text-base-content/60" title="Tabs on this note" aria-live="polite">1 online</span>
						<span id="typing-pill" class="text-xs text-base-content/60 italic" title="Who is typing" aria-live="polite"></span>
						<span id="rtt-pill" class="text-xs text-base-content/40" title="Last save round-trip"></span>
						<span id="net-status" class="text-xs text-warning hidden" aria-live="polite">reconnecting…</span>
					</span>
				</div>
				<div id="session-banner" class="hidden alert alert-warning mt-2" role="alert" aria-live="polite">
					<span>Session expired — <a class="link" href="/login">sign in again</a> to keep your name on edits. Your text stays safe in this tab.</span>
				</div>
				<label class="sr-only" for="note-text">Note text</label>
				<div id="note-wrap" class="relative">
					<textarea id="note-text" class="textarea textarea-bordered w-full font-mono" rows="20" placeholder="Type — every tab merges.">{ text }</textarea>
					<div id="caret-layer" aria-hidden="true"></div>
				</div>
				<p class="text-xs text-base-content/60 mt-2">Plain text, CRDT-merged on the server. Concurrent typing never loses characters; rich text does not exist here yet.</p>
			</main>
		</body>
	</html>
}
