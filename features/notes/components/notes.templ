package components

import "strconv"

import "github.com/calionauta/gogogo/features/notes"
import "github.com/calionauta/gogogo/features/sounds"
import "github.com/calionauta/gogogo/internal/components"
import "github.com/calionauta/gogogo/internal/icon"
import "github.com/calionauta/gogogo/web/resources"
import "github.com/calionauta/gogogo/internal/ui"

// NoteMeta is one row of the shared notes index, and the identity the note
// page renders.
//
// Author/IsMine/CanDelete are stamped by the handler (single home:
// canDeleteDoc): the list is SHARED — every signed-in user sees every
// note — while the destructive act stays with the author (and an admin).
// Templates only render what the server decided, never re-derive the rule.
type NoteMeta struct {
	DocID     string
	Author    string // author email, "" when unknown
	IsMine    bool
	CanDelete bool
}

// notesDialogID / notesSignals are the notes page's delete-confirmation
// wiring. Named once because three places must agree: the row button that
// sets the signals, the dialog that reads them, and the page that seeds
// them. A typo in any one is a dialog that never opens.
const (
	notesDialogID = "confirm-delete-note"
	notesSignals  = `{"confirmNoteId":"","confirmNoteAuthor":"","deletingNote":false}`
)

// NotesIndex lists every shared note with a button to start a new one.
// NotesIndex renders the shared-notes list. The document, assets, sidebar,
// header and toasts belong to internal/ui.Shell; this file is the page.
//
// The "New note" action moved into the shell header's actions slot, and the
// stack pills into the sidebar's stack key — the two places every module uses,
// so this page no longer carries chrome of its own.
templ NotesIndex(email string, userRole string, notes []NoteMeta, buildLabel string, buildCommit string, skinName string) {
	@ui.Shell(ui.Data{
		Title:       "Collab notes — gogogo",
		Module:      "notes",
		Context:     notesContext(notes),
		Email:       email,
		Role:        userRole,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
		Skin:        skinName,
		Signals:     notesSignals,
		Stack:       notesStack(),
		StreamPage:  true,
	}, nil, nil, notesActions(), notesBody(notes))
}

// notesActions is the header's right-aligned action.
templ notesActions() {
	<a class="app-nav-btn is-primary" href="/notes/new">New note</a>
}

// notesContext is the header's context slot.
func notesContext(notes []NoteMeta) string {
	if len(notes) == 0 {
		return "no notes yet · CRDT text · SSE"
	}
	return strconv.Itoa(len(notes)) + " notes · CRDT text · SSE"
}

// notesStack is what this page demonstrates, in the sidebar's stack key.
func notesStack() []components.TechItem {
	return []components.TechItem{
		{Name: "Loro Text", Note: "CRDT text merge across tabs"},
		{Name: "SSE Hub", Note: "doc versions stream to tabs"},
		{Name: "NATS", Note: "cross-instance sync"},
		{Name: "SSE record sync", Note: "record changes re-list live"},
	}
}

// notesBody is the work area: the sharing rule, the list, and the two live
// regions the page patches.
templ notesBody(notes []NoteMeta) {
	<div class="ui-page ui-page-narrow ui-stack">
		<p class="text-xs text-base-content/60 mb-2">
			Every note is shared: anyone signed in can open and edit it. Only its author
			(or an admin) can delete it.
		</p>
		@NotesListFragment(notes)
		@deleteNoteModal()
		@components.ListResync("notes-realtime-resync", "'/api/notes/fragment'")
	</div>
}

// NotesListFragment renders just the notes list. Target of the
// @get('/api/notes/fragment') resync and of the delete patch.
templ NotesListFragment(notes []NoteMeta) {
	<div id="notes-list">
		if len(notes) == 0 {
			<div class="ui-card">
				<div class="ui-empty">
					<p class="text-sm text-base-content/60">No notes yet. Start one — every keystroke merges across tabs.</p>
				</div>
			</div>
		} else {
			<ul class="menu bg-base-200 rounded-box w-full">
				for _, n := range notes {
					<li>
						<div class="flex items-center justify-between gap-2">
							<a href={ templ.URL("/notes/" + n.DocID) } class="flex-1">
								<span class="font-mono text-sm">{ n.DocID }</span>
								@authorBadge(n.Author, n.IsMine)
							</a>
							if n.CanDelete {
								<button
									type="button"
									class="btn btn-ghost btn-sm text-error"
									title="Delete this note"
									data-on:click__prevent={ "$confirmNoteId = " + strconv.Quote(n.DocID) + "; $confirmNoteAuthor = " + strconv.Quote(n.Author) + "; document.getElementById('" + notesDialogID + "').showModal()" }>
									@icon.Icon("material-symbols:delete-outline", "text-base")
								</button>
							}
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

// authorBadge names who started the doc; "you" replaces the email on your
// own rows so the shared list still reads at a glance.
templ authorBadge(author string, isMine bool) {
	if author != "" {
		if isMine {
			<span class="badge badge-xs badge-primary ml-2" title={ "Author: " + author }>you</span>
		} else {
			<span class="text-xs text-base-content/50 ml-2" title="Author">by { author }</span>
		}
	}
}

// deleteNoteModal is the single confirmation dialog for the list. The
// $confirmNoteId/$confirmNoteAuthor signals carry the target, so one dialog
// serves every row — the pattern the todo list also uses. The server
// answers the POST with the re-rendered list fragment, so no reload.
templ deleteNoteModal() {
	<dialog id={ notesDialogID } class="modal" data-on:close="$confirmNoteId = ''; $confirmNoteAuthor = ''; $deletingNote = false">
		<div class="modal-box">
			<h3 class="font-bold text-lg text-error">Delete this note?</h3>
			<p class="py-4 text-sm">
				This permanently removes the note and its text
				<span class="text-base-content/60" data-text="$confirmNoteAuthor ? 'started by ' + $confirmNoteAuthor : ''"></span>.
				Any other tab still holding it open loses the text on reload.
			</p>
			<div class="modal-action">
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					data-on:click={ "document.getElementById('" + notesDialogID + "').close()" }>
					Cancel
				</button>
				<button
					type="button"
					class="btn btn-error btn-sm"
					data-attr:disabled="!!$deletingNote"
					data-on:click={ "$deletingNote = true; document.getElementById('" + notesDialogID + "').close(); @post('/api/notes/' + encodeURIComponent($confirmNoteId) + '/delete')" }>
					Delete
				</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button data-on:click={ "document.getElementById('" + notesDialogID + "').close()" }>close</button>
		</form>
	</dialog>
}

// NotesPage renders one shared note: a textarea bound to the server-owned
// Loro Text. Typing POSTs prefix/suffix-diffed ops; the SSE stream applies
// peers' resolved text unless the textarea is focused (no caret stealing).
// meta carries the doc id plus who started it, so the page and the index
// read the same row instead of threading three loose strings.
// NotesPage renders one note: the CRDT textarea, the caret layer and the
// presence pills. It opts into the raw-EventSource flag (session.js) and asks
// the shell for a full-width body, because the editor is the page.
templ NotesPage(email string, userRole string, meta NoteMeta, text string, rev uint64, buildLabel string, buildCommit string, skinName string) {
	@ui.Shell(ui.Data{
		Title:       "Collab note — gogogo",
		Module:      "notes",
		Heading:     "Shared note",
		Context:     "CRDT-merged · every tab converges · SSE",
		Email:       email,
		Role:        userRole,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
		Skin:        skinName,
		StreamPage:  true,
	}, notesDocHead(), notesSound(), nil, notesDocBody(meta, text, rev))
}

// notesDocHead carries the page's own <head>: the sound assets (so the shell's
// mute control works) and the two scripts the editor needs. The installer's
// sounds trim drops the @sounds.SoundAssets() line from this file.
templ notesDocHead() {
	@sounds.SoundAssets()
	<script defer src={ resources.StaticURL("throttle.js") }></script>
	<script defer src={ notes.URL("notes.js") }></script>
}

// notesSound is the shell's mute control; the trim drops the call inside it.
templ notesSound() {
	@sounds.SoundToggle()
}

// notesDocBody is the editor. data-doc-id / data-rev live on this wrapper
// (notes.js reads [data-doc-id], not <main>, so the shell can own the main
// element).
templ notesDocBody(meta NoteMeta, text string, rev uint64) {
	<div class="mx-auto max-w-2xl" data-doc-id={ meta.DocID } data-rev={ strconv.FormatUint(rev, 10) }>

				<h1 class="sr-only">Shared note</h1>
				<div class="flex items-center justify-between mb-2">
					<a class="btn btn-sm btn-ghost" href="/notes">Back</a>
					<span class="flex items-center gap-2">
						@authorBadge(meta.Author, meta.IsMine)
						<span id="peer-pill" class="text-xs text-base-content/60" title="Tabs on this note" aria-live="polite">1 online</span>
						<span id="typing-pill" class="text-xs text-base-content/60 italic" title="Who is typing" aria-live="polite"></span>
						<span id="rtt-pill" class="text-xs text-base-content/40" title="Last save round-trip"></span>
						<span id="net-status" class="text-xs text-warning hidden" aria-live="polite">reconnecting…</span>
					</span>
				</div>
				<label class="sr-only" for="note-text">Note text</label>
				<div id="note-wrap" class="relative">
					<textarea id="note-text" class="textarea textarea-bordered w-full font-mono" rows="20" placeholder="Type — every tab merges.">{ text }</textarea>
					<div id="caret-layer" aria-hidden="true"></div>
				</div>
				<p class="text-xs text-base-content/60 mt-2">Plain text, CRDT-merged on the server. Concurrent typing never loses characters; rich text does not exist here yet.</p>
	</div>
}
