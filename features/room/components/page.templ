// SCOPE:feature — Room demo page (GoAkt grains), live over SSE.
//
// The page renders the roster ONCE server-side and then never polls: the stream
// pushes whole snapshots, and the card is a Datastar region that morphs from
// them. Three things deliberately do NOT exist here any more, each of which was
// a defect:
//
//   - no 3s roster poll (the roster arrives when it changes, not on a timer);
//   - no 5s app heartbeat (a live SSE connection IS the liveness signal);
//   - no heartbeat flag to stop after Leave. Leave is an EXPLICIT state this tab
//     writes, so a crashed tab does not leave a ghost in the roster.
//
// The document around the body belongs to internal/ui.Shell: the card, signals
// and stream opener below are the page.
package components

import (
	"github.com/calionauta/gogogo/internal/ui"
	"encoding/json"
	"net/url"
	"strconv"

	"github.com/calionauta/gogogo/internal/components"
	appgoakt "github.com/calionauta/gogogo/internal/goakt"
)

// RoomLockSignals seeds the lock-derived UI.
//
// INVARIANT: "am I the holder?" is DERIVED (`$roomMe !== '' && $roomMe ===
// $roomHolder`), never shipped. Two consequences the code must respect:
//
//  1. $roomMe is written ONCE, in the page's own data-signals, and no push
//     ever mentions it. A broadcast has one body for all recipients, so any
//     per-viewer value in it is wrong for everyone but its author — shipping
//     roomMine=false hid the holder's own Release button until a reload.
//  2. Signals are therefore only ever sent with the url as the MERGE key:
//     pushing a signals frame that omits roomMe is harmless (Datastar
//     merges), but rendering the card with `data-signals` re-seeds the
//     element and DROPPED roomMe on every peer patch — the room then
//     silently lost "you" and every lock button with it. So the card's
//     own data-signals is the only place identity is written.
//
// $roomLeft follows the same rule, with one difference: it is ALSO per-viewer
// ("did THIS tab leave?"), so a broadcast must not carry it either. It is
// seeded false here and flipped only by the tab's own leave answer
// (RoomLeftSignal) — a shared push that shipped roomLeft:false would resurrect
// the buttons on the page of whoever had just left.
func RoomLockSignals(roster appgoakt.Roster, email string) map[string]any {
	if email == "" {
		return map[string]any{"roomHolder": roster.Presenter}
	}
	return map[string]any{
		"roomHolder": roster.Presenter,
		"roomMe":     email,
		"roomLeft":   false,
	}
}

// RoomLeftSignal is the ONE addition a leave answer makes to its own tab's
// signals: the tab asked to be out of the room, so its card must say so and
// stop offering the roster actions. Kept separate from RoomLockSignals so the
// per-viewer state has exactly two writers — the page seed (and a rejoin, which
// ships roomLeft:false through RoomLockSignals) and this — and a broadcast can
// never carry it.
func RoomLeftSignal() map[string]any {
	return map[string]any{"roomLeft": true}
}

// RoomLockSignalsJSON is the same map as the JSON text a `data-signals`
// attribute needs.
//
// WHY TWO FORMS. The templ attribute takes JSON TEXT; the SSE patch takes a
// VALUE. Passing the text to MarshalAndPatchSignals serializes it a second
// time, so the wire carried a quoted STRING ("{\"roomHolder\":...}") instead
// of an object, and Datastar's merge of a string is a no-op — the roster
// updated while $roomHolder never moved, which is why the lock buttons froze
// on every peer patch. Keep the map as the single source and marshal at the
// edge that actually needs text.
func RoomLockSignalsJSON(roster appgoakt.Roster, email string) string {
	b, err := json.Marshal(RoomLockSignals(roster, email))
	if err != nil {
		return "{}"
	}
	return string(b)
}

// Page renders the room demo: roster, exactly-one presenter lock, and the
// crash hook. Initial state is server-rendered for a first paint with no
// stream round trip; RoomCard (same markup) is what the stream morphs.
templ Page(email string, userRole string, roomID string, roster appgoakt.Roster, buildLabel string, buildCommit string, skinName string) {
	@ui.Shell(ui.Data{
		Title:       "Room — gogogo",
		Module:      "room",
		Heading:     "Room: " + roomID,
		Context:     roomContext(roster),
		Email:       email,
		Role:        userRole,
		BuildLabel:  buildLabel,
		BuildCommit: buildCommit,
		Skin:        skinName,
		Stack: []components.TechItem{
			{Name: "GoAkt grains", Note: "presenter-lock actor"},
			{Name: "supervision", Note: "crashed grains restart"},
			{Name: "SSE push", Note: "roster arrives on change"},
		},
	}, nil, nil, nil, roomBody(roomID, roster, email))
}

// roomBody is the work area: the seeded lock signals, the card the stream
// morphs, and the stream opener.
templ roomBody(roomID string, roster appgoakt.Roster, email string) {
	<div class="ui-page">
	@roomSignals(roster, email)
	@RoomCard(roomID, roster, email)
	@components.StreamOpener("room-sse-opener", "/room/stream?room="+url.QueryEscape(roomID), true)
	</div>
}

// roomContext is the header's context slot: the two facts this demo is about,
// in the same terse shape every module uses.
func roomContext(roster appgoakt.Roster) string {
	members := strconv.Itoa(len(roster.Members))
	if roster.Presenter == "" {
		return members + " in the room · no presenter"
	}
	return members + " in the room · presenter " + roster.Presenter
}

templ roomSignals(roster appgoakt.Roster, email string) {
	<div id="room-signals" class="hidden" aria-hidden="true" data-signals={ RoomLockSignalsJSON(roster, email) }></div>
}




// RoomCard is the single roster region: rendered server-side on first paint
// AND re-rendered by the stream handler, from the same data. One component
// means the stream can never drift from the page (the poll era had two
// renderers: Templ here and an innerHTML string in the script).
//
// The buttons read the signals, never the render: a peer taking the lock
// changes $roomHolder/$roomMine, and Datastar re-evaluates every expression
// on the element without a patch. That is why the whole lock affordance is
// declarative — no script decides which button is visible.
templ RoomCard(roomID string, roster appgoakt.Roster, email string) {
	<div id="room-card" class="ui-card mt-4">
		<div class="ui-card-body">
			@RoomCardContent(roomID, roster, email)
		</div>
	</div>
}

// RoomCardContent is the PATCH REGION. It is a dedicated element inside the
// card so the stream patches the roster content alone, not the card shell:
// Datastar morphs the region, and the id-matched buttons inside it survive
// the morph with their data-show effects still bound. The page and the
// stream render through this same component, so pushed markup cannot drift
// from the server-rendered first paint.
templ RoomCardContent(roomID string, roster appgoakt.Roster, email string) {
	<div id="room-card-content">
		<h2 class="ui-title">
			Presenter: <span id="room-presenter">
				if roster.Presenter == "" {
					(none)
				} else {
					{ roster.Presenter }
				}
			</span>
		</h2>
		<p class="text-sm opacity-70">Room generation <span id="room-generation">{ strconv.Itoa(roster.Generation) }</span> (bumps on every restart)</p>
		<ul id="room-roster" class="ui-stack text-sm">
			if len(roster.Members) == 0 {
				<li class="opacity-60">Nobody in this room yet.</li>
			}
			for _, m := range roster.Members {
				if m.Name == email {
					<li class="font-semibold" title="you">{ m.Name } (you)</li>
				} else {
					<li>{ m.Name }</li>
				}
			}
		</ul>
		<p id="room-hint" class="text-sm opacity-70" data-text="$roomLeft ? 'You left this room.' : ($roomHolder === '' ? 'Nobody holds the presenter lock — anyone here can take it.' : ($roomMe !== '' && $roomMe === $roomHolder ? 'You hold the presenter lock.' : 'The lock is held by ' + $roomHolder + '; only they can release it.'))">
			if roster.Presenter == "" {
				Nobody holds the presenter lock — anyone here can take it.
			} else if roster.Presenter == email {
				You hold the presenter lock.
			} else {
				The lock is held by { roster.Presenter }; only they can release it.
			}
		</p>
		<p id="room-left" class="alert alert-info text-sm" role="status" data-show="$roomLeft">
			You left this room: peers no longer list you and the roster actions are
			hidden. Rejoin puts you back — and so does this tab reconnecting, because
			presence IS the connection.
		</p>
		<div class="ui-row justify-end mt-2 flex-wrap">
			<button
				id="room-acquire"
				class="ui-btn ui-btn-primary"
				type="button"
				data-show="$roomLeft !== true && $roomHolder === ''"
				data-on:click={ "@post('/room/acquire?room=" + url.QueryEscape(roomID) + "&clientID=' + encodeURIComponent(window.__gogogoClientID || ''))" }
			>Take presenter</button>
			<button
				id="room-release"
				class="ui-btn ui-btn-ghost"
				type="button"
				data-show="$roomLeft !== true && $roomMe !== '' && $roomMe === $roomHolder"
				data-on:click={ "@post('/room/release?room=" + url.QueryEscape(roomID) + "&clientID=' + encodeURIComponent(window.__gogogoClientID || ''))" }
			>Release</button>
			<button
				id="room-leave"
				class="ui-btn ui-btn-ghost"
				type="button"
				data-show="$roomLeft !== true"
				data-on:click={ "@post('/room/leave?room=" + url.QueryEscape(roomID) + "&clientID=' + encodeURIComponent(window.__gogogoClientID || ''))" }
			>Leave</button>
			<button
				id="room-rejoin"
				class="ui-btn ui-btn-primary"
				type="button"
				data-show="$roomLeft === true"
				data-on:click={ "@post('/room/join?room=" + url.QueryEscape(roomID) + "&clientID=' + encodeURIComponent(window.__gogogoClientID || ''))" }
			>Rejoin</button>
			<button
				id="room-crash"
				class="ui-btn ui-btn-error"
				type="button"
				data-show="$roomLeft !== true"
				data-on:click={ "@post('/room/crash?room=" + url.QueryEscape(roomID) + "')" }
			>Crash room</button>
		</div>
	</div>
}
