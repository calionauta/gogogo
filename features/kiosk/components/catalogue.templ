package components

import "github.com/calionauta/gogogo/internal/i18n"

// Catalogue renders the menu as tappable choices.
//
// SHAPE. One group per question the order asks (drink, size, milk, extras), each
// a wrapped row of DaisyUI buttons carrying a price badge. Extras are the
// exception: they accumulate, so they are checkboxes rather than radios.
//
// WHY THE MENU IS VISIBLE AT ALL. Dictation is one way to order, not the only
// one: a noisy room, a customer who does not know the word "oat", or a kiosk
// without a microphone all need to see what is sold. A customer who cannot see
// the options cannot ask for one.
//
// WHY A TAP GOES TO THE SERVER. The price depends on every field at once, and
// the server already owns that arithmetic (PriceCents). Computing it again in JS
// would be a second source of truth for money — the one place a second copy is
// unacceptable. The tap therefore posts the chosen IDs with the text, the server
// merges them (an explicit choice beats what the text implied) and answers with
// the same preview signals a spoken order produces.
// A native submit would navigate: the form has no action, so it would GET its
// own fields. submit__prevent is what makes the button post; the change handler
// keeps a tap live without waiting for the button.
templ MenuCatalogue(cat Catalogue) {
	<form
		id="kiosk-catalogue"
		class="ui-stack"
		data-on:submit__prevent="@post('/api/kiosk/preview', {contentType: 'form'})"
		data-on:change="@post('/api/kiosk/preview', {contentType: 'form'})"
	>
		<input type="hidden" name="text" value="" data-attr:value="$kioskText"/>
		@radioGroup(i18n.T(ctx, "kiosk.drink", nil), "drink", cat.Drinks)
		@radioGroup(i18n.T(ctx, "kiosk.size", nil), "size", cat.Sizes)
		@checkGroup(i18n.T(ctx, "kiosk.milk", nil), "milk", cat.Milks)
		@checkGroup(i18n.T(ctx, "kiosk.extras", nil), "extras", cat.Extras)
		<button type="submit" class="btn btn-sm btn-ghost self-start">
			{ i18n.T(ctx, "kiosk.applyChoices", nil) }
		</button>
	</form>
}

// radioGroup is one single-choice row: the preview holds exactly one value per
// field, so the control is a radio group.
templ radioGroup(title, field string, choices []Choice) {
	<fieldset class="ui-stack">
		<legend class="ui-meta">{ title }</legend>
		<div class="flex flex-wrap gap-2">
			for _, c := range choices {
				<label class="btn btn-sm">
					<input type="radio" name={ field } value={ c.ID } class="sr-only"/>
					<span>{ c.Label }</span>
					if c.Price != "" {
						<span class="badge badge-xs badge-ghost">{ c.Price }</span>
					}
				</label>
			}
		</div>
	</fieldset>
}

// checkGroup is one multi-select row: milk is a single choice in the order
// model, but a customer may want to say "none", so it shares the toggle shape
// with extras and the server keeps the last one.
templ checkGroup(title, field string, choices []Choice) {
	<fieldset class="ui-stack">
		<legend class="ui-meta">{ title }</legend>
		<div class="flex flex-wrap gap-2">
			for _, c := range choices {
				<label class="btn btn-sm">
					<input type="checkbox" name={ field } value={ c.ID } class="sr-only"/>
					<span>{ c.Label }</span>
					if c.Price != "" {
						<span class="badge badge-xs badge-ghost">{ c.Price }</span>
					}
				</label>
			}
		</div>
	</fieldset>
}
