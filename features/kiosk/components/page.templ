// The kiosk demo's page: one text field, one preview card, one order list.
//
// Two deliberate choices:
//
//   - Text first. The microphone fills the same input the keyboard fills, and the
//     same debounced request parses both. There is no second code path to keep in
//     step, and a browser without speech support loses nothing but the button.
//   - The recognizer runs ON DEVICE or not at all (processLocally). A demo that
//     quietly streams a microphone to a vendor is a privacy decision nobody made;
//     when the local language pack is missing the button says so and the user
//     types.
//
// The script is inline rather than a static asset: the page owns ~90 lines of
// behavior with no templ expression in a script body, and inlining keeps the
// recipe from declaring a route (and a policy row) just to serve one file. The
// dashboard's odometer island is the same shape.
package components

import (
	"strconv"

	"github.com/calionauta/gogogo/features/sounds"
	"github.com/calionauta/gogogo/internal/i18n"
	"github.com/calionauta/gogogo/internal/ui"
)

// Order is one confirmed order as the page and the chat panel render it. The
// view type is local so this package never imports the generated query package:
// the page compiles whether or not codegen has run.
type Order struct {
	Drink     string
	Size      string
	Milk      string
	Extras    string
	Price     string
	When      string
	Corrected bool
}

// PageData is everything Page needs: the viewer, the build label, the
// recognizer's phrase list and the rows.
type PageData struct {
	Email       string
	Role        string
	BuildLabel  string
	BuildCommit string
	// Phrases is the JSON array the recognizer uses as contextual bias. It is
	// rendered from the menu, so the vocabulary has one source.
	Phrases   string
	MenuLine  string
	Catalogue Catalogue
	Orders    []Order
}

// seedSignals is the page's initial signal set. Text is deliberately absent:
// $kioskText is bound to the input, which owns it, so a server write could
// clobber what the user is typing (the bug docs/realtime-recipe.md records).
func seedSignals() Seeds {
	return Seeds{
		"kioskDrink":   "",
		"kioskSize":    "",
		"kioskMilk":    "",
		"kioskExtras":  "",
		"kioskPrice":   "",
		"kioskNeed":    "",
		"kioskPreview": "",
		"kioskNotice":  "",
		"kioskBusy":    false,
		"kioskQueued":  false,
	}
}

// Page renders /kiosk inside the shell.
templ Page(data PageData) {
	@ui.Shell(ui.Data{
		Title:       "Kiosk — gogogo",
		Heading:     i18n.T(ctx, "kiosk.title", nil),
		Context:     "demo · ext_kiosk_orders",
		Email:       data.Email,
		Role:        data.Role,
		BuildLabel:  data.BuildLabel,
		BuildCommit: data.BuildCommit,
	}, kioskHead(), kioskSound(), nil, kioskBody(data))
}

// kioskSound is the rail's mute. The page owns no sound logic of its own — the
// shell slot is filled with the plugin's switch, the same one every page
// passes, so a demo page is not the one screen whose rail has no mute.
templ kioskSound() {
	@sounds.SoundSwitch()
}

// kioskHead carries the voice wiring. The recognizer only fills the input and
// dispatches `input`: the request itself belongs to the markup, next to the
// debounce, so there is one place that decides when the server is asked.
//
// The wiring runs on DOMContentLoaded, not where the tag sits: this component is
// rendered into <head>, so at parse time the body does not exist yet and every
// getElementById would return null — the button rendered, did nothing, and said
// nothing (the report "no option to turn the microphone on").
templ kioskHead() {
	@sounds.SoundAssets()
	<script nonce={ templ.GetNonce(ctx) }>
		function initKioskVoice() {
			var root = document.getElementById("kiosk-voice");
			var input = document.getElementById("kiosk-text");
			var status = document.getElementById("kiosk-voice-status");
			var mic = document.getElementById("kiosk-mic");
			if (!root || !input || !status || !mic) return;

			var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
			// No recognizer at all: the button cannot ever work, so it leaves
			// instead of sitting there inviting a click that does nothing.
			if (!SR) {
				mic.hidden = true;
				status.textContent = "This browser has no speech recognition — type the order.";
				return;
			}
			var lang = document.documentElement.lang || "en-US";
			var recognition = null;
			var listening = false;
			var lastResultAt = 0;
			var watchdog = 0;

			function say(text) { status.textContent = text; }
			function idle() {
				listening = false;
				mic.setAttribute("aria-pressed", "false");
				mic.textContent = mic.getAttribute("data-label-idle") || "Microphone";
			}

			function stop() {
				clearTimeout(watchdog);
				if (recognition && listening) recognition.stop();
				idle();
			}

			// On-device gating. available()/install() are the 2026 Web Speech API
			// surface; without them the browser can only recognize remotely, and
			// this page does not use a remote recognizer.
			function localSupport() {
				return !!(SR && typeof SR.available === "function" && typeof SR.install === "function");
			}

			function prepare(next) {
				if (recognition) return recognition;
				recognition = new SR();
				recognition.lang = lang;
				recognition.continuous = true;
				recognition.interimResults = true;
				recognition.maxAlternatives = 1;
				recognition.processLocally = true;
				bias(recognition);
				recognition.onresult = function (event) {
					lastResultAt = Date.now();
					var text = "";
					for (var i = 0; i < event.results.length; i++) {
						text += event.results[i][0].transcript + " ";
					}
					input.value = text.trim();
					input.dispatchEvent(new Event("input", { bubbles: true }));
					// A finished utterance is exactly when the decision engine
					// earns its round trip: the menu has had its chance, and a
					// person is waiting for the order to settle. Typing keeps the
					// parser-only path (see the input's debounce).
					if (event.results[event.results.length - 1].isFinal) {
						var said = text.trim().toLowerCase();
						var wantsReset = resetPhrases.some(function (p) { return said.indexOf(p) !== -1; });
						if (wantsReset) {
							// Dispatch, so ONE definition of "clear" serves the
							// button and the voice command.
							input.dispatchEvent(new CustomEvent("kiosk-clear", { bubbles: true }));
							say("Order cleared — say or type a new one.");
							return;
						}
						input.dispatchEvent(new CustomEvent("kiosk-decide", { bubbles: true }));
					}
				};
				recognition.onerror = function (event) {
					say("Microphone: " + (event.error || "error") + " — type the order.");
					stop();
				};
				recognition.onend = function () {
					// The browser ends a session on its own after silence. Leave it
					// stopped and say so rather than pretending it is still listening.
					if (listening) {
						say("Listening stopped — tap the microphone to continue, or type.");
						idle();
					}
				};
				return next(recognition);
			}

			// bias supplies the menu as phrases. Contextual biasing is the cheap half
			// of accuracy: the recognizer prefers words it was told about.
			function bias(rec) {
				if (!rec.phrases || !window.SpeechRecognitionPhrase) return;
				if (!root.dataset.phrases) return;
				try {
					var labels = JSON.parse(root.dataset.phrases);
					rec.phrases = labels.map(function (label) {
						return new SpeechRecognitionPhrase(label, 1);
					});
				} catch (_) {
					// A malformed attribute costs the bias, not the feature.
				}
			}

			// installTimeout bounds the language-pack download. Chrome's install()
			// can stay pending for minutes on a slow link and never reject, which
			// left the page saying "Downloading…" forever with no way back — the
			// button still worked, but nothing said so. A timeout turns that into
			// an instruction (type, or ask again) instead of a stuck label.
			var installTimeout = 20000;

			function availableWithTimeout(options) {
				return Promise.race([
					SR.available(options),
					new Promise(function (resolve) { setTimeout(function () { resolve("unknown"); }, 5000); })
				]);
			}

			function installWithTimeout(options) {
				return Promise.race([
					SR.install(options),
					new Promise(function (resolve) { setTimeout(function () { resolve(false); }, installTimeout); })
				]);
			}

			// askMicrophone asks the browser for microphone permission.
			//
			// SpeechRecognition.start() does NOT trigger the permission prompt on
			// its own: the recognizer is handed an already-granted stream, so with
			// no grant it fails immediately with `not-allowed` and the page says
			// "type the order" — the reported bug ("it never asked me"). Calling
			// getUserMedia IS what shows the prompt. The tracks are stopped right
			// away: recognition opens its own capture, and holding a second
			// stream would light the microphone indicator for no reason.
			function askMicrophone() {
				if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
					// No getUserMedia at all (insecure origin): the recognizer may
					// still work on a granted permission, so do not block here.
					return Promise.resolve(true);
				}
				return navigator.mediaDevices.getUserMedia({ audio: true }).then(function (stream) {
					stream.getTracks().forEach(function (t) { t.stop(); });
					return true;
				}).catch(function () {
					return false;
				});
			}

			function start() {
				if (!localSupport()) {
					say("This browser offers no on-device recognition — type the order.");
					return;
				}
				var options = { langs: [lang], processLocally: true };
				// Permission FIRST. The recognizer needs an already-granted stream,
				// and a language-pack download is slow and can hang: asking after
				// it meant the user clicked, waited, and never saw the prompt —
				// which is exactly what was reported ("it never asked me").
				askMicrophone().then(function (granted) {
					if (!granted) {
						say("Microphone permission was denied — allow it in the browser, or type the order.");
						return null;
					}
					return availableWithTimeout(options).then(function (state) {
						if (state === "available") return "ready";
						// `downloading` means an install is already running: waiting on
						// another one would stack downloads, so ask the user to retry.
						if (state === "downloading") {
							say("The language pack is still downloading — tap the microphone again in a moment.");
							return "pending";
						}
						say("Downloading the language pack once…");
						return installWithTimeout(options).then(function (ok) {
							return ok ? "ready" : "pending";
						});
					});
				}).then(function (outcome) {
					if (outcome !== "ready") {
						// null: permission refused (the message is already shown).
						// pending: the install is still running in the background and
						// the label already says what to do.
						return;
					}
					startRecognition();
				}).catch(function () {
					say("On-device recognition unavailable — type the order.");
				});
			}

			// startRecognition begins a listening session, assuming the language
			// pack is present and the microphone is allowed.
			function startRecognition() {
				prepare(function (rec) {
					listening = true;
					mic.setAttribute("aria-pressed", "true");
					mic.textContent = mic.getAttribute("data-label-live") || "Stop";
					say("Listening on device…");
					lastResultAt = Date.now();
					rec.start();
					// A known browser bug (Chromium 579050368) detects speech and
					// never fires a result. Silence must become an instruction,
					// not a spinner that never ends.
					watchdog = setTimeout(function () {
						if (listening && Date.now() - lastResultAt > 4000) {
							say("I did not catch that — type the order.");
							stop();
						}
					}, 4500);
				});
			}

			// A spoken "start over" clears the order the same way the button does.
			// The recognizer only fills the input, so the phrase is checked here
			// rather than parsed server-side: it is a command, not an order.
			var resetPhrases = ["start over", "start again", "clear", "cancel order", "recomeçar", "limpar", "cancelar"];

			// ONE handler: the markup's data-on:click calls __kioskVoice.toggle.
			// An addEventListener here would fire on the same click as well, so
			// the two toggles cancelled out — the button flipped to Stop and
			// straight back to Microphone, and recognition never stayed on.
			window.__kioskVoice = { toggle: function () { if (listening) stop(); else start(); } };
		}

		// The body is not parsed yet when this script runs (it is in <head>), so
		// the wiring waits for the DOM. `readyState` covers the case where a
		// later include has already fired the event.
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initKioskVoice);
		} else {
			initKioskVoice();
		}
	</script>
}

templ kioskBody(data PageData) {
	<div class="ui-page ui-page-narrow ui-stack" data-signals={ MarshalSignals(seedSignals()) }>
		<section class="ui-card" id="kiosk-voice" data-phrases={ data.Phrases }>
			<div class="ui-card-body ui-stack">
				<h2 class="ui-title">{ i18n.T(ctx, "kiosk.sayOrder", nil) }</h2>
				<p class="ui-meta">{ i18n.T(ctx, "kiosk.sayOrderHelp", nil) }</p>
				<form
					id="kiosk-form"
					class="ui-row"
					data-on:submit__prevent="@post('/api/kiosk/preview', {contentType: 'form'})"
					data-on:kiosk-clear="var i = document.getElementById('kiosk-text'); i.value = ''; $kioskText = ''; $kioskDrink = ''; $kioskSize = ''; $kioskMilk = ''; $kioskExtras = ''; $kioskPrice = ''; $kioskNeed = ''; $kioskPreview = ''; $kioskNotice = ''; i.focus()"
				>
					<input
						id="kiosk-text"
						name="text"
						class="input input-sm grow"
						autocomplete="off"
						placeholder={ i18n.T(ctx, "kiosk.orderPlaceholder", nil) }
						aria-label={ i18n.T(ctx, "kiosk.orderLabel", nil) }
						maxlength="240"
						data-bind="kioskText"
						data-on:input__debounce.350ms="!$kioskBusy ? ($kioskBusy = true, @post('/api/kiosk/preview', {contentType: 'form'}).finally(() => { $kioskBusy = false; if ($kioskQueued) { $kioskQueued = false; el.dispatchEvent(new CustomEvent('kiosk-retry', { bubbles: true })) } })) : ($kioskQueued = true)"
						data-on:kiosk-retry="!$kioskBusy ? ($kioskBusy = true, @post('/api/kiosk/preview', {contentType: 'form'}).finally(() => { $kioskBusy = false; })) : null"
					/>
					<input type="hidden" name="previewed" data-attr:value="$kioskPreview"/>
					{{/* No "Interpret" button: the field IS interpreted. The debounce
					     posts what was typed or spoken, the server parses it, and the
					     decision engine runs only when the menu could not settle it —
					     the customer never has to tell the page to understand them.
					     Reset is the counter's "customer changed their mind". It is
					     disabled while a request is in flight, because clearing
					     mid-answer would let the late patch land on a cleared form. */}}
					<button
						type="button"
						id="kiosk-clear"
						class="btn btn-ghost btn-sm"
						title={ i18n.T(ctx, "kiosk.resetHint", nil) }
						data-attr:disabled="!!$kioskBusy"
						data-on:click="el.dispatchEvent(new CustomEvent('kiosk-clear', { bubbles: true }))"
					>
						{ i18n.T(ctx, "kiosk.reset", nil) }
					</button>
				</form>
				<div class="ui-row">
					<button
						type="button"
						id="kiosk-mic"
						class="btn btn-sm"
						aria-pressed="false"
						data-label-idle={ i18n.T(ctx, "kiosk.microphone", nil) }
						data-label-live={ i18n.T(ctx, "kiosk.stop", nil) }
						data-on:click="window.__kioskVoice && window.__kioskVoice.toggle()"
					>
						{ i18n.T(ctx, "kiosk.microphone", nil) }
					</button>
					<span id="kiosk-voice-status" class="ui-meta" role="status">
						{ i18n.T(ctx, "kiosk.micOptional", nil) }
					</span>
				</div>
			</div>
		</section>

		// The receipt is STICKY: it is the thing the customer is buying, and it
		// must stay readable while they scroll the menu or the order list. It
		// sits directly under the field, so saying an order and seeing its price
		// never needs a scroll.
		<section class="ui-card sticky top-2 z-10 shadow-sm" id="kiosk-receipt">
			<div class="ui-card-body ui-stack">
				<div class="flex items-baseline justify-between gap-3">
					<h2 class="ui-title">{ i18n.T(ctx, "kiosk.preview", nil) }</h2>
					<span class="ui-meta" data-show="!!$kioskBusy">{ i18n.T(ctx, "kiosk.pricing", nil) }</span>
				</div>
				{{/* The preview is a receipt, not a form: what the customer is
				     about to buy, read top to bottom, with the total set apart —
				     the same shape a paper ticket has, so it is understood at a
				     glance from the counter side. */}}
				<dl class="divide-y divide-base-300/60">
					<div class="flex items-baseline justify-between gap-3 py-1.5">
						<dt class="ui-meta">{ i18n.T(ctx, "kiosk.drink", nil) }</dt>
						<dd class="font-medium" data-text="$kioskDrink || '—'"></dd>
					</div>
					<div class="flex items-baseline justify-between gap-3 py-1.5">
						<dt class="ui-meta">{ i18n.T(ctx, "kiosk.size", nil) }</dt>
						<dd class="font-medium" data-text="$kioskSize || '—'"></dd>
					</div>
					<div class="flex items-baseline justify-between gap-3 py-1.5">
						<dt class="ui-meta">{ i18n.T(ctx, "kiosk.milk", nil) }</dt>
						<dd class="font-medium" data-text="$kioskMilk || '—'"></dd>
					</div>
					<div class="flex items-baseline justify-between gap-3 py-1.5">
						<dt class="ui-meta">{ i18n.T(ctx, "kiosk.extras", nil) }</dt>
						<dd class="font-medium text-right" data-text="$kioskExtras || '—'"></dd>
					</div>
					<div class="flex items-baseline justify-between gap-3 pt-3 mt-1 border-t-2 border-base-300">
						<dt class="text-sm font-semibold">{ i18n.T(ctx, "kiosk.price", nil) }</dt>
						<dd class="text-2xl font-bold tabular-nums" data-text="$kioskPrice || '—'"></dd>
					</div>
				</dl>
				<p class="ui-meta" data-show="!!$kioskNeed" data-text="$kioskNeed"></p>
				<button
					type="button"
					class="btn btn-primary btn-sm"
					data-attr:disabled="!!($kioskBusy || !$kioskDrink || $kioskNeed)"
					data-on:click="$kioskBusy = true; @post('/api/kiosk/confirm', {contentType: 'form'}).finally(() => { $kioskBusy = false; })"
				>
					{ i18n.T(ctx, "kiosk.confirm", nil) }
				</button>
				<p class="ui-meta" data-show="!!$kioskNotice" data-text="$kioskNotice"></p>
			</div>
		</section>

		// The menu is PROGRESSIVE DISCLOSURE, not a permanent block: a customer
		// who knows what they want never needs it, and a screen of buttons
		// between the field and the receipt buries the thing they are buying.
		// The summary states the menu line, so the prices are readable without
		// opening it.
		<details class="ui-card" id="kiosk-menu">
			<summary class="ui-card-body cursor-pointer">
				<div class="ui-row justify-between gap-3">
					<h2 class="ui-title">{ i18n.T(ctx, "kiosk.menu", nil) }</h2>
					<span class="ui-meta">{ i18n.T(ctx, "kiosk.menuOpenHint", nil) }</span>
				</div>
				<p class="ui-meta">{ data.MenuLine }</p>
			</summary>
			<div class="ui-card-body ui-stack pt-0">
				@MenuCatalogue(data.Catalogue)
			</div>
		</details>

		<section class="ui-card">
			<div class="ui-card-body">
				<div id="kiosk-orders">@OrdersList(data.Orders)</div>
			</div>
		</section>
	</div>
}

// OrdersList is the page's list AND the chat panel's body: one component, so the
// panel cannot drift from the page it summarizes (the rule docs/native-panels.md
// records).
templ OrdersList(orders []Order) {
	<div class="ui-row justify-between">
		<h2 class="ui-title">{ i18n.T(ctx, "kiosk.orders", nil) }</h2>
		<span class="ui-meta">{ strconv.Itoa(len(orders)) }</span>
	</div>
	if len(orders) == 0 {
		<div class="ui-empty">
			<p class="ui-empty-title">{ i18n.T(ctx, "kiosk.noOrdersTitle", nil) }</p>
			<p class="ui-empty-body">
				{ i18n.T(ctx, "kiosk.noOrdersBody", nil) }
			</p>
		</div>
	} else {
		<ul class="ui-stack text-sm">
			for _, o := range orders {
				<li class="ui-row justify-between">
					<span>
						{ o.Drink } · { o.Size }
						if o.Milk != "" {
							· { o.Milk }
						}
						if o.Extras != "" {
							· { o.Extras }
						}
						if o.Corrected {
							<span class="badge badge-warning badge-sm">{ i18n.T(ctx, "kiosk.corrected", nil) }</span>
						}
					</span>
					<span class="ui-meta">{ o.Price } · { o.When }</span>
				</li>
			}
		</ul>
	}
}
