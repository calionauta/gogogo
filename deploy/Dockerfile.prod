# syntax=docker/dockerfile:1.7
#
# deploy/Dockerfile.prod — production image, built on the server
# (scripts/deploy-prod.sh runs `docker compose build` there; the GH
# Actions deploy workflow SSHes in and invokes it). Runtime contract:
# alpine + ca-certificates + libgcc + /tmp + USER 65532.
#
# Why alpine and not scratch: the flat stack's database driver
# (tursogo) is a Rust shared library loaded at runtime via dlopen
# (see internal/db). Scratch has no dynamic loader, so the binary
# panics on boot (`Dynamic loading not supported`) — that exact
# crash-loop took production down on the PocketBase→flat migration
# (0.44.0). Alpine ships musl's loader; the builder compiles with
# -tags musl so the embedded musl-linked library is the one extracted
# and loaded. Do NOT "simplify" this back to scratch: a static binary
# cannot dlopen, and tursogo has no static-link mode.
#
# Build pipeline: Tailwind v4 + DaisyUI v5 CSS build runs here (npm),
# Templ generates, then the Go binary compiles with CGO_ENABLED=1
# (purego needs a real libc dlopen) dynamically linked against musl
# (no -extldflags=-static: a static binary cannot dlopen at all).

# ────────────────────────────
# Stage 1: builder
# ────────────────────────────
FROM golang:1.27-alpine AS builder
RUN apk add --no-cache git ca-certificates nodejs npm gcc musl-dev
# ARGs for build-time metadata injection. Defaults match local
# builds; the docker-image Makefile target passes real values via
# --build-arg.
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILDTIME=

WORKDIR /src

# Install Go module deps first (cached independently of source).
COPY go.mod go.sum ./
RUN go mod download

# Install CSS build deps (Tailwind v4 CLI + DaisyUI v5).
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

# Build for the deployment target's native architecture. The image is
# always built on the server (see scripts/deploy-prod.sh, which runs
# `docker compose build` there), and the production server is arm64,
# so a native arm64 binary runs without QEMU/binfmt. Forcing a
# different GOARCH here produces an exec-format-error binary on the
# server. (GOOS=linux is still set; the builder's native GOARCH is used.)
COPY . .
RUN go tool templ generate && \
    npm run build --silent && \
    # Inject build metadata. ARGs declared at top of file. See
    # top-level Dockerfile for rationale.
    #
    # -tags musl: turso-go-platform-libs embeds one prebuilt Rust
    # library per platform; the `musl` tag selects libs/linux_*_musl
    # (linked against libc.musl). Without it the glibc .so is
    # embedded and dlopen fails on this musl runtime. Go does not
    # set the musl tag automatically — pass it explicitly.
    #
    # CGO_ENABLED=1 and NO -extldflags=-static: purego loads the
    # library with the real libc dlopen, which requires a dynamically
    # linked binary. A static binary dies at first DB open with
    # "Dynamic loading not supported" (production 0.44.0).
    CGO_ENABLED=1 GOOS=linux go build \
        -tags musl \
        -trimpath -ldflags="-s -w -X main.Version=${VERSION} -X main.CommitHash=${COMMIT} -X main.BuildTime=${BUILDTIME}" \
        -o /out/app ./cmd/web/

# ────────────────────────────
# Stage 2: runtime (alpine)
# ────────────────────────────
# Alpine, not scratch: the app dlopens the tursogo Rust library at
# first DB open, which needs musl's dynamic loader
# (/lib/ld-musl-*.so.1) plus libgcc_s (the musl .so's NEEDED entries).
# ca-certificates for HTTPS to LLM providers (OpenAI, Groq, etc.).
FROM alpine:3.22
RUN apk add --no-cache ca-certificates libgcc

# The dynamically-linked Go binary (CGO_ENABLED=1, musl).
COPY --from=builder /out/app /app

# The app's DATA_DIR is set to /var/lib/<app>/data (absolute, via compose
# env), which bind-mounts to the host volume ACL-granted to uid 65532
# (see scripts/deploy-prod.sh). With -tags dagnats the DagNats engine boots
# its own embedded NATS and stores durable workflow state in DAGNATS_STORE_DIR
# (default data/dagnats), separate from the main app SQLite files.
# — no separate data dir is created and no extra writable path is needed.
WORKDIR /var/lib/gogogo/data

# Alpine ships a writable /tmp, which the Go runtime expects (and which
# backs $HOME/.cache when TURSO_GO_CACHE_DIR is unset — production sets
# it to the data volume instead; see deploy/docker-compose.prod.yml).
ENV HOME=/tmp \
    XDG_CONFIG_HOME=/tmp \
    XDG_CACHE_HOME=/tmp

# Run as non-root: numeric UID works without an /etc/passwd entry.
# 65532 is the standard "nonroot" UID used by distroless images.
USER 65532:65532

EXPOSE 8080

# Exec-form healthcheck needs no shell: `/app health` GETs /health
# internally (scratch-compatible and alpine-compatible alike).

ENTRYPOINT ["/app"]
