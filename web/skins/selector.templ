package skins

// SkinSelector renders a compact menu for choosing the active UI skin. It
// lives in the navbar, next to the theme and sound toggles, and navigates to
// ?skin=<name>. All colours come from skin tokens, so the control is legible
// in light and dark mode on every skin.
templ SkinSelector(current string) {
	<div class="skin-selector" data-signals={ `{"skinMenuOpen":false}` } data-on:click__document="if(!evt.target.closest('.skin-selector')){$skinMenuOpen = false}">
		<button
			type="button"
			class="skin-toggle"
			title="Select UI skin"
			aria-label="Select UI skin"
			data-on:click="$skinMenuOpen = !$skinMenuOpen"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="skin-toggle-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M4 2a2 2 0 00-2 2v11a3 3 0 106 0V4a2 2 0 00-2-2H4zm1 14a1 1 0 100-2 1 1 0 000 2zm5-1.757l4.9-4.9a2 2 0 000-2.828L13.485 5.1a2 2 0 00-2.828 0L10 5.757v8.486zM16 18H9.071l6-6H16a2 2 0 012 2v2a2 2 0 01-2 2z" clip-rule="evenodd"/>
			</svg>
			<span class="skin-label-sm">{ current }</span>
		</button>
		<ul class="skin-menu" role="menu" data-show="$skinMenuOpen">
			for _, name := range List() {
				<li role="menuitem">
					<a href={ "?skin=" + name } data-active={ name == current } class={ "skin-menu-item" }>
						{ name }
					</a>
				</li>
			}
		</ul>
	</div>
}
