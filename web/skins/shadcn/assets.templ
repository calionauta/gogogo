// Package shadcn — the skin's asset block.
package shadcn

import "github.com/calionauta/gogogo/web/resources"

// assets returns the <link>/<script> elements for the skin. chrome.css (the
// shared top bar) and iconify arrive through authviews.ThemeHead, which every
// page already renders, so they are intentionally not repeated here.
//
// URLs are versioned (resources.StaticURL) so the browser/CDN can hold them
// immutably; the CSS itself is built from src/css/shadcn-input.css.
templ assets() {
	<link rel="stylesheet" href={ resources.StaticURL("shadcn.min.css") }/>
	<link rel="stylesheet" href={ resources.StaticURL("app.css") }/>
	<script defer type="module" src={ resources.StaticURL("theme.js") }></script>
	<script defer type="module" src={ resources.StaticURL("datastar.js") }></script>
}
