// Package skins — the DaisyUI asset block, shared by the default skin and by
// Active()'s fallback.
package skins

import "github.com/calionauta/gogogo/web/resources"

// DefaultAssets is the DaisyUI asset block. It lives here (not only in the
// daisyui package) so Active can render a sane default when no skin has been
// registered, which is the normal state in a single-package component test.
//
// Every URL is versioned through resources.StaticURL so the browser and any
// CDN in front of the app can cache the file immutably instead of revalidating
// it on every navigation (see resources.AssetHandler).
templ DefaultAssets() {
	<link rel="stylesheet" href={ resources.StaticURL("app.min.css") }/>
	<link rel="stylesheet" href={ resources.StaticURL("app.css") }/>
	<script nonce={ templ.GetNonce(ctx) } defer type="module" src={ resources.StaticURL("theme.js") }></script>
	<script nonce={ templ.GetNonce(ctx) } defer type="module" src={ resources.StaticURL("datastar.js") }></script>
}
