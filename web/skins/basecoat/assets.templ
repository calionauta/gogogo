// Package basecoat — the skin's asset block.
package basecoat

import "github.com/calionauta/gogogo/web/resources"

// assets returns the <link>/<script> templ component for BasecoatUI assets.
// It loads the basecoat CSS alongside the standard scripts; the CSS provides
// shadcn-style design tokens and utilities, and the JS runtime backs the
// data-* behaviours the shared markup relies on.
//
// URLs are versioned (resources.StaticURL) so the browser/CDN can hold them
// immutably instead of revalidating every asset on every navigation.
templ assets() {
	<link rel="stylesheet" href={ resources.StaticURL("basecoat.min.css") }/>
	<link rel="stylesheet" href={ resources.StaticURL("app.css") }/>
	<script defer type="module" src={ resources.StaticURL("theme.js") }></script>
	<script defer src={ resources.StaticURL("basecoat.min.js") }></script>
	<script src={ resources.StaticURL("iconify-icon.min.js") }></script>
	<script defer type="module" src={ resources.StaticURL("datastar.js") }></script>
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			if (typeof basecoat !== 'undefined' && basecoat.initAll) {
				try { basecoat.initAll(); } catch(e) {}
			}
		});
	</script>
}
