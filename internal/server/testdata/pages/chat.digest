tags a=20 body=1 button=7 details=5 dialog=1 div=20 form=3 h1=1 head=1 html=2 iconify=4 input=2 kbd=2 label=1 li=20 link=3 main=1 meta=2 nav=1 p=3 path=7 script=13 span=35 strong=7 style=2 summary=3 svg=7 title=1 ul=3
