// The rail's inbox entry: the one nav item with a live count.
//
// Expanded, the count is a daisyUI `indicator-item` on the row's label: the
// bubble hangs off the far corner of the row, clear of the icon. Collapsed,
// the label is gone, so the marker moves onto the icon itself as a bare dot
// (RailInboxDot) — the number has nowhere to sit in a 4.5rem column. Both
// nodes always render (hidden at zero) because the notifications feature
// patches them by id/signal: a node that only exists when non-zero would be
// un-patchable back to zero. The count is seeded by inboxBadgeMiddleware and
// replaced live by the inbox stream and by every mark-read action.
package ui

import (
	"strconv"

	"github.com/calionauta/gogogo/internal/icon"
)

// RailInboxBadge is the expanded rail's unread count, a daisyUI indicator item
// on the row label: it hangs off the label's end corner, vertically centred on
// the row (indicator-middle), because the rail's right edge has no room for a
// badge that sticks out. tabular-nums keeps a count change from shifting the
// label; the label caps at 99+ so three digits cannot stretch the rail row.
//
// The text/visibility are bound to $inboxUnread: the server seeds it from the
// page middleware, and session.js updates it from the leader stream's frames
// (BroadcastChannel fans the same value out to every tab). The server-rendered
// text is the pre-init fallback; the JS expression mirrors UnreadBadgeLabel so
// the first paint and every later update agree on the 99+ cap. The id stays on
// this node: session.js reads its text to seed the BroadcastChannel.
templ RailInboxBadge(unread int) {
	<span
		id="rail-inbox-badge"
		class={ templ.Classes("indicator-item indicator-middle badge badge-primary badge-xs tabular-nums is-drawer-close:hidden", map[string]bool{"hidden": unread <= 0}) }
		data-class="{'hidden': $inboxUnread <= 0}"
		data-text="$inboxUnread > 99 ? '99+' : ($inboxUnread > 0 ? $inboxUnread : '')"
		data-on:gogogo:unread__document="$inboxUnread = evt.detail.unread"
	>{ UnreadBadgeLabel(unread) }</span>
}

// RailInboxDot is the collapsed rail's marker: the same unread fact as a bare
// dot on the icon corner, because the label the count hangs off is hidden.
// The dot is position default (top-end) on purpose. Screen readers keep the
// number through an sr-only child; the dot itself is decoration.
templ RailInboxDot(unread int) {
	<span
		id="rail-inbox-dot"
		class={ templ.Classes("indicator-item status status-primary is-drawer-open:hidden", map[string]bool{"hidden": unread <= 0}) }
		data-class="{'hidden': $inboxUnread <= 0}">
		<span class="sr-only" data-text="$inboxUnread > 0 ? $inboxUnread + ' unread' : ''">{ unreadDotLabel(unread) }</span>
	</span>
}

// unreadDotLabel is the dot's screen-reader text. Zero renders nothing.
func unreadDotLabel(unread int) string {
	if unread <= 0 {
		return ""
	}
	return strconv.Itoa(unread) + " unread"
}

// railInboxRefresh is the badge's refresh affordance for pages that already
// hold a feature stream: those pages must not open a second long-lived
// connection (the browser's per-host cap is why), and a timer would be a poll.
// It asks for the count only on events that mean the user is back or the
// network changed — tab visible, window focused, bfcache restore, back online.
// Any tab that already heard a change broadcasts it, so this is the fallback,
// never the steady state. The endpoint answers with a signal patch, not markup.
//
// No signals in the URL: the badge needs none, and Datastar's default sends the
// WHOLE signal set as a query param (the todos array made a 10 KB URL that
// landed in logs). No retry either: a refused poll is an answer, not a transient
// failure, and the default ten retries turned a single 403 into a console storm.
templ railInboxRefresh() {
	<button
		id="rail-inbox-refresh"
		type="button"
		class="hidden"
		aria-hidden="true"
		data-on:click="@get('/api/notifications/badge', {filterSignals: {exclude: /.*/}, retryMaxCount: 0})"
		data-on:visibilitychange__document="if (!document.hidden && navigator.onLine) document.getElementById('rail-inbox-refresh').click()"
		data-on:focus__window="if (!document.hidden && navigator.onLine) document.getElementById('rail-inbox-refresh').click()"
		data-on:pageshow__window="evt.persisted && navigator.onLine && document.getElementById('rail-inbox-refresh').click()"
		data-on:online__window="document.getElementById('rail-inbox-refresh').click()"
	></button>
}

// railItem is one destination in the rail: same markup for every module. The
// inbox is the only entry with a live count, so it is the only one wrapped in
// indicator containers: the count hangs off the row label when expanded, and
// the collapsed rail moves the marker onto the icon.
//
// The label is hidden when the rail is collapsed to icons, and a hidden label
// is not read out: the row would be announced by whatever else it contains
// (the inbox count) or by nothing at all. So the collapsed width keeps a
// screen-reader copy of the name, and `title` stays the tooltip (the drawer
// dismissal is delegated to the rail's nav).
templ railItem(m Module, active bool, unread int) {
	<a
		href={ templ.SafeURL(m.URL) }
		class={ templ.Classes("app-rail-item", map[string]bool{"is-active": active}) }
		aria-current={ activeCurrent(active) }
		title={ m.Title }
		data-cuelume-hover="tick"
		data-cuelume-press="toggle">
		<span class="sr-only is-drawer-open:hidden">{ m.Title }</span>
		if m.ID == ModuleInbox {
			// Two indicator containers: the dot rides the icon (collapsed rail
			// has no label to hang the number off), the count rides the row's
			// end (the label grows, the count's anchor is the last cell).
			<span class="indicator shrink-0">
				@icon.Icon(m.Icon, "app-rail-icon")
				@RailInboxDot(unread)
			</span>
			<span class="app-rail-label is-drawer-close:hidden">{ m.Title }</span>
			<span class="indicator shrink-0 is-drawer-close:hidden">
				@RailInboxBadge(unread)
			</span>
		} else {
			@icon.Icon(m.Icon, "app-rail-icon")
			<span class="app-rail-label is-drawer-close:hidden">{ m.Title }</span>
		}
	</a>
}

// UnreadBadgeLabel is the bubble's text. Zero renders nothing (the node stays
// in the DOM for patching); past 99 the bubble says "99+" instead of growing.
// Exported: the inbox header badge reads the same counter in the same form, so
// the two surfaces cannot disagree on the cap.
func UnreadBadgeLabel(unread int) string {
	switch {
	case unread <= 0:
		return ""
	case unread > 99:
		return "99+"
	default:
		return strconv.Itoa(unread)
	}
}
