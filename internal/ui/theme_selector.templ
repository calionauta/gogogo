// SCOPE:core — Theme selector for the shell's sidebar footer.
//
// A native <details> instead of a signal-driven menu: the disclosure needs no
// state, works before any JS runs, and closes on the second click. Selecting a
// theme goes through the $theme SIGNAL (Datastar owns data-theme and the dark
// class through bindings — writing the DOM directly is reverted), exactly like
// the light/dark toggle does.
//
// The names come from internal/themes, which themes_test.go keeps in step
// with the `themes:` list compiled by src/css/input.css.
package ui

import "github.com/calionauta/gogogo/internal/themes"

// ThemeSelector renders the palette picker in the sidebar footer.
templ ThemeSelector() {
	<details class="app-theme-picker">
		<summary title="Visual theme">Tema</summary>
		<ul class="app-theme-list">
			for _, t := range themes.All {
				<li>
					<button
						type="button"
						class="app-theme-item"
						data-class={ "{'is-active': $theme === '" + t.Name + "'}" }
						data-on:click={ "$theme = '" + t.Name + "'; localStorage.setItem('themeMode', $theme); Theme.syncIcons($theme)" }>
						{ t.Label }
					</button>
				</li>
			}
		</ul>
	</details>
}
