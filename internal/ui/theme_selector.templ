// SCOPE:core — Theme selector for the shell's sidebar footer.
//
// A static section, not a disclosure: the palette list is short and the
// choice stays visible. Selecting a theme goes through the $theme SIGNAL
// (Datastar owns data-theme and the dark class through bindings),
// exactly like the header toggle does.
//
// The names come from internal/themes, which themes_test.go keeps in step
// with the `themes:` list compiled by src/css/input.css.
package ui

import "github.com/calionauta/gogogo/internal/themes"

// ThemeSelector renders the palette picker in the sidebar footer.
templ ThemeSelector() {
	<div class="app-theme-section">
		<p class="app-rail-section-label">Theme</p>
		<div class="app-theme-buttons">
			for _, t := range themes.All {
				<button
					type="button"
					class="btn btn-ghost btn-xs"
					data-class={ "{'btn-active': $theme === '" + t.Name + "'}" }
					data-on:click={ "$theme = '" + t.Name + "'; localStorage.setItem('themeMode', $theme)" }>
					{ t.Label }
				</button>
			}
		</div>
	</div>
}
