// SCOPE:core — The shell every module renders inside.
//
// One sidebar, one module header, one work area, one toast root. Before this
// file each page template owned its own <head>, navbar, banner stack and
// re-declared the same assets — eleven copies. Pages now render a body; the
// shell owns everything around it.
//
// Slots, not imports: `head` carries page-specific <head> extras (the sound
// assets, for the modules that opt in), `sound` the sidebar's sound toggle, and
// `actions` the header's right-aligned controls. Keeping them as components
// means internal/ui imports no feature package, so trimming a feature still
// trims cleanly (capability registry rule).
package ui

import (
	"github.com/calionauta/gogogo/features/authviews"
	"github.com/calionauta/gogogo/internal/components"
	"github.com/calionauta/gogogo/internal/icon"
	"github.com/calionauta/gogogo/internal/rbac"
)

// Data is what the shell needs to render around a page body.
type Data struct {
	Title       string             // document title
	Module      string             // active module id, e.g. "todo"
	Heading     string             // header title override (default: module title)
	CrumbLabel  string             // detail-page parent label, e.g. "Boards" ("" = no crumb)
	CrumbURL    string             // detail-page parent target, e.g. "/whiteboard"
	Context     string             // header context slot: liveness, store, transport
	Email       string             // session email ("" for guests)
	Role        string             // session role ("admin" | "user" | "viewer" | "")
	BuildLabel  string             // running build, shown in the sidebar footer
	BuildCommit string             // commit, exposed via title= on the badge
	Signals     string             // the page's own seeded signal JSON ("" = none)
	StreamPage  bool               // marks a page that opens its own EventSource (session.js)
	FullBleed   bool               // body without padding, for canvas pages
	FlushBottom bool              // tight bottom padding, for footer-docked composers
	Demo        bool               // demo mode: dock the state panel
	// Panel is the module's machinery, shown only in demo mode. A page passes it
	// only when it has a pipeline that runs beside the page (a queue, a model
	// call, phases). /config, /room, /notes and /whiteboard pass nil on purpose:
	// their demo IS the page, so hiding it behind a toggle would hide the point —
	// and a page with no panel gets no [ Demo ] button.
	Panel       templ.Component
	OfflineSync bool               // offline outbox wired
	Stack       []components.TechItem // layers this page demonstrates (0 = no key)
}

// HeadingText resolves the module header title: the explicit override wins,
// otherwise the registry's title, otherwise the document title.
func (d Data) HeadingText() string {
	if d.Heading != "" {
		return d.Heading
	}
	if m, ok := ByID(d.Module); ok {
		return m.Title
	}
	return d.Title
}

// Shell renders one module page: head, sidebar, header, body.
//
// head/sound/actions may be nil — templ skips a nil component, which is how a
// module without sounds (room) renders the same shell without the sounds
// dependency (its capability unit deliberately carries none).
templ Shell(d Data, head templ.Component, sound templ.Component, actions templ.Component, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en" { authviews.ThemeRootAttrs(ctx, d.Signals)... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"/>
			<title>{ d.Title }</title>
			@components.Assets()
			@authviews.ThemeHead()
			if head != nil {
				@head
			}
			@components.OfflineSyncScript(d.OfflineSync)
		</head>
		// data-on:datastar-fetch__document recovers an expired session: a 401
		// from any action lands on the login page (returning here) instead of
		// dying silently. The page itself never reaches this: a navigation is
		// bounced server-side by the auth guard.
		<body
			class="bg-base-200 min-h-screen"
			data-module={ d.Module }
			data-on:datastar-fetch__document="evt.detail.type === 'error' ? (evt.detail.argsRaw && evt.detail.argsRaw.status === '401' ? window.location.assign('/login?next=' + encodeURIComponent(location.pathname + location.search)) : $loading = false) : null"
			if d.StreamPage {
				data-stream-page="1"
			}>
			<div class="app-shell" data-signals={ shellSignals(InboxUnread(ctx)) }
				data-on:datastar-signal-patch__document="window.__gogogoUnreadChanged && window.__gogogoUnreadChanged($inboxUnread)"
				data-on:keydown__window="if (evt.key === 'Escape') { $railOpen = false; window.__gogogoDrawerReturn(); }">
			<div data-effect="window.__gogogoDrawerFocus($railOpen)" hidden aria-hidden="true"></div>
				<aside id="app-rail" class="app-rail" aria-label="Modules" data-class="{'is-open': $railOpen}">
					<div class="app-rail-brand">
						<a href="/">gogogo</a>
						if d.BuildLabel != "" {
							<span class="app-nav-badge" title={ d.BuildCommit + " · built " + d.BuildLabel }>{ d.BuildLabel }</span>
						}
						<span class="app-rail-brand-spacer"></span>
						@authviews.ThemeToggle()
						if sound != nil {
							@sound
						}
					</div>
					<nav class="app-rail-nav">
						for _, group := range Grouped(d.Role) {
							if group.Label != "" {
								<p class="app-rail-group">{ group.Label }</p>
							}
							for _, m := range group.Modules {
								@railItem(m, m.ID == d.Module, InboxUnread(ctx))
							}
						}
					</nav>
					<div class="app-rail-foot">
						@authviews.UserMenu(d.Email, d.Role, Preferences(), Operator(ctx), Perf(ctx))
					</div>
				</aside>
				<script nonce={ templ.GetNonce(ctx) }>
					// Drawer focus trap: Datastar owns $railOpen and every dismissal
					// path (Escape, backdrop, destination tap); no Datastar primitive
					// cycles Tab inside an open drawer or moves focus across the
					// boundary, so this island owns focus only. Pinned in vanillaAllow
					// (the keydown listener below). The ≤1024px matchMedia mirrors
					// the drawer breakpoint in chrome.css — on desktop the rail is a
					// persistent sidebar and the trap stays out of the way.
					// Plain script on purpose (see realtime.templ): data-effect
					// evaluates at Datastar init, after deferred modules load, so the
					// globals must exist on window before then.
					window.__gogogoDrawerFocus = function (open) {
						if (!open) return;
						var rail = document.getElementById("app-rail");
						if (!rail || !window.matchMedia("(max-width: 1024px)").matches) return;
						var toggle = document.querySelector(".app-rail-toggle");
						rail.__gogogoOpener = (document.activeElement && document.activeElement !== document.body) ? document.activeElement : toggle;
						var first = rail.querySelector("a[href], button:not([disabled]), summary");
						if (!first) return;
						// The effect can run a frame before Datastar's own morph
						// lands .is-open (which flips visibility), and focus()
						// on a visibility:hidden element is a silent no-op — so
						// retry until focus sticks. requestAnimationFrame is not
						// a guarded marker (vanillaAllow covers listeners only).
						var tries = 0;
						(function tryFocus() {
							first.focus();
							if (document.activeElement !== first && tries++ < 5) {
								window.requestAnimationFrame(tryFocus);
							}
						})();
					};
					window.__gogogoDrawerReturn = function () {
						var rail = document.getElementById("app-rail");
						var opener = rail && rail.__gogogoOpener;
						if (opener && opener.isConnected) opener.focus();
						if (rail) rail.__gogogoOpener = null;
					};
					var __gogogoRail = document.getElementById("app-rail");
					if (__gogogoRail) __gogogoRail.addEventListener("keydown", function (e) {
						if (e.key !== "Tab") return;
						var rail = e.currentTarget;
						if (!rail.classList.contains("is-open")) return;
						if (!window.matchMedia("(max-width: 1024px)").matches) return;
						var items = Array.prototype.slice.call(rail.querySelectorAll("a[href], button:not([disabled]), summary"));
						if (!items.length) return;
						var first = items[0], last = items[items.length - 1];
						if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
						else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
					});
				</script>
				<div class="app-rail-backdrop" style="display:none" data-show="$railOpen" data-on:click="$railOpen = false; window.__gogogoDrawerReturn()"></div>
				// The badge route is `user`+ in policy.csv: a viewer's poll is a
				// guaranteed 403 on every focus/visibility/online event, so it is
				// not rendered for them at all.
				if d.Email != "" && !rbac.IsViewer(d.Role) {
					@railInboxRefresh()
				}
				<div class="app-main">
					<header class="app-module-header">
						<button
							type="button"
							class="app-rail-toggle"
							aria-label="Open navigation"
							aria-controls="app-rail"
							data-attr:aria-expanded={ "$railOpen ? 'true' : 'false'" }
							data-on:click="$railOpen = true">
							@icon.Icon("material-symbols:menu", "")
						</button>
						<div class="app-module-titles">
							if d.CrumbLabel != "" && d.CrumbURL != "" {
								<nav class="app-crumb" aria-label="Breadcrumb">
									<a href={ templ.SafeURL(d.CrumbURL) } title={ "Back to " + d.CrumbLabel }>&#8249; { d.CrumbLabel }</a>
								</nav>
							}
							<h1>{ d.HeadingText() }</h1>
							if d.Context != "" {
								<p class="app-module-context">{ d.Context }</p>
							}
						</div>
						<div class="app-module-actions">
							if d.HasState() {
								<button
									type="button"
									class={ templ.Classes("app-demo-toggle", map[string]bool{"is-on": d.Demo && d.HasState()}) }
									data-panel-mode="state"
									data-class="{'is-on': $panelVisible && $panelMode === 'state'}"
									data-attr:aria-pressed="$panelVisible && $panelMode === 'state' ? 'true' : 'false'"
									aria-pressed={ ariaPressed(d.Demo && d.HasState()) }
									title={ stateTitle() }
									data-on:click="$panelVisible = !($panelVisible && $panelMode === 'state'); $panelMode = 'state'; fetch('/_ui/demo?on=' + ($panelVisible ? '1' : '0') + '&next=' + encodeURIComponent(window.location.pathname), {credentials: 'same-origin'})">
									@icon.Icon("material-symbols:tune", "app-demo-icon")
									<span class="app-demo-label">State</span>
								</button>
							}
							if d.HasStack() {
								<button
									type="button"
									class={ templ.Classes("app-demo-toggle", map[string]bool{"is-on": d.Demo && !d.HasState() && d.HasStack()}) }
									data-panel-mode="stack"
									data-class="{'is-on': $panelVisible && $panelMode === 'stack'}"
									data-attr:aria-pressed="$panelVisible && $panelMode === 'stack' ? 'true' : 'false'"
									aria-pressed={ ariaPressed(d.Demo && !d.HasState() && d.HasStack()) }
									title={ stackTitle() }
									data-on:click="$panelVisible = !($panelVisible && $panelMode === 'stack'); $panelMode = 'stack'; fetch('/_ui/demo?on=' + ($panelVisible ? '1' : '0') + '&next=' + encodeURIComponent(window.location.pathname), {credentials: 'same-origin'})">
									@icon.Icon("material-symbols:stack", "app-demo-icon")
									<span class="app-demo-label">Stack</span>
								</button>
							}
							@authviews.CommandPalette(d.Role, d.Email == "")
							if actions != nil {
								@actions
							}
						</div>
					</header>
					@components.OfflineBanner(d.OfflineSync, d.Email)
					@components.OutboxRetireScript(d.OfflineSync)
					@components.SessionBanner(d.Email != "")
					<main class={ templ.Classes("app-body", map[string]bool{"app-body-flush": d.FullBleed, "app-body-flush-bottom": d.FlushBottom}) }>
						@body
					</main>
				</div>
				if d.HasDemo() {
					<aside id="state-panel" class="app-state-panel" aria-label="Demo panel" data-signals={ panelVisibilitySignals(d.Demo, d.HasState(), d.HasStack()) } data-show="$panelVisible">
						<div class="app-state-panel-head-row">
							// The State section has no caption of its own, so the head
							// names it. The Stack section carries its own STACK caption
							// (components.TechStack), so naming it here would print the
							// same word twice, one line apart.
							if d.HasState() {
								<p class="app-state-panel-head" data-show="$panelMode === 'state'">STATE</p>
							}
							<button
								type="button"
								class="btn btn-ghost btn-xs app-state-panel-close"
								aria-label="Close panel"
								title="Close panel"
								data-on:click="$panelVisible = false; fetch('/_ui/demo?on=0&next=' + encodeURIComponent(window.location.pathname), {credentials: 'same-origin'})">✕</button>
						</div>
						if d.Panel != nil {
							<section class="app-panel-section" aria-label="State" data-show="$panelMode === 'state'">
								@d.Panel
							</section>
						}
						if len(d.Stack) > 0 {
							<section class="app-panel-section" aria-label="Stack" data-show="$panelMode === 'stack'">
								@components.TechStack(d.Stack)
							</section>
						}
					</aside>
				}
			</div>
			@components.ToastContainer()
			@AppDock(d.Module, d.Role)
		</body>
	</html>
}

// AppDock is the mobile webapp bottom bar: the three daily destinations
// plus the drawer, one tap instead of two. Desktop never sees it (CSS shows
// it ≤720px only). It stays on every module, including Chat: the composer
// is lifted above the bar there rather than the bar disappearing. Icons
// reuse the registry's own names so the dock and the drawer can never
// disagree about artwork.
//
// Viewers get Notes as the third destination instead of Chat: the viewer
// policy denies /chat, so offering it would render a destination that 403s
// on open (same rule as the drawer via Visible, and the palette).
templ AppDock(module string, role string) {
	<nav class="app-dock dock" aria-label="Primary">
		@dockLink(module, "todo", "/todo", "material-symbols:checklist", "Todo")
		@dockLink(module, "whiteboard", "/whiteboard", "material-symbols:draw", "Board")
		if rbac.IsViewer(role) {
			@dockLink(module, "notes", "/notes", "material-symbols:description", "Notes")
		} else {
			@dockLink(module, "chat", "/chat", "material-symbols:forum", "Chat")
		}
		<button
			type="button"
			aria-label="Open navigation"
			data-on:click="$railOpen = true"
		>
			@icon.Icon("material-symbols:menu", "app-dock-icon")
			<span class="dock-label">Menu</span>
		</button>
	</nav>
}

// dockLink is one bar destination: same active treatment as the drawer
// entries (dock-active + aria-current), one spelling for all three.
templ dockLink(current string, id string, href string, iconName string, label string) {
	<a
		href={ templ.SafeURL(href) }
		class={ templ.Classes(map[string]bool{"dock-active": current == id}) }
		aria-current={ activeCurrent(current == id) }
	>
		@icon.Icon(iconName, "app-dock-icon")
		<span class="dock-label">{ label }</span>
	</a>
}
