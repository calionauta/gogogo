// SCOPE:core — the single app asset block (DaisyUI + runtime JS).
package components

import "github.com/calionauta/gogogo/web/resources"

// Assets is the one stylesheet + runtime script block every page renders:
// Tailwind v4 + DaisyUI v5 build output, project overrides, theme switcher,
// Datastar core. One spelling for all pages (shell, login, landing), so a
// URL change touches one file instead of eleven templates.
//
// Every URL is versioned through resources.StaticURL so the browser and any
// CDN in front of the app can cache the file immutably instead of
// revalidating it on every navigation (see resources.AssetHandler).
templ Assets() {
	<link rel="stylesheet" href={ resources.StaticURL("app.min.css") }/>
	<link rel="stylesheet" href={ resources.StaticURL("app.css") }/>
	// offline-policy.js is the retry vocabulary shared by the three page-side
	// outboxes (todo, notes, whiteboard). It rides the shared block because the
	// feature scripts (notes/whiteboard) are classic scripts that read
	// window.GogogoOffline in document order.
	<script nonce={ templ.GetNonce(ctx) } defer src={ resources.StaticURL("offline-policy.js") }></script>
	// offline-views.js is the bounded per-view fragment cache: the last HTML of
	// a view the user already saw, labelled with its age and replaced by the
	// next server render. It is not a local store — reads stay server-side.
	<script nonce={ templ.GetNonce(ctx) } defer src={ resources.StaticURL("offline-views.js") }></script>
	// offline-outbox.js is the durable outbox every todo write goes through:
	// the intent is stored before the request leaves, and replayed with its
	// idempotency key on the next load / reconnect. Before the feature scripts
	// that use it.
	<script nonce={ templ.GetNonce(ctx) } defer src={ resources.StaticURL("offline-outbox.js") }></script>
	<script nonce={ templ.GetNonce(ctx) } defer type="module" src={ resources.StaticURL("theme.js") }></script>
	<script nonce={ templ.GetNonce(ctx) } defer type="module" src={ resources.StaticURL("datastar.js") }></script>
}
