// SCOPE:core - shared stack-disclosure badge.
package components

// TechBadge renders the stack a page demonstrates in one visual
// language: labeled chips under the page subtitle. Data comes from the
// feature (it knows what it demonstrates); this component owns the
// look, so every page teaches the architecture identically.
// Display-only: no states, no interactivity, nothing to fail.
//
// Keep the "Demonstrates:" lead so the conformance test's literal
// survives the redesign; chips carry the legibility (badge per item,
// two accent cycles, wrap-friendly).
templ TechBadge(items []string) {
	<div class="mt-2 flex flex-wrap items-center gap-1.5" aria-label="Demonstrates">
		<span class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Demonstrates:</span>
		for i, item := range items {
			if i%2 == 0 {
				<span class="badge badge-primary badge-outline badge-sm px-2.5 py-3 text-xs font-medium">{ item }</span>
			} else {
				<span class="badge badge-secondary badge-outline badge-sm px-2.5 py-3 text-xs font-medium">{ item }</span>
			}
		}
	</div>
}
