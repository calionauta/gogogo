// SCOPE:plugin - Session-expiry banner. ONE component for every authenticated
// page. The state arrives on whichever stream the page already has:
//   - notes/whiteboard send collab.SessionEvent frames;
//   - todo/room/chat carry a `sessionAuthed` signal on their feature
//     stream, revalidated on its heartbeat (the banner's data-effect maps it
//     into GogogoSession.set);
//   - the shared leader stream (/api/session/stream, opened by session.js)
//     runs on every page when Web Locks + BroadcastChannel exist, and its
//     frames also carry the rail's unread count.
// One long-lived connection per BROWSER, not per page or tab: browsers cap
// connections per host, and a stream per tab has been measured to starve later
// navigations. Without that coordination the dedicated stream exists only
// where there is nothing else. Pass authed=true when the page rendered for a
// signed-in user; a public page passes false and never warns.
package components

import "strconv"

import "github.com/calionauta/gogogo/web/resources"

// SessionBanner renders the hidden banner plus its controller script. The
// banner starts hidden and is revealed by session.js only when a session
// that was present disappears — see web/resources/static/session.js.
templ SessionBanner(authed bool) {
	<div
		id="session-banner"
		class="hidden alert alert-warning"
		data-component="session-banner"
		data-authed={ strconv.FormatBool(authed) }
		data-effect={ "typeof $sessionAuthed === 'boolean' && window.GogogoSession && window.GogogoSession.set($sessionAuthed)" }
		role="alert"
		aria-live="polite"
	>
		<span>
			Session expired —
			<a class="link" href="/login">sign in again</a>
			to keep your name on edits. Your work stays safe in this tab.
		</span>
	</div>
	<script nonce={ templ.GetNonce(ctx) } defer src={ resources.StaticURL("session.js") }></script>
}
