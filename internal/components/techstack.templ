// SCOPE:plugin - the shared stack key every feature shows in its demo panel.
package components

// TechItem is one stack tag plus its one-line role note: what the
// layer DOES in the feature rendering it (not what the layer is in
// the abstract). Keep Name to 2-3 words and Note to one clause so
// the row stays scannable.
type TechItem struct {
	Name string
	Note string
}

// TechStack is THE standard shape for "what this page demonstrates": a STACK
// caption and one row per layer — name, and what that layer does *here*.
//
// One component, every feature: internal/ui.Shell renders it from Data.Stack,
// so a page cannot invent its own stack presentation and two pages cannot
// drift. The caption reuses the demo panel's head style (STATE / STACK) so the
// key reads as part of the same evidence surface rather than a stray list.
//
// It lives in the "How it works" panel, not in the chrome: the stack is
// evidence about the template, something you ask for, not a permanent column
// competing with navigation (and definitely not a counter on a disclosure —
// "stack 7" said nothing about which seven).
//
// TEMPLATE DEMO-ONLY — this advertises the template's own internals,
// which mean nothing to a product's users. Agents adapting gogogo into
// their own product must delete it; the wrapper carries
// data-demo="stack-key", so the removal is one grep away (see
// docs/scope-taxonomy.md#demo-only-markup).
templ TechStack(items []TechItem) {
	<section class="app-stack-key" data-demo="stack-key" aria-label="Stack this page demonstrates">
		<p class="app-state-panel-head">STACK</p>
		<dl class="app-stack-list">
			for _, it := range items {
				<div class="app-stack-row">
					<dt class="app-stack-name">{ it.Name }</dt>
					<dd class="app-stack-note">{ it.Note }</dd>
				</div>
			}
		</dl>
	</section>
}
