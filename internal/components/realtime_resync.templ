// SCOPE:core - shared list resync (manual + visibility refetch half).
package components

// ListResync renders the hidden @get button every list page refetches
// through, plus the tab-visibility refetch. Record changes themselves
// arrive live over each feature's SSE stream (the hub fans out a record
// event and the stream re-lists); this button is the manual path —
// backgrounded tabs refetch on visibility return, and feature scripts
// (e.g. the todo doc-version watcher) click it programmatically.
// Rendered ONCE per page.
//
// the button id must be unique on the page (each page's id is pinned by its
// feature test). fragmentExpr is the Datastar @get argument as
// client-side JS (e.g. a fragment path) — evaluated by Datastar
// at click time, never by the server.
//
// The script finds its button through the data-list-resync marker (never
// a second copy of the id): Templ never interpolates Go values inside
// <script> bodies, so values cross that boundary only as data attributes.
templ ListResync(buttonID, fragmentExpr string) {
	<button
		id={ buttonID }
		type="button"
		class="hidden"
		data-on:click={ "@get(" + fragmentExpr + ")" }
		data-list-resync="1"
		aria-hidden="true"
	></button>
	<script type="module">
		// Hidden-@get-button pattern (not data-on:load): Datastar v1 does
		// not fire data-on:load on div/body, so a load attribute silently
		// never opens anything. The button's @get is a real Datastar
		// action (with proper context); this script clicks it.
		function el() { return document.querySelector('[data-list-resync]'); }
		function go() {
			var b = el();
			if (b) { b.click(); }
		}
		// Refetch on load (a change from while the page was gone would
		// otherwise never arrive) and on tab-visibility return
		// (backgrounded tabs get their streams throttled/paused by the
		// browser).
		go();
		document.addEventListener('visibilitychange', function () {
			if (!document.hidden) { go(); }
		});
	</script>
}

// PbRealtimeResync is the transitional alias the basecoat skin still
// calls while its template is mid-edit elsewhere: same hidden-@get
// button contract as ListResync (the topic argument is ignored — there
// is no subscription endpoint anymore), so either spelling compiles and
// renders identically. Delete with the last PbRealtimeResync call site;
// new code calls ListResync directly.
templ PbRealtimeResync(buttonID, fragmentExpr, topic string) {
	@ListResync(buttonID, fragmentExpr)
}
