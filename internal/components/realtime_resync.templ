// SCOPE:plugin - shared list resync (manual + visibility refetch half).
package components

// ListResync renders the hidden @get button every list page refetches
// through, plus the tab-visibility refetch. Record changes themselves
// arrive live over each feature's SSE stream (the hub fans out a record
// event and the stream re-lists); this button is the manual path —
// backgrounded tabs refetch on visibility return, and feature scripts
// (e.g. the todo doc-version watcher) click it programmatically.
// Rendered ONCE per page.
//
// the button id must be unique on the page (each page's id is pinned by its
// feature test). fragmentExpr is the Datastar @get argument as
// client-side JS (e.g. a fragment path) — evaluated by Datastar
// at click time, never by the server.
//
// Visibility refetch is a data-on:visibilitychange__document attribute on
// the button itself (not a vanilla listener): the id interpolates into
// attributes, so no script needs it. The load-time go() call stays a
// script (bootstrap, same class as the SSE opener).

// fragmentOpts keeps a re-list request small. The URL already carries
// filter/scope/query, so Datastar's default signal blob is dead weight (it rode
// every request as a `datastar=` param, todos included). Retries stay at the
// default: the fragment is idempotent and a transient failure should recover on
// its own.
const fragmentOpts = "{filterSignals: {exclude: /.*/}}"

templ ListResync(buttonID, fragmentExpr string) {
	// Offline replays converge through this button too: the SW posts
	// sync-end when its queue drains, the banner bridge dispatches
	// gogogo:synced, and this refetch runs. The live SSE event is NOT
	// enough — an offline tab stays visible, so the visibility refetch
	// above never fires, and a replay broadcast that lands while the
	// stream is still re-establishing is missed with nothing after it.
	// Re-listing is idempotent, so the extra fetch on reconnect is safe.
	<button
		id={ buttonID }
		type="button"
		class="hidden"
		data-on:click={ "@get(" + fragmentExpr + ", " + fragmentOpts + ")" }
		data-on:gogogo:synced__window={ "@get(" + fragmentExpr + ", " + fragmentOpts + ")" }
		data-on:visibilitychange__document={ "if(!document.hidden && navigator.onLine){document.getElementById('" + buttonID + "').click()}" }
		data-list-resync="1"
		aria-hidden="true"
	></button>
	<script nonce={ templ.GetNonce(ctx) } type="module">
		// Hidden-@get-button pattern (not data-on:load): Datastar v1 does
		// not fire data-on:load on div/body, so a load attribute silently
		// never opens anything. The button's @get is a real Datastar
		// action (with proper context); this script clicks it.
		function el() { return document.querySelector('[data-list-resync]'); }
		function go() {
			var b = el();
			if (b) { b.click(); }
		}
		// Refetch on load (a change from while the page was gone would
		// otherwise never arrive). Visibility return is the data-on
		// attribute above (backgrounded tabs get their streams
		// throttled/paused by the browser). Offline the request cannot
		// succeed and Datastar logs the failure, so a cold start on the
		// cached page waits for the online event instead.
		if (navigator.onLine) go();
	</script>
}
