#!/usr/bin/env bash
# init-secrets — one-time age keypair + project secrets file generator.
#
# This is the script internal/secrets/secrets.go documents as the canonical
# bootstrap ("The project owner runs bin/init-secrets once to generate an age
# keypair and write a project-scoped env file at ~/.secrets/<project>.env.age").
#
# What it does:
#   1. Generates an age X25519 keypair (via the `age-keygen` binary, or a
#      built-in Go fallback when age-keygen is not installed).
#   2. Stores the identity (secret key) at ~/.secrets/key.txt, mode 600.
#   3. Creates ~/.secrets/<project>.env with a commented template, mode 600.
#   4. Encrypts it to ~/.secrets/<project>.env.age, mode 600 — the file the
#      app actually reads at boot.
#   5. Prints the export line to add to your shell profile.
#
# The plaintext <project>.env is kept next to the encrypted file so you can
# re-encrypt after edits (`bin/init-secrets --reencrypt`). It is mode 600 and
# never committed — .gitignore covers .env.
#
# Usage:
#   bin/init-secrets                 # generate keypair + template (idempotent-ish)
#   bin/init-secrets --reencrypt     # re-encrypt an edited <project>.env
#   bin/init-secrets --force         # overwrite an existing keypair
#   PROJECT=my-app bin/init-secrets  # override the project name
#
# Env:
#   PROJECT      project name (default: APP_NAME, else the repo dir name)
#   SECRETS_DIR  where the files live (default: ~/.secrets)
#
# The project name must match what the app passes to secrets.Load (it derives
# it from APP_NAME or the binary name), otherwise the app looks for a
# different file and silently boots without secrets.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SECRETS_DIR="${SECRETS_DIR:-$HOME/.secrets}"
# Project name resolution, in order: PROJECT env, APP_NAME env, the Makefile's
# APP_NAME (the source of truth for this repo), then the directory name. It must
# match what the app passes to secrets.Load() — the app derives it from APP_NAME
# or its own binary name — otherwise it looks for a different file and silently
# boots with no secrets.
if [ -z "${PROJECT:-}" ]; then
    if [ -n "${APP_NAME:-}" ]; then
        PROJECT="$APP_NAME"
    elif [ -f "$PROJECT_DIR/Makefile" ]; then
        PROJECT="$(grep -m1 '^APP_NAME[[:space:]]*:=' "$PROJECT_DIR/Makefile" | sed 's/.*:=[[:space:]]*//' | tr -d '[:space:]')"
    fi
    PROJECT="${PROJECT:-$(basename "$PROJECT_DIR")}"
fi

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()  { printf '%b\n' "${GREEN}→${NC} $1"; }
warn()  { printf '%b\n' "${YELLOW}⚠${NC} $1"; }
error() { printf '%b\n' "${RED}✗${NC} $1" >&2; }

KEY_FILE="$SECRETS_DIR/key.txt"
PLAIN_FILE="$SECRETS_DIR/${PROJECT}.env"
ENC_FILE="$SECRETS_DIR/${PROJECT}.env.age"

MODE="init"
case "${1:-}" in
    --reencrypt) MODE="reencrypt" ;;
    --force)     MODE="force" ;;
    ""|--init)   MODE="init" ;;
    -h|--help)
        sed -n '2,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
        exit 0 ;;
    *) error "Unknown option: $1 (try --help)"; exit 1 ;;
esac

mkdir -p "$SECRETS_DIR"
chmod 700 "$SECRETS_DIR"

# ── age helpers ──
have_age()      { command -v age      >/dev/null 2>&1; }
have_agegen()   { command -v age-keygen >/dev/null 2>&1; }

# Generate an identity. Prefer the official CLI; fall back to a tiny Go program
# that uses the same filippo.io/age library the app already depends on, so no
# new dependency is introduced and no network access is needed.
generate_keypair() {
    if have_agegen; then
        age-keygen -o "$KEY_FILE" 2>/dev/null
        chmod 600 "$KEY_FILE"
        return 0
    fi
    if command -v go >/dev/null 2>&1; then
        warn "age-keygen not found; generating via a Go fallback (filippo.io/age)..."
        ( cd "$PROJECT_DIR" && go run ./scripts/agehelper keygen "$KEY_FILE" )
        chmod 600 "$KEY_FILE"
        return 0
    fi
    error "Neither age-keygen nor go is available."
    error "Install age:  brew install age   |   apt install age"
    return 1
}

encrypt_file() {
    local recipient="$1"
    if have_age; then
        age -r "$recipient" -o "$ENC_FILE" "$PLAIN_FILE"
        return 0
    fi
    if command -v go >/dev/null 2>&1; then
        ( cd "$PROJECT_DIR" && go run ./scripts/agehelper encrypt "$recipient" "$PLAIN_FILE" "$ENC_FILE" )
        return 0
    fi
    error "Neither age nor go is available to encrypt $PLAIN_FILE."
    return 1
}

# ── re-encrypt path ──
if [ "$MODE" = "reencrypt" ]; then
    [ -f "$KEY_FILE" ]  || { error "No keypair at $KEY_FILE. Run bin/init-secrets first."; exit 1; }
    [ -f "$PLAIN_FILE" ] || { error "No plaintext file at $PLAIN_FILE — nothing to re-encrypt."; exit 1; }
    RECIPIENT="$(grep -oE '^# public key: age1[a-z0-9]+' "$KEY_FILE" | awk '{print $NF}')"
    [ -n "$RECIPIENT" ] || { error "Could not read the public key from $KEY_FILE."; exit 1; }
    info "Re-encrypting $PLAIN_FILE → $ENC_FILE"
    encrypt_file "$RECIPIENT"
    chmod 600 "$ENC_FILE"
    info "Done. The app will pick up the new values on next boot."
    exit 0
fi

# ── init path ──
if [ -f "$KEY_FILE" ] && [ "$MODE" != "force" ]; then
    warn "Keypair already exists at $KEY_FILE (use --force to replace)."
    warn "Replacing it would make existing .env.age files undecryptable."
else
    info "Generating age keypair → $KEY_FILE"
    generate_keypair
fi

RECIPIENT="$(grep -oE '^# public key: age1[a-z0-9]+' "$KEY_FILE" | awk '{print $NF}')"
[ -n "$RECIPIENT" ] || { error "Could not read the public key from $KEY_FILE."; exit 1; }

if [ -f "$PLAIN_FILE" ] && [ "$MODE" != "force" ]; then
    info "Keeping existing $PLAIN_FILE (edit it, then: bin/init-secrets --reencrypt)"
else
    info "Writing template → $PLAIN_FILE"
    cat > "$PLAIN_FILE" <<'TEMPLATE'
# Project secrets. KEY=value per line; # starts a comment; blank lines ignored.
# Values are taken literally beyond leading/trailing whitespace — no quoting.
# Edit this file, then run: bin/init-secrets --reencrypt
#
# The app reads these at boot via secrets.Load() and re-exports them into the
# process environment, so config.Load() sees them through os.Getenv.
#
# Examples (uncomment and fill):
# ADMIN_UNLOCK_TOKEN=
# GOAI_API_KEY=
# CREDITS_STRIPE_SECRET=
# CREDITS_ENCRYPTION_KEY=
TEMPLATE
    chmod 600 "$PLAIN_FILE"
fi

info "Encrypting → $ENC_FILE"
encrypt_file "$RECIPIENT"
chmod 600 "$ENC_FILE"

echo
info "Secrets ready for project '$PROJECT':"
printf '    %s\n' "$ENC_FILE"
echo
info "Add this to your shell profile (~/.bashrc, ~/.zshrc):"
printf '    export AGE_SECRET_KEY=%s\n' "$(grep -oE 'AGE-SECRET-KEY-[A-Z0-9]+' "$KEY_FILE" | head -1)"
echo
warn "AGE_SECRET_KEY is the decryption key — treat it like a password."
warn "Never commit it. For CI, set it as a repository secret."
