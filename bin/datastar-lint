#!/usr/bin/env bash
# datastar-lint wrapper — supplies this project's defaults, forwards the rest.
#
# Two things to know before editing this file:
#
#  1. It must forward "$@". Without it, every argument a caller passes is
#     silently discarded: `bin/datastar-lint -only-errors -r ./features` used to
#     lint the WHOLE repo (including node_modules) with no -only-errors, so the
#     Makefile target, the pre-commit hook and CI all reported 264 warnings
#     where 0 were expected. The filters looked applied and were not.
#
#  2. `-e/--ext` is deprecated in datastar-lint v0.10+ — "analyzers control
#     their own extensions". Pass `--analyzers` instead.
#
# With no arguments the wrapper lints the repo with every analyzer, which is the
# useful default for a bare invocation. With arguments the caller is explicit,
# so only the analyzer defaults are added.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# All three analyzers, always: the Go analyzer validates backend SDK calls
# (sse.PatchElements and friends) which the HTML/Templ analyzer cannot see,
# the templ analyzer catches Go expressions rendering literally inside
# <script> bodies and quoted attributes (a class no other gate sees), and
# cross-reference checks need html+go.
DEFAULT_ANALYZERS="html,go,templ"

run() {
	if command -v datastar-lint &>/dev/null; then
		exec datastar-lint "$@"
	fi
	# Fallback: run from the sibling source checkout.
	local repo="${DSLINT_REPO:-$HOME/Development/datastar-lint}"
	if [ -d "$repo" ]; then
		exec go run "$repo" "$@"
	fi
	echo "❌ datastar-lint not found. Install it with: go install github.com/calionauta/datastar-lint@latest"
	exit 1
}

if [ "$#" -eq 0 ]; then
	run -r --analyzers "$DEFAULT_ANALYZERS" "$ROOT"
fi

# Caller gave arguments: add the analyzer default unless they set one
# themselves, and let their paths/flags through untouched.
has_analyzers=false
for arg in "$@"; do
	case "$arg" in
		-a|--analyzers|-analyzers|-analyzers=*) has_analyzers=true ;;
	esac
done

if [ "$has_analyzers" = true ]; then
	run "$@"
fi
run --analyzers "$DEFAULT_ANALYZERS" "$@"
